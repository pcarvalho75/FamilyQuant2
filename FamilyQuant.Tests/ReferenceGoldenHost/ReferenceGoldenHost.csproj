<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <IsPublishable>false</IsPublishable>
    <ReferenceRoot Condition="'$(ReferenceRoot)' == ''">D:/FamilyQuant-data/reference-1.5.0.6/app</ReferenceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ClusteringSnapshot.cs" Link="ClusteringSnapshot.cs" />
    <Reference Include="$(ReferenceRoot)/*.dll" />
    <Compile Include="../GoldenNumbers.cs" Link="GoldenNumbers.cs" />
    <Compile Include="../TestFileHash.cs" Link="TestFileHash.cs" />
    <Compile Include="../FcfCompatibilitySnapshot.cs" Link="FcfCompatibilitySnapshot.cs" />
    <Compile Include="../WordGroupingSnapshot.cs" Link="WordGroupingSnapshot.cs" />
    <Compile Include="../ChartExportSnapshot.cs" Link="ChartExportSnapshot.cs" />
    <Content Include="$(ReferenceRoot)/**/*" Link="%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
