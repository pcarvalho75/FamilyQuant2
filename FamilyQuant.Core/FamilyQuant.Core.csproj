<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>false</UseWPF>
    <RootNamespace>FamilyQuant</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="OpenMcdf" Version="3.2.0" />
    <PackageReference Include="System.Runtime.Serialization.Formatters" Version="10.0.3" />
    <PackageReference Include="ThermoFisher.CommonCore.BackgroundSubtraction" Version="5.0.0.38" />
    <PackageReference Include="ThermoFisher.CommonCore.Data" Version="5.0.0.38" />
    <PackageReference Include="ThermoFisher.CommonCore.MassPrecisionEstimator" Version="5.0.0.38" />
    <PackageReference Include="ThermoFisher.CommonCore.RawFileReader" Version="5.0.0.38" />
  </ItemGroup>

  <ItemGroup>
    <!-- App resolves the complete vendor runtime graph. Core names its scientific dependencies
         explicitly so unused vendor UI dependencies do not become Core references. -->
    <Reference Include="MAligner">
      <HintPath>..\FamilyQuant\DLLs\MAligner.dll</HintPath>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
    <Reference Include="PatternTools">
      <HintPath>..\FamilyQuant\DLLs\PatternTools.dll</HintPath>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
    <Reference Include="SeproPckg2">
      <HintPath>..\FamilyQuant\DLLs\SeproPckg2.dll</HintPath>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
    <Reference Include="alglibnet2">
      <HintPath>..\FamilyQuant\DLLs\alglibnet2.dll</HintPath>
      <ExternallyResolved>true</ExternallyResolved>
      <Private>true</Private>
    </Reference>
    <Reference Include="CSMSL">
      <HintPath>..\FamilyQuant\DLLs\CSMSL.dll</HintPath>
      <ExternallyResolved>true</ExternallyResolved>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MyResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>MyResources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="MyResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>MyResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
