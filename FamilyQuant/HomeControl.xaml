<UserControl x:Class="FamilyQuant.HomeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CanvasBrush}" FontFamily="{DynamicResource UiFont}"
             FontSize="{DynamicResource BodySize}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="1160" HorizontalAlignment="Stretch">
            <DockPanel Margin="0,0,0,20">
                <Image Source="{DynamicResource StartPageLogo}" Width="52" Height="52" Margin="0,0,16,0" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <StackPanel>
                    <TextBlock Text="FamilyQuant" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               ToolTip="Groups a protein database into families for curation, measures full isotope envelopes from RAW and reports run recovery. One .fqproj keeps the families, User IDs, annotations and computed quantitation."/>
                    <TextBlock Text="Four steps, one .fqproj: build, curate, measure RAW envelopes, read recovery." Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </DockPanel>
            <WrapPanel Margin="0,0,0,24">
                <Button x:Name="ButtonHomeOpen" Content="Open project" Click="ButtonHomeOpen_Click" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,0"
                        ToolTip="Opens a FamilyQuant project or an older Family Cluster File. Your existing files stay available."/>
                <Button x:Name="ButtonHomeBuild" Content="New from database" Click="ButtonHomeBuild_Click"
                        ToolTip="Builds families once per database by USearch sequence identity from a FASTA or target-decoy (.T-R) file, using File > New from database. Skip this step and open an existing .fcf or .fqproj."/>
            </WrapPanel>
            <Border Background="{DynamicResource SurfaceBrush}" Padding="16" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Current project" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TextBlockHomeProject" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{DynamicResource MutedBrush}"
                               ToolTip="Names the open project and whether full XIC has been computed. The status bar also tracks the current stage and project; Help explains what to do next."/>
                    <WrapPanel x:Name="HomeProjectActions" Margin="0,12,0,0">
                        <Button x:Name="ButtonHomeCurate" Content="Families" Click="ButtonHomeCurate_Click" Margin="0,0,8,0"
                                ToolTip="Returns to the open project or opens a .fqproj or .fcf for merging, renaming, editing User IDs and locking families by hand. Existing edits stay in memory; opening a project enables Quantify and Results."/>
                        <Button x:Name="ButtonHomeCompute" Click="ButtonHomeCompute_Click" Margin="0,0,8,0" IsEnabled="False"
                                ToolTip="Analysis > Compute full XIC measures every identified peptide and kept de novo precursor from RAW full isotope envelopes and stores the result in the open project. Disabled until a project is open; Save afterwards to keep the result.">
                            <TextBlock Text="Quantify" Foreground="{DynamicResource MutedBrush}"/>
                        </Button>
                        <Button x:Name="ButtonHomeAnalytics" Click="ButtonHomeAnalytics_Click" Margin="0,0,8,0" IsEnabled="False"
                                ToolTip="Draws recovery figures with CSV and PNG export from stored full XIC; reads no RAW and recomputes nothing. Disabled until a project is open and changes no family.">
                            <TextBlock Text="Results" Foreground="{DynamicResource MutedBrush}"/>
                        </Button>
                        <Button x:Name="ButtonHomeDeNovo" Content="De novo evidence" Click="ButtonHomeDeNovo_Click"
                                ToolTip="Optional inspection only: filter PEAKS or DeepNovo calls and compare them with PatternLab in a review queue. Quantify reads de novo folders itself, so this review is not needed for quantitation and changes no family or numbers."/>
                    </WrapPanel>
                    <TextBlock x:Name="TextBlockProjectReason" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource CaptionSize}"/>
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" Padding="16" MinWidth="290">
                    <StackPanel>
                        <TextBlock Text="Recent projects" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TextBlockNoRecents" Text="No recent projects yet." Foreground="{DynamicResource MutedBrush}"/>
                        <ItemsControl x:Name="RecentProjectsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="RecentProject_Click" IsEnabled="{Binding Exists}" ToolTip="{Binding ToolTip}" HorizontalContentAlignment="Stretch" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Availability}" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" FontSize="{DynamicResource CaptionSize}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" Padding="16" MinWidth="190">
                    <StackPanel>
                        <TextBlock Text="Last result" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TextBlockLastResult" Text="No saved result yet." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,12"/>
                        <Button x:Name="ButtonHomeLastResult" Click="ButtonHomeLastResult_Click" IsEnabled="False" HorizontalAlignment="Left"
                                ToolTip="Opens the latest known saved result, or the stored results in this session. Disabled until a result is available.">
                            <TextBlock Text="Open last result" Foreground="{DynamicResource MutedBrush}"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
