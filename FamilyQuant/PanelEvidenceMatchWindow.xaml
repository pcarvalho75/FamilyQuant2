<Window x:Class="FamilyQuant.PanelEvidenceMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FamilyQuant"
        Title="Match panel family to stored evidence" Width="1180" Height="680" MinWidth="940" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Row="1" Text="{Binding NamesText}" ToolTip="{Binding NamesText}" TextTrimming="CharacterEllipsis" Margin="0,6,0,6" Foreground="{DynamicResource MutedBrush}"/>
        <TextBlock Grid.Row="2" Text="Review the labels and per-label coverage, then tick those to use." Margin="0,0,0,10"/>
        <DataGrid x:Name="MatchLabelsGrid" Grid.Row="3" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Use" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45">
                    <DataGridCheckBoxColumn.CellStyle><Style TargetType="DataGridCell"><Setter Property="ToolTip" Value="Select this label for your confirmed candidate matches."/></Style></DataGridCheckBoxColumn.CellStyle>
                </DataGridCheckBoxColumn>
                <DataGridComboBoxColumn Header="Type" ItemsSource="{x:Static local:PanelEvidenceMatchViewModel.KindOptions}" DisplayMemberPath="Name" SelectedValuePath="Kind"
                                        SelectedValueBinding="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140">
                    <DataGridComboBoxColumn.CellStyle><Style TargetType="DataGridCell"><Setter Property="ToolTip" Value="Choose which stored evidence field this value should match."/></Style></DataGridComboBoxColumn.CellStyle>
                </DataGridComboBoxColumn>
                <DataGridTextColumn Header="Evidence label" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200">
                    <DataGridTextColumn.CellStyle><Style TargetType="DataGridCell"><Setter Property="ToolTip" Value="{Binding Value}"/></Style></DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Pfam name" Binding="{Binding Name}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="Targets" Binding="{Binding Targets, StringFormat=N0}" IsReadOnly="True" Width="75"/>
                <DataGridTextColumn Header="Reviewed" Binding="{Binding Reviewed, StringFormat=N0}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Stored refs" Binding="{Binding References, StringFormat=N0}" IsReadOnly="True" Width="85"/>
                <DataGridTextColumn Header="Why suggested" Binding="{Binding Reason}" IsReadOnly="True" Width="*" MinWidth="180">
                    <DataGridTextColumn.CellStyle><Style TargetType="DataGridCell"><Setter Property="ToolTip" Value="{Binding Reason}"/></Style></DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="MatchSelectionSummary" Grid.Row="4" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,10,0,10"/>
        <DockPanel Grid.Row="5" LastChildFill="False">
            <Button x:Name="AddMatchLabelButton" Content="Add label" Click="AddLabel_Click" DockPanel.Dock="Left"
                    ToolTip="Add an exact evidence label of your own; its stored coverage starts at zero when no label matches."/>
            <Button x:Name="ConfirmMatchLabelsButton" Content="Confirm matches" Click="Confirm_Click" IsEnabled="{Binding CanConfirm}" IsDefault="True" DockPanel.Dock="Right"
                    ToolTip="Return only the labels you selected or edited to the panel review." Margin="8,0,0,0" Style="{DynamicResource PrimaryButton}"/>
            <Button Content="Cancel" IsCancel="True" DockPanel.Dock="Right" ToolTip="Close without changing this panel's confirmed labels."/>
        </DockPanel>
    </Grid>
</Window>
