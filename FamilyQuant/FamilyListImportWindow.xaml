<Window x:Class="FamilyQuant.FamilyListImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FamilyQuant"
        Title="Import family list" Width="1220" Height="780" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <local:ImportHeaderLabelConverter x:Key="HeaderLabel"/>
        <Style x:Key="WizardPage" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/></Style>
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers><DataTrigger Binding="{Binding Current}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Opacity" Value="0.5"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SourceText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="4,2"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </Window.Resources>
    <Border Padding="24" Background="{DynamicResource CanvasBrush}"><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                <TextBlock Text="FamilyQuant" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Import family list" Style="{StaticResource CaptionText}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Steps}" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Button Content="{Binding}" Tag="{Binding Index}" Click="Step_Click" Style="{StaticResource StepButton}" IsEnabled="{Binding Enabled}"
                            AutomationProperties.Name="{Binding Label}">
                        <Button.ContentTemplate><DataTemplate><StackPanel>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource BodyText}"/>
                            <TextBlock Text="Done" Margin="18,2,0,0" Style="{StaticResource CaptionText}" Visibility="{Binding Done, Converter={StaticResource BoolVisibility}}"/>
                        </StackPanel></DataTemplate></Button.ContentTemplate>
                    </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="{Binding StepLabel}" Style="{StaticResource CaptionText}"/>
                <TextBlock x:Name="PageHeading" Text="{Binding Title}" Style="{StaticResource PageTitle}" Focusable="True"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding StepLabel}"/>
                <TextBlock Text="{Binding Explanation}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Explanation}"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid IsEnabled="{Binding CanEdit}">
                    <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardPage}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Padding="{DynamicResource PanelPadding}" Margin="{DynamicResource PanelMargin}">
                            <StackPanel><TextBlock Text="You need" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Excel workbook (.xlsx)" Style="{StaticResource BodyText}" Margin="0,8,0,4"/>
                                <TextBlock Text="Abbreviation column" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                                <TextBlock Text="Family name column" Style="{StaticResource BodyText}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Padding="{DynamicResource PanelPadding}" Margin="{DynamicResource PanelMargin}">
                            <StackPanel><TextBlock Text="Kept with your list" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Other-language names" Style="{StaticResource BodyText}" Margin="0,8,0,4"/>
                                <TextBlock Text="Notes and original rows" Style="{StaticResource BodyText}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Padding="{DynamicResource PanelPadding}" Margin="{DynamicResource PanelMargin}">
                            <StackPanel><TextBlock Text="Imported into" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="This project's family panel" Style="{StaticResource BodyText}" Margin="0,8,0,4"/>
                                <TextBlock Text="Next, after import: Review protein choices in Family checklist" Style="{StaticResource BodyText}"/>
                            </StackPanel>
                        </Border>
                        <WrapPanel><Button x:Name="ExampleButton" Content="Try with the example" Click="Example_Click"/>
                            <Button x:Name="TemplateButton" Content="Save a template" Click="Template_Click"/>
                            <Button Content="Edit current panel" Click="Editor_Click"/></WrapPanel>
                    </StackPanel></ScrollViewer>
                </Grid>
                <Grid IsEnabled="{Binding CanEdit}">
                    <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardPage}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Workbook" Style="{StaticResource SectionTitle}"/>
                        <DockPanel Margin="0,4,0,10"><Button x:Name="BrowseButton" Content="Browse" DockPanel.Dock="Right" Click="Browse_Click"/>
                            <TextBox x:Name="WorkbookPathBox" Text="{Binding WorkbookPath, Mode=OneWay}" IsReadOnly="True" MinHeight="34"
                                     ToolTip="{Binding WorkbookPath}" AutomationProperties.Name="Workbook"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Sheet" Style="{StaticResource SectionTitle}"/>
                                <ComboBox x:Name="SheetChoice" ItemsSource="{Binding Sheets}" SelectedItem="{Binding Sheet, Mode=OneWay}"
                                          SelectionChanged="Sheet_SelectionChanged" MinHeight="34" Margin="0,4,0,0" AutomationProperties.Name="Sheet"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Header row" Style="{StaticResource SectionTitle}"/>
                                <TextBox x:Name="HeaderRowBox" Text="{Binding HeaderRowText, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" Margin="0,4,0,0"
                                         ToolTip="{Binding Preview.HeaderReason}" AutomationProperties.Name="Header row"/>
                                <Button Content="Read this header row" Click="Header_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Other sheets" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Content="Keep as source notes" IsChecked="{Binding KeepOtherSheets}" Margin="4,10,0,0"
                                          ToolTip="Unchecked: ignore the other sheets. Checked: keep their original cell text with sheet and cell references; no rules or measurements are inferred."/>
                            </StackPanel>
                        </Grid>
                        <DockPanel><TextBlock Text="Spreadsheet preview" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Source colours" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"
                                       ToolTip="These are workbook cell fills, not status colours; yellow and gold fills are shown neutrally and named in the cell details."/>
                        </DockPanel>
                    </StackPanel>
                    <DataGrid x:Name="SheetPreviewGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionUnit="Cell" SelectedCellsChanged="Preview_SelectedCellsChanged" HeadersVisibility="Column" FrozenColumnCount="1" Margin="0,6,0,0" RowHeight="30"
                              AutomationProperties.Name="Spreadsheet preview with source row numbers"/>
                    <Expander x:Name="CellDetails" Grid.Row="2" Header="Cell details" Margin="0,8,0,0">
                        <TextBox x:Name="CellDetailText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="110" MinHeight="50" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Complete source cell text, fill and merged range"/>
                    </Expander>
                </Grid>
                <Grid IsEnabled="{Binding CanEdit}">
                    <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardPage}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding ReviewingDecisions}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding MainColumns}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource SectionTitle}"/>
                                    <ComboBox ItemsSource="{Binding Headers}" SelectedItem="{Binding Header, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" Margin="0,4,0,6" AutomationProperties.Name="{Binding Label}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource HeaderLabel}}" ToolTip="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding Example, StringFormat=Example: {0}}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxHeight="66" ToolTip="{Binding Example}"/>
                                </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Visibility="{Binding HasDecisions, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12">
                                <TextBlock Text="{Binding DecisionSummary}" Style="{StaticResource CaptionText}"/>
                                <Button Content="Review decision values" Click="ReviewDecisions_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <Expander x:Name="ColourCategories" Header="Colour categories (optional)" IsExpanded="{Binding HasSourceFills, Mode=OneWay}">
                                <StackPanel>
                                    <ComboBox DataContext="{Binding ColorColumn}" ItemsSource="{Binding Headers}" SelectedItem="{Binding Header, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" AutomationProperties.Name="Colour category column">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource HeaderLabel}}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <DataGrid ItemsSource="{Binding SourceColorChoices}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="180" Margin="0,8,0,0" AutomationProperties.Name="Source colour category names">
                                        <DataGrid.Columns><DataGridTextColumn Header="Source colour" Binding="{Binding ColorName}" Width="*" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Source rows" Binding="{Binding Rows}" Width="*" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Category name" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="2*"/></DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Visibility="{Binding ReviewingDecisions, Converter={StaticResource BoolVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding DecisionSummary}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="DecisionGrid" Grid.Row="1" ItemsSource="{Binding Decisions}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Decision values and proposed actions">
                            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Reason}"/></Style></DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Source value" Width="2*" MinWidth="160" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Source}" Style="{StaticResource SourceText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Source rows" Binding="{Binding Rows}" Width="*" MinWidth="110" IsReadOnly="True"/>
                                <DataGridComboBoxColumn x:Name="DecisionActionColumn" Header="Use as (proposed)" SelectedValueBinding="{Binding Decision, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="180"/>
                                <DataGridTextColumn Header="Merge into abbreviation" Binding="{Binding MergeTarget, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                                <DataGridCheckBoxColumn Header="Confirmed" Binding="{Binding Confirmed}" IsReadOnly="True" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Grid.Row="2"><Button Content="Back to columns" Click="BackToColumns_Click"/><Button Content="Confirm these actions" Click="ConfirmDecisions_Click"/></WrapPanel>
                    </Grid>
                </Grid>
                <Grid IsEnabled="{Binding CanEdit}">
                    <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardPage}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding SpecialSummary}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <DataGrid x:Name="SpecialRowsGrid" Grid.Row="1" ItemsSource="{Binding SpecialRows}" SelectedItem="{Binding SelectedSpecialRow}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Special source rows">
                            <DataGrid.Columns><DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="65"/>
                                <DataGridTextColumn Header="Abbreviation" Binding="{Binding Abbreviation}" Width="110"/>
                                <DataGridTemplateColumn Header="What needs review" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Message}" Style="{StaticResource SourceText}" MaxHeight="70"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/></DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="{Binding SelectedSpecialRow.Message}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                        <Expander Header="Original source row" Margin="0,8"><TextBox Text="{Binding SelectedSpecialRow.Original, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Complete original source row"/></Expander>
                        <TextBlock Text="Use this row as" Style="{StaticResource CaptionText}"/>
                        <ComboBox x:Name="RowActionChoice" ItemsSource="{Binding AvailableRowOptions}" SelectedValue="{Binding SelectedSpecialRow.Action, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="Label" MinHeight="34" AutomationProperties.Name="Special row action"/>
                        <TextBlock Text="Abbreviation" Style="{StaticResource CaptionText}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding SelectedSpecialRow.Key, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" AutomationProperties.Name="Abbreviation for this source row"/>
                        <TextBlock Text="Family name" Style="{StaticResource CaptionText}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding SelectedSpecialRow.Name, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" AutomationProperties.Name="Family name for this source row"/>
                        <StackPanel Visibility="{Binding SelectedSpecialRow.Merging, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Merge into abbreviation" Style="{StaticResource CaptionText}" Margin="0,10,0,4"/>
                            <TextBox Text="{Binding SelectedSpecialRow.MergeTarget, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" AutomationProperties.Name="Merge target abbreviation"/></StackPanel>
                        <DataGrid ItemsSource="{Binding SelectedSpecialRow.Parts}" Visibility="{Binding SelectedSpecialRow.Splitting, Converter={StaticResource BoolVisibility}}"
                                  AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" MaxHeight="190" MinHeight="100" Margin="0,12,0,0" AutomationProperties.Name="One abbreviation and name for each split family">
                            <DataGrid.Columns><DataGridTextColumn Header="Abbreviation" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Family name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*"/></DataGrid.Columns>
                        </DataGrid>
                        <Button x:Name="UseRowButton" Content="Use this choice" Click="UseRow_Click" IsEnabled="{Binding CanUseRowChoice}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel></ScrollViewer>
                </Grid>
                <Grid IsEnabled="{Binding CanEdit}">
                    <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardPage}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="4"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <DataGrid x:Name="MatchFamiliesGrid" ItemsSource="{Binding MatchFamilies}" SelectedItem="{Binding SelectedMatchFamily}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Imported families and evidence matching choices">
                        <DataGrid.Columns><DataGridTextColumn Header="Abbreviation" Binding="{Binding Key}" Width="110"/>
                            <DataGridTemplateColumn Header="Family name" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource SourceText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Choice" Binding="{Binding Choice}" Width="120"/></DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding SelectedMatchFamily.Name}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="NoFamilyLevelMatchText" Text="No family-level match" Style="{StaticResource CaptionText}"
                                       Visibility="{Binding SelectedMatchFamily.HasNoFamilyLevelMatch, Converter={StaticResource BoolVisibility}}"/>
                            <TextBlock Text="{Binding MatchStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding MatchingSourceStatus}" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                        <Grid Grid.Row="1" xmlns:theme="clr-namespace:FamilyQuant.Themes">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid x:Name="MatchSuggestionsGrid" ItemsSource="{Binding SelectedMatchFamily.PrimarySuggestions}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="100" AutomationProperties.Name="Suggested stored-evidence matches">
                                <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Details}"/></Style></DataGrid.RowStyle>
                                <DataGrid.Columns><DataGridCheckBoxColumn Header="Use" Binding="{Binding Use, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                    <DataGridTemplateColumn Header="Stored evidence" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Text}" Style="{StaticResource SourceText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ToolTip="Edit this stored-evidence value, then confirm the selected matches again."/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Proteins" Binding="{Binding Proteins}" Width="85" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Reviewed" Binding="{Binding Reviewed}" Width="85" IsReadOnly="True"/></DataGrid.Columns>
                            </DataGrid>
                            <Expander x:Name="AdditionalMatchesExpander" Grid.Row="1" Header="Show more" Margin="0,8,0,0"
                                      IsExpanded="{Binding SelectedMatchFamily.ShowAdditional, Mode=TwoWay}"
                                      Visibility="{Binding SelectedMatchFamily.HasAdditionalSuggestions, Converter={StaticResource BoolVisibility}}"
                                      ToolTip="Shows extra stored-evidence suggestions for this family, including shared keywords and tissue text. Opening the list changes only this page.">
                                <DataGrid x:Name="AdditionalMatchSuggestionsGrid" ItemsSource="{Binding SelectedMatchFamily.AdditionalSuggestions}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="190" MinHeight="100"
                                          AutomationProperties.Name="Additional stored-evidence matches" Margin="0,6,0,0"
                                          ToolTip="Lists extra stored-evidence labels whose names may provide less specific support for this family. A tick is only a draft choice until you confirm the matches and import the family list.">
                                    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Details}"/></Style></DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Use" Width="55" theme:TableAppearance.HeaderToolTip="Choose extra labels to confirm for this family. New suggestions start unticked and reach the project only when the family list is imported.">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <CheckBox IsChecked="{Binding Use, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                          ToolTip="Chooses this extra stored-evidence label for confirmation. It reaches the project only when you confirm the matches and import the family list."/>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Stored evidence" Width="*" theme:TableAppearance.HeaderToolTip="The exact stored label to use for this family if you confirm it. Editing a draft value refreshes its entry counts before import.">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Text}" Style="{StaticResource SourceText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate><DataTemplate>
                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Stored-evidence label text, initially the suggested value, allowing one nonempty line. Editing updates its entry counts and requires confirming the matches again before import."/>
                                            </DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="The stored evidence kind, such as UniProt family, Pfam domain, keyword or tissue phrase. Reading it changes nothing."/>
                                        <DataGridTextColumn Header="Proteins" Binding="{Binding Proteins}" Width="85" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="Distinct database target entries covered by this exact label. Overlapping suggestions are not added together."/>
                                        <DataGridTextColumn Header="Reviewed" Binding="{Binding Reviewed}" Width="85" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="Database target entries covered by this label that are marked reviewed in stored evidence. Reading the count changes nothing."/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Expander>
                        </Grid>
                        <WrapPanel Grid.Row="2"><Button Content="Use selected matches" Click="ConfirmMatches_Click" IsEnabled="{Binding CanConfirmMatches}"/>
                            <Button Content="{Binding SkipFamilyLabel}" Click="SkipMatch_Click"/><Button Content="{Binding SkipAllLabel}" Click="SkipAllMatches_Click"/></WrapPanel>
                    </Grid>
                </Grid>
                <Grid>
                    <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardPage}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="5"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="Panel name" Style="{StaticResource SectionTitle}"/>
                        <TextBox Text="{Binding PanelName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Imported}" MinHeight="34" Margin="0,4,0,8" AutomationProperties.Name="Panel name"/>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Sheet, StringFormat=Source sheet: {0}}" Style="{StaticResource CaptionText}" Margin="0,6,0,2"/>
                        <TextBlock Text="{Binding PreviousPanel, StringFormat=Current panel to replace: {0}}" Style="{StaticResource CaptionText}"/>
                        <TextBlock Text="{Binding MatchingChangeNotice}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <DataGrid x:Name="SummaryGrid" Grid.Row="1" ItemsSource="{Binding SummaryFamilies}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Families that will be imported">
                        <DataGrid.Columns><DataGridTextColumn Header="Abbreviation" Binding="{Binding Key}" Width="110"/>
                            <DataGridTemplateColumn Header="Family name" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource SourceText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Other-language name" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding OtherName}" Style="{StaticResource SourceText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="145"/>
                            <DataGridTextColumn Header="Colour" Binding="{Binding Color}" Width="130"/>
                            <DataGridTextColumn Header="Matches" Binding="{Binding Matches}" Width="120"/>
                            <DataGridTemplateColumn Header="Notes" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Button Content="View source notes" Click="SourceNotes_Click" Padding="6,2" Margin="2" ToolTip="Show every original source field for this family."/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <Grid>
                    <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardPage}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="6"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <StackPanel><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Padding="{DynamicResource PanelPadding}">
                        <StackPanel><TextBlock Text="{Binding ImportedPanel.Families.Count, StringFormat={}{0:N0} families imported}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding PanelName, StringFormat=Panel: {0}}" Style="{StaticResource BodyText}" Margin="0,10,0,4"/>
                            <TextBlock Text="Workbook unchanged" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                            <TextBlock Text="Protein grouping unchanged" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                            <TextBlock Text="Project not saved yet" Style="{StaticResource BodyText}"/>
                        </StackPanel>
                    </Border><Button x:Name="UndoImportButton" Content="Undo import" Click="Undo_Click" IsEnabled="{Binding CanUndo}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                     ToolTip="Restores the previous family panel when this import is the current Undo step."/></StackPanel>
                </Grid>
            </Grid>
            <Grid x:Name="WizardFooter" Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite"/>
                    <Button Content="Help" Click="Help_Click" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CloseButton" Content="{Binding CloseLabel}" Click="Close_Click" MinWidth="86"/>
                    <Button x:Name="BackButton" Content="Back" Click="Back_Click" IsEnabled="{Binding CanBack}" MinWidth="86"/>
                    <Button x:Name="ForwardButton" Content="{Binding ForwardLabel}" Click="Forward_Click" IsEnabled="{Binding CanNext}" ToolTip="{Binding DisabledReason}"
                            Style="{DynamicResource PrimaryButton}" MinWidth="86" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid></Border>
</Window>
