<Window x:Class="FamilyQuant.FamilyListImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FamilyQuant"
        xmlns:theme="clr-namespace:FamilyQuant.Themes"
        Title="Import family list" Width="1220" Height="780" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <local:ImportHeaderLabelConverter x:Key="HeaderLabel"/>
        <local:ImportCellToolTipConverter x:Key="CellToolTip"/>
        <Style x:Key="WizardCellText" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
            <Setter Property="ToolTip"><Setter.Value><MultiBinding Converter="{StaticResource CellToolTip}">
                <Binding Path="Column.(theme:TableAppearance.HeaderToolTip)" RelativeSource="{RelativeSource AncestorType=DataGridCell}"/>
                <Binding Path="Text" RelativeSource="{RelativeSource Self}"/>
                <Binding Path="ToolTip" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
            </MultiBinding></Setter.Value></Setter>
        </Style>
        <Style x:Key="DecisionMeaningText" TargetType="TextBlock" BasedOn="{StaticResource WizardCellText}">
            <Setter Property="ToolTip"><Setter.Value><MultiBinding Converter="{StaticResource CellToolTip}">
                <Binding Path="Column.(theme:TableAppearance.HeaderToolTip)" RelativeSource="{RelativeSource AncestorType=DataGridCell}"/>
                <Binding Path="Meaning"/>
                <Binding Path="ToolTip" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
            </MultiBinding></Setter.Value></Setter>
        </Style>
        <Style x:Key="WizardCellEditor" TargetType="TextBox" BasedOn="{x:Static DataGridTextColumn.DefaultEditingElementStyle}">
            <Setter Property="ToolTip"><Setter.Value><MultiBinding Converter="{StaticResource CellToolTip}">
                <Binding Path="Column.(theme:TableAppearance.HeaderToolTip)" RelativeSource="{RelativeSource AncestorType=DataGridCell}"/>
                <Binding Path="Text" RelativeSource="{RelativeSource Self}"/>
                <Binding Path="ToolTip" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
            </MultiBinding></Setter.Value></Setter>
        </Style>
        <Style x:Key="WizardCellCheck" TargetType="CheckBox" BasedOn="{x:Static DataGridCheckBoxColumn.DefaultElementStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="ToolTip"><Setter.Value><MultiBinding Converter="{StaticResource CellToolTip}">
                <Binding Path="Column.(theme:TableAppearance.HeaderToolTip)" RelativeSource="{RelativeSource AncestorType=DataGridCell}"/>
                <Binding Path="ToolTip" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
            </MultiBinding></Setter.Value></Setter>
        </Style>
        <Style x:Key="WizardCellCheckEditor" TargetType="CheckBox" BasedOn="{x:Static DataGridCheckBoxColumn.DefaultEditingElementStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="ToolTip"><Setter.Value><MultiBinding Converter="{StaticResource CellToolTip}">
                <Binding Path="Column.(theme:TableAppearance.HeaderToolTip)" RelativeSource="{RelativeSource AncestorType=DataGridCell}"/>
                <Binding Path="ToolTip" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
            </MultiBinding></Setter.Value></Setter>
        </Style>
        <Style x:Key="WizardCellCombo" TargetType="ComboBox" BasedOn="{x:Static DataGridComboBoxColumn.DefaultElementStyle}">
            <Setter Property="ToolTip"><Setter.Value><MultiBinding Converter="{StaticResource CellToolTip}">
                <Binding Path="Column.(theme:TableAppearance.HeaderToolTip)" RelativeSource="{RelativeSource AncestorType=DataGridCell}"/>
                <Binding Path="ToolTip" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
            </MultiBinding></Setter.Value></Setter>
        </Style>
        <Style x:Key="WizardCellComboEditor" TargetType="ComboBox" BasedOn="{x:Static DataGridComboBoxColumn.DefaultEditingElementStyle}">
            <Setter Property="ToolTip"><Setter.Value><MultiBinding Converter="{StaticResource CellToolTip}">
                <Binding Path="Column.(theme:TableAppearance.HeaderToolTip)" RelativeSource="{RelativeSource AncestorType=DataGridCell}"/>
                <Binding Path="ToolTip" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
            </MultiBinding></Setter.Value></Setter>
        </Style>
        <Style x:Key="WorkbookRoleCombo" TargetType="ComboBox" BasedOn="{StaticResource WizardCellCombo}">
            <Setter Property="ToolTip" Value="Choose Family list, Colour legend, Subclass table or Notes for this sheet. Changing its role rebuilds the draft without changing the workbook or project."/>
        </Style>
        <Style x:Key="WorkbookRoleComboEditor" TargetType="ComboBox" BasedOn="{StaticResource WizardCellComboEditor}">
            <Setter Property="ToolTip" Value="Choose Family list, Colour legend, Subclass table or Notes for this sheet. Changing its role rebuilds the draft without changing the workbook or project."/>
        </Style>
        <Style x:Key="WizardPage" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/></Style>
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers><DataTrigger Binding="{Binding Current}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Opacity" Value="0.5"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SourceText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="4,2"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
            <Setter Property="ToolTip"><Setter.Value><MultiBinding Converter="{StaticResource CellToolTip}">
                <Binding Path="Column.(theme:TableAppearance.HeaderToolTip)" RelativeSource="{RelativeSource AncestorType=DataGridCell}"/>
                <Binding Path="Text" RelativeSource="{RelativeSource Self}"/>
                <Binding Path="ToolTip" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
            </MultiBinding></Setter.Value></Setter>
        </Style>
        <Style x:Key="WizardNumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Padding" Value="8,4,12,4"/><Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="WizardNumberText" TargetType="TextBlock" BasedOn="{StaticResource WizardCellText}">
            <Setter Property="Padding" Value="8,4,12,4"/><Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="DecisionMergeCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="IsEnabled" Value="{Binding IsMerge}"/>
        </Style>
    </Window.Resources>
    <Border Padding="24" Background="{DynamicResource CanvasBrush}"><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                <TextBlock Text="FamilyQuant" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Import family list" Style="{StaticResource CaptionText}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding StepLabel}" Margin="12">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ShowingWizardPages}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Steps}" HorizontalContentAlignment="Stretch" Visibility="{Binding ShowingWizardPages, Converter={StaticResource BoolVisibility}}">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Button Content="{Binding}" Tag="{Binding Index}" Click="Step_Click" Style="{StaticResource StepButton}" IsEnabled="{Binding Enabled}"
                            AutomationProperties.Name="{Binding AccessibleName}" ToolTip="{Binding ToolTip}">
                        <Button.ContentTemplate><DataTemplate><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" Style="{StaticResource BodyText}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="Done" Style="{StaticResource CaptionText}" Visibility="{Binding Done, Converter={StaticResource BoolVisibility}}"/>
                            </StackPanel>
                        </Grid></DataTemplate></Button.ContentTemplate>
                    </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="{Binding StepLabel}" Style="{StaticResource CaptionText}"/>
                <TextBlock x:Name="PageHeading" Text="{Binding Title}" Style="{StaticResource PageTitle}" Focusable="True"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding StepLabel}"/>
                <TextBlock Text="{Binding Explanation}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" ToolTip="{Binding Explanation}"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <local:FamilyListWorkbookOverview x:Name="WorkbookOverview" Visibility="{Binding ReviewingWorkbook, Converter={StaticResource BoolVisibility}}"/>
                <local:FamilyListSubclassReview x:Name="WorkbookSubclassReview" ShowIntroduction="False" IsEnabled="{Binding CanEdit}" FamilyKeys="{Binding WorkbookFamilyKeys}" Visibility="{Binding ReviewingSubclasses, Converter={StaticResource BoolVisibility}}"/>
                <Grid Visibility="{Binding ShowingWizardPages, Converter={StaticResource BoolVisibility}}">
                <Grid IsEnabled="{Binding CanEdit}">
                    <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardPage}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Padding="{DynamicResource PanelPadding}" Margin="{DynamicResource PanelMargin}">
                            <StackPanel><TextBlock Text="You need" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Excel workbook (.xlsx)" Style="{StaticResource BodyText}" Margin="0,8,0,4"/>
                                <TextBlock Text="Abbreviation column" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                                <TextBlock Text="Family name column" Style="{StaticResource BodyText}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Padding="{DynamicResource PanelPadding}" Margin="{DynamicResource PanelMargin}">
                            <StackPanel><TextBlock Text="Kept with your list" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Other-language names" Style="{StaticResource BodyText}" Margin="0,8,0,4"/>
                                <TextBlock Text="Notes and original rows" Style="{StaticResource BodyText}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Padding="{DynamicResource PanelPadding}" Margin="{DynamicResource PanelMargin}">
                            <StackPanel><TextBlock Text="Imported into" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="This project's family panel" Style="{StaticResource BodyText}" Margin="0,8,0,4"/>
                                <TextBlock Text="Next, after import: open Group by evidence and review protein choices in Family checklist" Style="{StaticResource BodyText}"/>
                            </StackPanel>
                        </Border>
                        <WrapPanel><Button x:Name="ExampleButton" Content="Try with the example" Margin="0,4,8,0" Click="Example_Click" ToolTip="Writes a new example workbook to a temporary folder and opens it for practice; your project changes only if you complete Import. Available before import when no read is running."/>
                            <Button x:Name="TemplateButton" Content="Save a template" Click="Template_Click" ToolTip="Saves a new Excel template at a location you choose; this writes a file and leaves the project unchanged. Available before import when no read is running."/>
                            <Button Content="Edit current panel" Click="Editor_Click" ToolTip="Closes this draft and opens the existing family panel editor; choosing this button alone changes nothing. Available before import when no read is running."/></WrapPanel>
                    </StackPanel></ScrollViewer>
                </Grid>
                <Grid IsEnabled="{Binding CanEdit}">
                    <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardPage}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Workbook" Style="{StaticResource SectionTitle}"/>
                        <DockPanel Margin="0,4,0,10"><Button x:Name="BrowseButton" Content="Browse" DockPanel.Dock="Right" Click="Browse_Click" ToolTip="Chooses an Excel workbook to preview without changing it or the project. Available before import when no read is running."/>
                            <TextBox x:Name="WorkbookPathBox" Text="{Binding WorkbookPath, Mode=OneWay}" IsReadOnly="True" MinHeight="34"
                                     ToolTip="The full path of the selected Excel workbook, initially empty and read only. Choose Browse or drop one .xlsx file to change the source before Import; viewing it changes nothing." AutomationProperties.Name="Workbook"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Sheet" Style="{StaticResource SectionTitle}"/>
                                <ComboBox x:Name="SheetChoice" ItemsSource="{Binding Sheets}" SelectedItem="{Binding Sheet, Mode=OneWay}"
                                          SelectionChanged="Sheet_SelectionChanged" MinHeight="34" Margin="0,4,0,0" AutomationProperties.Name="Sheet" ToolTip="The source sheet to read, initially the detected family sheet; choose any visible sheet in this workbook. Available before Import after a read finishes; changing it rebuilds draft choices and leaves the project unchanged."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Header row" Style="{StaticResource SectionTitle}"/>
                                <TextBox x:Name="HeaderRowBox" Text="{Binding HeaderRowText, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" Margin="0,4,0,0"
                                         ToolTip="The Excel row containing the column names; starts at the detected header, or 1, and accepts whole numbers from 1 to 1048576. Choose Read this header row to use an edit in the draft; available before Import after the current read finishes." AutomationProperties.Name="Header row"/>
                                <Button Content="Read this header row" Margin="0,4,8,0" Click="Header_Click" ToolTip="Reads this sheet again using the entered positive Excel row number as its headers; earlier draft choices are rebuilt without changing the project. Available before import when no read is running."/>
                            </StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Other sheets" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Content="Keep as source notes" IsChecked="{Binding KeepOtherSheets}" Margin="4,10,0,0"
                                          ToolTip="Keeps every original cell value from other sheets as source notes; default unchecked ignores those sheets. Available before Import after a read finishes, with no measurements or family rules inferred.">
                                    <CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Style.Triggers><DataTrigger Binding="{Binding HasWorkbookMap}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></CheckBox.Style>
                                </CheckBox>
                                <TextBlock Text="{Binding KeptNotesSummary}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding KeptNotesSummary}">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasWorkbookMap}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                    <TabControl x:Name="WorkbookTabs" Grid.Row="1" SelectedIndex="1" Padding="0">
                        <TabItem x:Name="WorkbookMapTab" Header="Workbook sheets" Visibility="{Binding HasWorkbookMap, Converter={StaticResource BoolVisibility}}"
                                 ToolTip="Shows every source sheet, its proposed role and what is kept. Role changes rebuild the draft proposal; the workbook and project stay unchanged.">
                            <Grid Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,6"><DockPanel><Button Content="Use selected family sheet" DockPanel.Dock="Right" Click="WorkbookFamilySheet_Click" IsEnabled="{Binding CanChooseFamilySheet}"
                                    ToolTip="Uses the selected sheet as the family list and rebuilds its column proposals. Choose a sheet to enable this before Import while no step is running; the workbook and project stay unchanged."/>
                                    <TextBlock Text="{Binding WorkbookMapSummary}" Style="{StaticResource SectionTitle}"/></DockPanel>
                                    <TextBlock Text="{Binding WorkbookHintStatus}" Style="{StaticResource CaptionText}"/>
                                    <ItemsControl ItemsSource="{Binding WorkbookProblemMessages}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                                <DataGrid x:Name="WorkbookMapGrid" Grid.Row="1" RowHeight="24" ItemsSource="{Binding WorkbookSheets}" SelectedItem="{Binding SelectedWorkbookSheet}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          AutomationProperties.Name="Workbook sheets and proposed roles" ToolTip="Lists all workbook sheets and the roles proposed from their structure. Choose a role before Import while no step is running; the proposal is rebuilt without changing the source or project.">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Sheet" Binding="{Binding Name}" Width="2*" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="Original sheet name, read only. Hidden sheets are listed too; no name is used as a family rule."/>
                                        <DataGridComboBoxColumn x:Name="WorkbookRoleColumn" Header="Use as" SelectedValueBinding="{Binding Role, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="160"
                                            ElementStyle="{StaticResource WorkbookRoleCombo}" EditingElementStyle="{StaticResource WorkbookRoleComboEditor}" theme:TableAppearance.HeaderToolTip="The proposed role: Family list, Colour legend, Subclass table or Notes. You may change it before Import; changing a role rebuilds the draft and keeps the workbook unchanged."/>
                                        <DataGridTextColumn Header="Kept as" Binding="{Binding Contribution}" Width="180" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="How this sheet contributes to the proposal, based on its selected role. Notes are kept as original text and never become family rules."/>
                                        <DataGridTextColumn Header="Review" Binding="{Binding Review}" Width="110" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="Whether the proposed role needs your review. Uncertain source content stays visible and is never accepted silently."/>
                                        <DataGridTextColumn Header="Why this role" Binding="{Binding Reason}" Width="3*" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="The structural reason supplied by the workbook reader, read only. It explains a proposal rather than changing any decision."/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DockPanel Grid.Row="2" Margin="0,8,0,4"><Button Content="Read kept notes" DockPanel.Dock="Right" Click="WorkbookNotes_Click"
                                    ToolTip="Opens the original text from notes sheets in a read-only report. Viewing it changes neither the draft nor the project."/>
                                    <TextBlock Text="{Binding KeptNotesSummary}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding KeptNotesSummary}"/>
                                </DockPanel>
                                <Expander Grid.Row="3" Header="Kept notes preview" ToolTip="Shows the original notes text retained from the workbook. Opening it changes nothing; Read kept notes displays the complete text.">
                                <DataGrid MaxHeight="100" RowHeight="28" ItemsSource="{Binding KeptNotes}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                    AutomationProperties.Name="Notes sheets kept with the family list" ToolTip="Lists notes sheets that will be retained with the panel. All values are source text, not measurements or automatic rules.">
                                    <DataGrid.Columns><DataGridTextColumn Header="Sheet" Binding="{Binding SheetName}" Width="200" theme:TableAppearance.HeaderToolTip="Original name of a kept notes sheet, read only. Read kept notes opens the full source text."/>
                                        <DataGridTextColumn Header="Source notes" Binding="{Binding Text}" Width="*" theme:TableAppearance.HeaderToolTip="Original cell text from the sheet, shown as a preview. Read kept notes displays it in full; Import retains it with the panel."/></DataGrid.Columns>
                                </DataGrid>
                                </Expander>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="SheetPreviewTab" Header="Sheet preview" ToolTip="Shows original row numbers, text and cell fills from the selected family sheet. Select a cell for complete details; this view changes nothing.">
                            <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="SheetPreviewGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionUnit="Cell" SelectedCellsChanged="Preview_SelectedCellsChanged" HeadersVisibility="Column" FrozenColumnCount="1" Margin="0,6,0,0" RowHeight="30"
                              AutomationProperties.Name="Spreadsheet preview with source row numbers" ToolTip="Shows original cell text and Excel row numbers; select a cell for its complete details. The table is read only and never changes the workbook or project."/>
                    <Expander x:Name="CellDetails" Grid.Row="1" Header="Cell details" Margin="0,8,0,0" ToolTip="Shows the complete selected source cell, original fill and merged range; opening this section changes nothing.">
                        <TextBox x:Name="CellDetailText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="110" MinHeight="50" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Complete source cell text, fill and merged range" ToolTip="The complete selected source cell text, original fill and merged range, initially no selection and read only. Selecting another preview cell changes this display without changing the workbook or project."/>
                    </Expander>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
                <Grid IsEnabled="{Binding CanEdit}">
                    <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardPage}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding ReviewingDecisions}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding MainColumns}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource SectionTitle}"/>
                                    <ComboBox ItemsSource="{Binding Headers}" SelectedItem="{Binding Header, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" Margin="0,4,0,6" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding ToolTip}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource HeaderLabel}}" ToolTip="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding Example}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxHeight="66" ToolTip="{Binding Example}"/>
                                </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Visibility="{Binding HasDecisionHint, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12">
                                <Button x:Name="UseDecisionHintButton" Content="Use this decision column" Click="UseDecisionHint_Click" DockPanel.Dock="Right"
                                        ToolTip="Uses the suggested source column for Decision and opens its labels for your review; nothing changes in the project. Each proposed action still needs confirmation before Import."/>
                                <TextBlock x:Name="DecisionHintText" Text="{Binding DecisionHintQuestion}" ToolTip="{Binding DecisionHintReason}" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <StackPanel Visibility="{Binding HasDecisions, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12">
                                <TextBlock Text="{Binding DecisionSummary}" Style="{StaticResource CaptionText}"/>
                                <Button Content="Review decision values" Margin="0,4,8,0" Click="ReviewDecisions_Click" HorizontalAlignment="Left" ToolTip="Shows every distinct source label and its proposed action for your confirmation; the project stays unchanged. Available before import when no read is running."/>
                            </StackPanel>
                            <Expander x:Name="ColourCategories" Header="Colour categories (optional)" IsExpanded="{Binding HasSourceFills, Mode=OneWay}" ToolTip="Shows optional text names for workbook fills and opens automatically when the source has fills. Opening or closing it changes nothing, and fill names never decide a family action.">
                                <StackPanel>
                                    <TextBlock Text="Column with coloured cells" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                                    <ComboBox DataContext="{Binding ColorColumn}" ItemsSource="{Binding Headers}" SelectedItem="{Binding Header, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" AutomationProperties.Name="{Binding Label, FallbackValue=Colour category column}" ToolTip="{Binding ToolTip, FallbackValue=Choose the column whose fills become source categories. Choose a workbook before setting the column; this edits the import draft only.}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource HeaderLabel}}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <DataGrid x:Name="ColourCategoriesGrid" ItemsSource="{Binding SourceColorChoices}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="130" Margin="0,8,0,0" AutomationProperties.Name="Source colour category names" ToolTip="Optional text categories for the chosen column fills; each starts with its source name, accepts a replacement name, and an empty edit restores that name. These labels remain source text in the draft until Import, never a grouping or quantitation rule.">
                                        <DataGrid.Columns><DataGridTextColumn Header="Source colour" Binding="{Binding ColorName}" Width="*" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="The original fill name from the chosen source column; read only, with no family action inferred." ElementStyle="{StaticResource WizardCellText}" EditingElementStyle="{StaticResource WizardCellEditor}"/>
                                            <DataGridTextColumn Header="Source rows" Binding="{Binding Rows}" Width="*" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="Original Excel rows sharing this value, counted from 1; read only for checking the source." ElementStyle="{StaticResource WizardCellText}" EditingElementStyle="{StaticResource WizardCellEditor}"/>
                                            <DataGridTextColumn Header="Category name" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="2*" theme:TableAppearance.HeaderToolTip="An optional text label starting with the source fill name; any text is allowed, and clearing it restores the source name before Import." ElementStyle="{StaticResource WizardCellText}" EditingElementStyle="{StaticResource WizardCellEditor}"/></DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Visibility="{Binding ReviewingDecisions, Converter={StaticResource BoolVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding DecisionSummary}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="DecisionGrid" Grid.Row="1" ItemsSource="{Binding Decisions}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Decision values and proposed actions" ToolTip="Review each distinct source label, its rows and proposed action; the available actions have no automatic conditions. Choices stay in the draft until confirmed and imported, and the original labels are retained.">
                            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Reason}"/></Style></DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Source value" Width="2*" MinWidth="160" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="The original spreadsheet decision label, retained with each imported family; read only and never an automatic condition."><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Source}" Style="{StaticResource SourceText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn theme:TableAppearance.FullTextPath="Meaning" x:Name="DecisionMeaningColumn" Header="Meaning from legend" Binding="{Binding Meaning}" Width="2*" MinWidth="140" IsReadOnly="True" Visibility="Collapsed"
                                    theme:TableAppearance.HeaderToolTip="The original meaning found for this label in the workbook legend, read only. Hover over a meaning to read it in full; it never confirms a program action by itself." ElementStyle="{StaticResource DecisionMeaningText}"/>
                                <DataGridTextColumn theme:TableAppearance.FullTextPath="Rows" Header="Source rows" Binding="{Binding Rows}" Width="*" MinWidth="110" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="Original Excel rows sharing this value, counted from 1; read only for checking the source." ElementStyle="{StaticResource WizardCellText}" EditingElementStyle="{StaticResource WizardCellEditor}"/>
                                <DataGridComboBoxColumn x:Name="DecisionActionColumn" Header="Use as (proposed)" SelectedValueBinding="{Binding Decision, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="180" theme:TableAppearance.HeaderToolTip="Choose Quantify, Merge into family, Report under others or Not a family, starting from the proposed action. Confirm these actions keeps your choice in the draft; changing it requires confirmation again before Import." ElementStyle="{StaticResource WizardCellCombo}" EditingElementStyle="{StaticResource WizardCellComboEditor}"/>
                                <DataGridTextColumn theme:TableAppearance.FullTextPath="Reason" CellStyle="{StaticResource DecisionMergeCell}" Header="Merge into abbreviation" Binding="{Binding MergeTarget, UpdateSourceTrigger=PropertyChanged}" Width="160" theme:TableAppearance.HeaderToolTip="The exact abbreviation of an existing kept family, initially empty unless a target was proposed; required only for Merge into family. Confirm these actions keeps the target in the draft until Import." ElementStyle="{StaticResource WizardCellText}" EditingElementStyle="{StaticResource WizardCellEditor}"/>
                                <DataGridTextColumn Header="Confirmed" Binding="{Binding Confirmation}" IsReadOnly="True" Width="95" theme:TableAppearance.FullTextPath="Reason" theme:TableAppearance.HeaderToolTip="Whether the source action was explicitly reviewed in this draft, read only. The project changes only when the import succeeds." ElementStyle="{StaticResource WizardCellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Grid.Row="2"><Button Content="Back to columns" Margin="0,4,8,0" Click="BackToColumns_Click" ToolTip="Returns to the column choices without losing reviewed actions or changing the project. Available before import when no read is running."/><Button Content="Confirm these actions" Click="ConfirmDecisions_Click" ToolTip="Confirms the shown source labels and their chosen actions in this draft; a merge needs a valid target abbreviation. Nothing reaches the project until Import, and editing an action requires confirmation again."/></WrapPanel>
                    </Grid>
                </Grid>
                <Grid IsEnabled="{Binding CanEdit}">
                    <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardPage}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding SpecialSummary}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <DataGrid x:Name="SpecialRowsGrid" Grid.Row="1" ItemsSource="{Binding SpecialRows}" SelectedItem="{Binding SelectedSpecialRow}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Special source rows" ToolTip="Selects a source row that needs an explicit choice, including repeated abbreviations and several names. Selection changes only the details shown, with no project edit.">
                            <DataGrid.Columns><DataGridTextColumn HeaderStyle="{StaticResource WizardNumberHeader}" Header="Row" Binding="{Binding RowNumber}" Width="65" theme:TableAppearance.HeaderToolTip="The original Excel row number, counted from 1; read only and unchanged by import choices." ElementStyle="{StaticResource WizardNumberText}" EditingElementStyle="{StaticResource WizardCellEditor}"/>
                                <DataGridTextColumn Header="Abbreviation" Binding="{Binding Abbreviation}" Width="110" theme:TableAppearance.HeaderToolTip="The stable abbreviation from the source or your proposed correction; read only in this table. Change it in the Abbreviation box below; it must be nonempty and unique, and it stays in the draft until Import." ElementStyle="{StaticResource WizardCellText}" EditingElementStyle="{StaticResource WizardCellEditor}"/>
                                <DataGridTemplateColumn Header="What needs review" Width="*" theme:TableAppearance.HeaderToolTip="Why this original row needs your choice; read only, with the complete row available in Original source row."><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Message}" Style="{StaticResource SourceText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" theme:TableAppearance.HeaderToolTip="Whether the source row still needs a choice, is ready, or is explicitly skipped; read only, based on your draft choices." ElementStyle="{StaticResource WizardCellText}" EditingElementStyle="{StaticResource WizardCellEditor}"/></DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="{Binding SelectedSpecialRow.Message}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                        <Expander Header="Original source row" Margin="0,8" ToolTip="Shows every original column value for the selected row; opening this section changes nothing."><TextBox Text="{Binding SelectedSpecialRow.Original, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Complete original source row" ToolTip="The complete original text and column labels for the selected row, read only. Selecting a different special row changes this display without editing the workbook or project."/></Expander>
                        <TextBlock Text="Use this row as" Style="{StaticResource CaptionText}"/>
                        <ComboBox x:Name="RowActionChoice" SelectionChanged="RowAction_SelectionChanged" SelectedValuePath="Value" DisplayMemberPath="Label" MinHeight="34" AutomationProperties.Name="Special row action" ToolTip="How this row will be kept, skipped, merged, split or reported under others, starting with its proposed choice. Choose one available action and Use this choice before Import; only the draft changes after the current read finishes."/>
                        <StackPanel Visibility="{Binding SelectedSpecialRow.EditingSingleFamily, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="Abbreviation" Style="{StaticResource CaptionText}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding SelectedSpecialRow.Key, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" AutomationProperties.Name="Abbreviation for this source row" ToolTip="The proposed stable abbreviation for this row; starts with the original abbreviation or proposed unique correction and requires nonempty text that does not duplicate another imported abbreviation. Use this choice keeps it in the draft before Import, once any read finishes."/>
                        <TextBlock Text="Family name" Style="{StaticResource CaptionText}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding SelectedSpecialRow.Name, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="32" AutomationProperties.Name="Family name for this source row" ToolTip="The family name to display for this row, starting from its source name; enter nonempty text for a kept family. Use this choice keeps it in the draft before Import, once any read finishes."/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding SelectedSpecialRow.Merging, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Merge into abbreviation" Style="{StaticResource CaptionText}" Margin="0,10,0,4"/>
                            <TextBox Text="{Binding SelectedSpecialRow.MergeTarget, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" AutomationProperties.Name="Merge target abbreviation" ToolTip="The exact abbreviation of an existing kept family, initially empty unless a target was proposed; required only when merging this row. Use this choice keeps the merge in the draft before Import, once any read finishes."/></StackPanel>
                        <DataGrid ItemsSource="{Binding SelectedSpecialRow.Parts}" Visibility="{Binding SelectedSpecialRow.Splitting, Converter={StaticResource BoolVisibility}}"
                                  AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" MaxHeight="190" MinHeight="100" Margin="0,12,0,0" AutomationProperties.Name="One abbreviation and name for each split family" ToolTip="The proposed separate families from this source cell; edit or add nonempty unique abbreviations and nonempty names, or remove an unwanted part. Use this choice keeps the split in the draft before Import, once any read finishes.">
                            <DataGrid.Columns><DataGridTextColumn Header="Abbreviation" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*" theme:TableAppearance.HeaderToolTip="The abbreviation for one split family, starting from its proposed value; enter nonempty text that is unique within this import. Use this choice keeps it in the draft until Import." ElementStyle="{StaticResource WizardCellText}" EditingElementStyle="{StaticResource WizardCellEditor}"/>
                                <DataGridTextColumn Header="Family name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*" theme:TableAppearance.HeaderToolTip="The name for one split family, starting from its proposed source name; enter nonempty text. Use this choice keeps it in the draft until Import." ElementStyle="{StaticResource WizardCellText}" EditingElementStyle="{StaticResource WizardCellEditor}"/></DataGrid.Columns>
                        </DataGrid>
                        <Button x:Name="UseRowButton" Content="Use this choice" Click="UseRow_Click" IsEnabled="{Binding CanUseRowChoice}" HorizontalAlignment="Left" Margin="0,12,0,0" ToolTip="Keeps the selected row choice in the draft and checks its abbreviation, names and merge target; any remaining problem appears in Status and blocks Next. Choose a row and an action to enable this before Import when no step is running; the project stays unchanged."/>
                    </StackPanel></ScrollViewer>
                </Grid>
                <Grid IsEnabled="{Binding CanEdit}">
                    <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardPage}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="4"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <DataGrid x:Name="MatchFamiliesGrid" ItemsSource="{Binding MatchFamilies}" SelectedItem="{Binding SelectedMatchFamily}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Imported families and evidence matching choices" ToolTip="Selects the imported family whose stored-evidence labels you want to review. Selection changes only the visible suggestions, with no automatic matching or project edit.">
                        <DataGrid.Columns><DataGridTextColumn Header="Abbreviation" Binding="{Binding Key}" Width="110" theme:TableAppearance.HeaderToolTip="The stable abbreviation kept for this family; read only here. Split abbreviations were set on the Special rows page and stay in the draft until Import." ElementStyle="{StaticResource WizardCellText}" EditingElementStyle="{StaticResource WizardCellEditor}"/>
                            <DataGridTemplateColumn Header="Family name" Width="*" theme:TableAppearance.HeaderToolTip="The family name kept for this family; read only here. A split name was set on the Special rows page and stays in the draft until Import."><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource SourceText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Choice" Binding="{Binding Choice}" Width="120" theme:TableAppearance.HeaderToolTip="Whether this family still needs matching, is confirmed, skipped, or keeps earlier matches; read only and separate from protein membership." ElementStyle="{StaticResource WizardCellText}" EditingElementStyle="{StaticResource WizardCellEditor}"/></DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding SelectedMatchFamily.Name}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="NoFamilyLevelMatchText" Text="No family-level match" Style="{StaticResource CaptionText}"
                                       Visibility="{Binding SelectedMatchFamily.HasNoFamilyLevelMatch, Converter={StaticResource BoolVisibility}}"/>
                            <TextBlock Text="{Binding MatchStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding MatchingSourceStatus}" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                        <Grid Grid.Row="1" xmlns:theme="clr-namespace:FamilyQuant.Themes">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid x:Name="MatchSuggestionsGrid" ItemsSource="{Binding SelectedMatchFamily.PrimarySuggestions}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="100" AutomationProperties.Name="Suggested stored-evidence matches" ToolTip="Shows proposed stored-evidence labels and distinct database entry counts; suggestions can overlap, so their counts must not be added. Tick and confirm labels before Import; no protein grouping or new evidence download runs here.">
                                <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Details}"/></Style></DataGrid.RowStyle>
                                <DataGrid.Columns><DataGridCheckBoxColumn Header="Use" Binding="{Binding Use, UpdateSourceTrigger=PropertyChanged}" Width="55" theme:TableAppearance.HeaderToolTip="Select this value for explicit confirmation. Pfam values from your sheet start ticked, other new suggestions start unticked, and saved choices take precedence; confirmation stages the draft until Import." ElementStyle="{StaticResource WizardCellCheck}" EditingElementStyle="{StaticResource WizardCellCheckEditor}"/>
                                    <DataGridTemplateColumn Header="Stored evidence" Width="*" theme:TableAppearance.HeaderToolTip="A family name, keyword or domain label from stored evidence or your sheet. Edit or untick it before confirming; counts refresh for the exact value."><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Text}" Style="{StaticResource SourceText}"/><TextBlock Text="{Binding Origin}" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding IsFromSheet, Converter={StaticResource BoolVisibility}}" ToolTip="This Pfam accession was supplied in your family-list row; you can untick it."/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ToolTip="A proposed stored family name, keyword or domain label; starts from stored evidence and accepts nonempty one-line text. Tick and confirm edited values again before Import; counts refresh for the exact edited value."/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn theme:TableAppearance.FullTextPath="Details" Header="Type" Binding="{Binding Type}" Width="120" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="The source kind of this stored-evidence label, such as family name, keyword or domain; read only and retained with confirmed choices." ElementStyle="{StaticResource WizardCellText}" EditingElementStyle="{StaticResource WizardCellEditor}"/>
                                    <DataGridTextColumn HeaderStyle="{StaticResource WizardNumberHeader}" theme:TableAppearance.FullTextPath="Details" Header="Proteins" Binding="{Binding Proteins}" Width="85" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="Distinct target database entries covered by this exact label; read only, and overlapping suggestion counts must not be added." ElementStyle="{StaticResource WizardNumberText}" EditingElementStyle="{StaticResource WizardCellEditor}"/>
                                    <DataGridTextColumn HeaderStyle="{StaticResource WizardNumberHeader}" theme:TableAppearance.FullTextPath="Details" Header="Reviewed" Binding="{Binding Reviewed}" Width="85" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="Covered database target entries marked reviewed in stored UniProt evidence; these are part of Proteins, never an additional count." ElementStyle="{StaticResource WizardNumberText}" EditingElementStyle="{StaticResource WizardCellEditor}"/></DataGrid.Columns>
                            </DataGrid>
                            <Expander x:Name="AdditionalMatchesExpander" Grid.Row="1" Header="Show more" Margin="0,8,0,0"
                                      IsExpanded="{Binding SelectedMatchFamily.ShowAdditional, Mode=TwoWay}"
                                      Visibility="{Binding SelectedMatchFamily.HasAdditionalSuggestions, Converter={StaticResource BoolVisibility}}"
                                      ToolTip="Shows extra stored-evidence suggestions for this family, including shared keywords and tissue text. Opening the list changes only this page.">
                                <DataGrid x:Name="AdditionalMatchSuggestionsGrid" ItemsSource="{Binding SelectedMatchFamily.AdditionalSuggestions}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="190" MinHeight="100"
                                          AutomationProperties.Name="Additional stored-evidence matches" Margin="0,6,0,0"
                                          ToolTip="Lists extra stored-evidence labels whose names may provide less specific support for this family. A tick is only a draft choice until you confirm the matches and import the family list.">
                                    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Details}"/></Style></DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Use" Width="55" theme:TableAppearance.HeaderToolTip="Select this stored-evidence value for explicit confirmation; new suggestions start unticked. Confirmation stages it in the draft until Import, with protein assignment reviewed separately.">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <CheckBox IsChecked="{Binding Use, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                          ToolTip="Select this stored-evidence value for explicit confirmation; new suggestions start unticked. Confirmation stages it in the draft until Import, with protein assignment reviewed separately."/>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Stored evidence" Width="*" theme:TableAppearance.HeaderToolTip="A proposed stored family name, keyword or domain label; starts from stored evidence and accepts nonempty one-line text. Tick and confirm edited values again before Import; counts refresh for the exact edited value.">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Text}" Style="{StaticResource SourceText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate><DataTemplate>
                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="A proposed stored family name, keyword or domain label; starts from stored evidence and accepts nonempty one-line text. Tick and confirm edited values again before Import; counts refresh for the exact edited value."/>
                                            </DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn theme:TableAppearance.FullTextPath="Details" Header="Type" Binding="{Binding Type}" Width="120" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="The source kind of this stored-evidence label, such as family name, keyword or domain; read only and retained with confirmed choices."/>
                                        <DataGridTextColumn HeaderStyle="{StaticResource WizardNumberHeader}" ElementStyle="{StaticResource WizardNumberText}" theme:TableAppearance.FullTextPath="Details" Header="Proteins" Binding="{Binding Proteins}" Width="85" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="Distinct target database entries covered by this exact label; read only, and overlapping suggestion counts must not be added."/>
                                        <DataGridTextColumn HeaderStyle="{StaticResource WizardNumberHeader}" ElementStyle="{StaticResource WizardNumberText}" theme:TableAppearance.FullTextPath="Details" Header="Reviewed" Binding="{Binding Reviewed}" Width="85" IsReadOnly="True" theme:TableAppearance.HeaderToolTip="Covered database target entries marked reviewed in stored UniProt evidence; these are part of Proteins, never an additional count."/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Expander>
                        </Grid>
                        <WrapPanel Grid.Row="2"><Button Content="Use selected matches" Margin="0,4,8,0" Click="ConfirmMatches_Click" IsEnabled="{Binding CanConfirmMatches}" ToolTip="Confirms the ticked stored-evidence labels for the selected family in the draft; nothing assigns proteins or changes the project yet. Choose a family and tick at least one suggestion to enable this before Import when no step is running; each ticked value must be nonempty one-line text when you confirm."/>
                            <Button Content="{Binding SkipFamilyLabel}" Click="SkipMatch_Click" ToolTip="Skips new matches for this family, or keeps its previous confirmed matches when reimporting; the draft records this explicit choice. Available before import when no read is running, and the project changes only at Import."/><Button Content="{Binding SkipAllLabel}" Click="SkipAllMatches_Click" ToolTip="Skips new matching for every family and keeps earlier confirmed matches when present. Available before import when no read is running; protein review remains separate in Family checklist."/></WrapPanel>
                    </Grid>
                </Grid>
                <Grid>
                    <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardPage}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="5"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="Panel name" Style="{StaticResource SectionTitle}"/>
                        <TextBox Text="{Binding PanelName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Imported}" MinHeight="34" Margin="0,4,0,8" AutomationProperties.Name="Panel name" ToolTip="The name saved with this family list, initially the workbook name without its extension; any nonempty text is allowed. Editable before Import after a read finishes, and the project changes only at Import."/>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Sheet, StringFormat=Source sheet: {0}}" Style="{StaticResource CaptionText}" Margin="0,6,0,2"/>
                        <TextBlock Text="{Binding PreviousPanel, StringFormat=Current panel to replace: {0}}" Style="{StaticResource CaptionText}"/>
                        <TextBlock Text="{Binding MatchingChangeNotice}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <DataGrid x:Name="SummaryGrid" Grid.Row="1" ItemsSource="{Binding SummaryFamilies}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SizeChanged="SummaryGrid_SizeChanged" AutomationProperties.Name="Families that will be imported" ToolTip="Shows the exact families, actions, source categories and matching choices in the reviewed list. This table is read only; Import makes one project edit and Undo restores the prior list.">
                        <DataGrid.Columns><DataGridTextColumn Header="Abbreviation" Binding="{Binding Key}" Width="110" theme:TableAppearance.HeaderToolTip="The stable abbreviation kept for this family; read only here. Split abbreviations were set on the Special rows page and stay in the draft until Import." ElementStyle="{StaticResource WizardCellText}" EditingElementStyle="{StaticResource WizardCellEditor}"/>
                            <DataGridTemplateColumn Header="Family name" Width="2*" theme:TableAppearance.HeaderToolTip="The family name kept for this family; read only here. A split name was set on the Special rows page and stays in the draft until Import."><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource SourceText}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Other-language name" Width="2*" theme:TableAppearance.HeaderToolTip="Names retained under their original spreadsheet headers; read only and never used as measured values."><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding OtherName}" Style="{StaticResource SourceText}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="145" theme:TableAppearance.HeaderToolTip="The reviewed action retained for this imported family; read only, with the original source label available in source notes." ElementStyle="{StaticResource WizardCellText}" EditingElementStyle="{StaticResource WizardCellEditor}"/>
                            <DataGridTextColumn Header="Colour" Binding="{Binding Color}" Width="130" theme:TableAppearance.HeaderToolTip="The optional source-fill category retained as text for this family; read only, with no grouping or quantitation rule inferred." ElementStyle="{StaticResource WizardCellText}" EditingElementStyle="{StaticResource WizardCellEditor}"/>
                            <DataGridTextColumn Header="Matches" Binding="{Binding Matches}" Width="120" theme:TableAppearance.HeaderToolTip="The explicit evidence-matching choice for this family; read only, and protein membership still requires Family checklist review." ElementStyle="{StaticResource WizardCellText}" EditingElementStyle="{StaticResource WizardCellEditor}"/>
                            <DataGridTemplateColumn Header="Notes" Width="145" theme:TableAppearance.HeaderToolTip="Opens the complete original fields kept for this family; viewing them changes nothing."><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Button Content="View source notes" Click="SourceNotes_Click" Padding="6,2" Margin="2" ToolTip="Shows all original source fields retained for this family in a read-only report; nothing changes in the workbook, draft or project."/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <Grid>
                    <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardPage}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="6"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <StackPanel><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Padding="{DynamicResource PanelPadding}">
                        <StackPanel><TextBlock Text="{Binding ImportedFamilyCount}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding PanelName, StringFormat=Panel: {0}}" Style="{StaticResource BodyText}" Margin="0,10,0,4"/>
                            <TextBlock Text="Workbook unchanged" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                            <TextBlock Text="Protein grouping unchanged" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                            <TextBlock Text="Project not saved yet" Style="{StaticResource BodyText}"/>
                            <TextBlock x:Name="MatchingEffectNote" Text="{x:Static local:FamilyListImportHelp.MatchingEffect}" Style="{StaticResource CaptionText}" Margin="0,12,0,0"
                                       TextWrapping="Wrap" ToolTip="{x:Static local:FamilyListImportHelp.MatchingEffect}"/>
                        </StackPanel>
                    </Border><Button x:Name="UndoImportButton" Content="Undo import" Click="Undo_Click" IsEnabled="{Binding CanUndo}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                     ToolTip="Restores the list and project state from immediately before this import in one Undo step. Available only while this import is the current unchanged Undo step."/></StackPanel>
                </Grid>
                </Grid>
            </Grid>
            <Grid x:Name="WizardFooter" Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite"/>
                    <Button Content="Help" Margin="0,4,8,0" Click="Help_Click" HorizontalAlignment="Left" ToolTip="Opens the illustrated import guide with instructions for each step; the draft, project and workbook stay unchanged."/>
                    <Button Content="Back to workbook review" Click="ReturnWorkbook_Click" HorizontalAlignment="Left" Visibility="{Binding CanReturnToWorkbook, Converter={StaticResource BoolVisibility}}"
                        ToolTip="Returns to the complete workbook proposal without losing your draft choices. Nothing changes in the project until Accept and import."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CloseButton" Content="{Binding CloseLabel}" Click="Close_Click" MinWidth="86" ToolTip="{Binding CloseToolTip}"/>
                    <Button x:Name="BackButton" Content="Back" Click="Back_Click" IsEnabled="{Binding CanBack}" MinWidth="86" ToolTip="{Binding BackToolTip}"/>
                    <Button x:Name="ForwardButton" Content="{Binding ForwardLabel}" Click="Forward_Click" IsEnabled="{Binding CanNext}" ToolTip="{Binding ForwardToolTip}"
                            Style="{DynamicResource PrimaryButton}" MinWidth="86" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid></Border>
</Window>
