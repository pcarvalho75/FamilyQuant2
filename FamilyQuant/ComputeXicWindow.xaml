<Window x:Class="FamilyQuant.ComputeXicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FamilyQuant" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Compute / update full XIC" Height="690" Width="820" MinHeight="610" MinWidth="700"
        Background="#333949">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Foreground="#FFD700" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Re-extract every identified peptide, and any kept de novo precursor, straight from the RAW acquisitions with the full isotope envelope, and store the numbers in this project. Nothing derived is computed here: the shares and the family rollups are a later step. Runs are matched to acquisitions by file name."/>

        <!-- RAW folder -->
        <Label Grid.Row="1" Grid.Column="0" Content="RAW folder" Foreground="White" VerticalAlignment="Center"
               ToolTip="The folder with the .raw files of these runs. Runs are matched to files by name, so the order of the files does not matter."/>
        <TextBox x:Name="TextBoxRawDirectory" Grid.Row="1" Grid.Column="1" Margin="8,4" Padding="4"
                 VerticalContentAlignment="Center"
                 ToolTip="Type or paste the folder with the .raw files here, or use Browse. Runs are matched to files by name."/>
        <Button x:Name="ButtonBrowseRaw" Grid.Row="1" Grid.Column="2" Content="Browse..." Margin="0,4" Padding="12,4"
                Click="ButtonBrowseRaw_Click"
                ToolTip="Choose the folder with the .raw files. The chosen folder is written into the box beside this button."/>

        <!-- SEPro package -->
        <Label Grid.Row="2" Grid.Column="0" Content="Identifications (.sepr2)" Foreground="White" VerticalAlignment="Center"
               ToolTip="The SEPro result file (.sepr2) with the identified peptides of these runs. Choose the one made from the same runs as the RAW files."/>
        <TextBox x:Name="TextBoxSeproPackage" Grid.Row="2" Grid.Column="1" Margin="8,4" Padding="4"
                 VerticalContentAlignment="Center"
                 ToolTip="Type or paste the path of the .sepr2 file here, or use Browse. It must come from the same runs as the RAW files."/>
        <Button x:Name="ButtonBrowseSepro" Grid.Row="2" Grid.Column="2" Content="Browse..." Margin="0,4" Padding="12,4"
                Click="ButtonBrowseSepro_Click"
                ToolTip="Choose the SEPro identification file (.sepr2). The identified peptides are taken from this file."/>

        <!-- De novo export (optional) -->
        <Label Grid.Row="3" Grid.Column="0" Content="De novo export root (optional)" Foreground="White" VerticalAlignment="Center"
               ToolTip="The folder with your PEAKS and/or DeepNovo exports. Only the source chosen below is read and filtered. Leave it empty to quantify only the identified peptides."/>
        <TextBox x:Name="TextBoxDeNovoDirectory" Grid.Row="3" Grid.Column="1" Margin="8,4" Padding="4"
                 VerticalContentAlignment="Center"
                 ToolTip="Type or paste the de novo export folder here, or use Browse. Subfolders are searched too. Leave it empty to store only the identified peptides."/>
        <Button x:Name="ButtonBrowseDeNovo" Grid.Row="3" Grid.Column="2" Content="Browse..." Margin="0,4" Padding="12,4"
                Click="ButtonBrowseDeNovo_Click"
                ToolTip="Choose the de novo export folder. Its subfolders are searched for the source chosen below. Leave the box empty to store only the identified peptides."/>

        <!-- Source-aware de novo selection. ALC and SCORE remain separate settings. -->
        <Label Grid.Row="4" Grid.Column="0" Content="De novo source" Foreground="White" VerticalAlignment="Center"
               ToolTip="Which de novo export to read. PEAKS ALC and DeepNovo SCORE are different scales, so each keeps its own cutoff and they are never mixed."/>
        <ComboBox x:Name="ComboBoxDeNovoSource" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                  Margin="8,4,0,4" Padding="4" SelectedIndex="0"
                  SelectionChanged="ComboBoxDeNovoSource_SelectionChanged"
                  ToolTip="The de novo source to read, or a union of PEAKS and DeepNovo. In a union, a precursor called by both is measured once under the PEAKS call, and the DeepNovo call is kept beside it.">
            <ComboBoxItem Content="PEAKS de novo only (*.denovoOnly.csv)" Tag="peaks-only"/>
            <ComboBoxItem Content="PEAKS de novo all (*.denovo.csv)" Tag="peaks-all"/>
            <ComboBoxItem Content="DeepNovo (*.deepnovo.csv)" Tag="deepnovo"/>
            <ComboBoxItem Content="Union: PEAKS de novo only + DeepNovo" Tag="union-only-deepnovo"/>
            <ComboBoxItem Content="Union: PEAKS de novo all + DeepNovo" Tag="union-all-deepnovo"/>
        </ComboBox>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,2,0,4">
            <Label Content="PEAKS minimum ALC (%)" Foreground="White" VerticalAlignment="Center"
                   ToolTip="The minimum PEAKS ALC (average local confidence) a call needs to be kept. Used only when a PEAKS source is selected."/>
            <TextBox x:Name="TextBoxPeaksMinimumAlc" Width="62" Margin="8,4,20,4" Padding="4" Text="80"
                     VerticalContentAlignment="Center"
                     ToolTip="PEAKS ALC cutoff, 0 to 100, default 80. It applies only to PEAKS calls."/>
            <Label Content="DeepNovo minimum SCORE (%)" Foreground="White" VerticalAlignment="Center"
                   ToolTip="The minimum DeepNovo SCORE a call needs to be kept. Used only for DeepNovo; a SCORE of 80 is not the same as a PEAKS ALC of 80."/>
            <TextBox x:Name="TextBoxDeepNovoMinimumScore" Width="62" Margin="8,4" Padding="4" Text="80"
                     VerticalContentAlignment="Center"
                     ToolTip="DeepNovo SCORE cutoff, 0 to 100, default 80. It applies only to DeepNovo calls."/>
        </StackPanel>

        <!-- Quantitation rules: the isotope ceiling and the minimum points per peak -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Label Content="Isotopes to credit (ceiling)" Foreground="White" VerticalAlignment="Center"
                   ToolTip="How many isotopes each peptide can be credited, counting M+0 as the first. It is a maximum: an isotope that is not found adds nothing. Leave it at 6."/>
            <xctk:IntegerUpDown x:Name="IntegerUpDownIsotopes" Minimum="1" Maximum="6" Width="70" Margin="8,0,0,0"
                                VerticalContentAlignment="Center"
                                ToolTip="Isotope ceiling, 1 to 6, default 6. Use 6 for the full envelope; 1 counts only the monoisotopic peak, as PatternLab's stored quants do."/>

            <Label Content="Minimum points per peak" Foreground="White" VerticalAlignment="Center" Margin="24,0,0,0"
                   ToolTip="How many points a peak needs before it is quantified. The program counts one padding point on each side, so 3 means at least one real detection and 5 means at least three. Default 3."/>
            <xctk:IntegerUpDown x:Name="IntegerUpDownMinPoints" Minimum="1" Maximum="20" Width="70" Margin="8,0,0,0"
                                VerticalContentAlignment="Center"
                                ToolTip="Minimum points per peak, 1 to 20, default 3 (one real detection). Use 5 to require three real detections; 1 switches the check off. The value is saved with the project."/>

        </StackPanel>

        <TextBlock Grid.Row="7" Grid.ColumnSpan="3" Foreground="#B7C0CF" TextWrapping="Wrap" Margin="0,8,0,4"
                   x:Name="TextBlockBasis"
                   ToolTip="The settings the next computation will use: isotope ceiling, minimum points, extraction window and MS1 tolerance. The last two are fixed to match the stored quants."/>

        <Button x:Name="ButtonCompute" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Content="Compute / update full XIC"
                HorizontalAlignment="Left" Margin="0,8" Padding="16,6" Click="ButtonCompute_Click"
                ToolTip="Measures every identified peptide, and any kept de novo precursor, from the RAW files and stores the numbers in this project. Needs at least the RAW folder and the .sepr2 file; Save the project afterwards to keep them."/>

        <Grid Grid.Row="9" Grid.ColumnSpan="3" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="ButtonViewSpectrumComparison" Content="View spectrum comparison table"
                    Padding="14,6" IsEnabled="False" Click="ButtonViewSpectrumComparison_Click"
                    ToolTip="Opens a read-only table with one row per file, scan and precursor, comparing the PEAKS, DeepNovo and PatternLab calls, and can save it as CSV. Disabled until a computation finishes."/>
            <TextBlock Grid.Column="1" x:Name="TextBlockSpectrumComparisonPath" Foreground="#B7C0CF" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       Text="The spectrum comparison CSV is written after a successful computation."
                       ToolTip="Where the latest computation saved the spectrum comparison CSV. It holds the same rows as the table."/>
        </Grid>

        <Border Grid.Row="10" Grid.ColumnSpan="3" Background="#2A303E" BorderBrush="#4A5568" BorderThickness="1"
                Padding="10" Margin="0,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TextBlockStatus" Foreground="#E6E9EF" TextWrapping="Wrap"
                           ToolTip="Shows what the computation is doing and what it found: progress, per-run counts and any refusal."/>
            </ScrollViewer>
        </Border>

        <Button x:Name="ButtonClose" Grid.Row="11" Grid.Column="2" Content="Close" Margin="0,8,0,0" Padding="18,6"
                Click="ButtonClose_Click"
                ToolTip="Close this window. A finished computation is kept in the project; Save the project to write it to disk."/>
    </Grid>
</Window>
