<Window x:Class="FamilyQuant.DatabaseUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update database" Width="1000" Height="700" MinWidth="860" MinHeight="540"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <DataTemplate x:Key="KeepNameTick">
            <CheckBox IsChecked="{Binding Keep, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" ToolTip="{Binding Help}"/>
        </DataTemplate>
        <DataTemplate x:Key="CaseChoice">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}" DisplayMemberPath="Label" MinWidth="260"
                      ToolTip="Pick the pair that is the same protein, or leave No pair so nothing is carried over."/>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,8" BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource ErrorBrush}"
                Visibility="{Binding HasWarnings, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock x:Name="warningText" Text="{Binding Warnings}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"/>
        </Border>
        <TabControl x:Name="updateTabs" Grid.Row="2" Margin="0,12,0,0">
            <TabItem x:Name="summaryTab" Header="Summary">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,0">
                        <DataGrid x:Name="countsGrid" ItemsSource="{Binding Counts}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="False"
                                  ToolTip="Target proteins only, from the comparison and the placement; decoys are counted below.">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="What happens" Width="360" MinWidth="240" Binding="{Binding What}"/>
                                <DataGridTextColumn Header="Proteins" Width="110" MinWidth="90" Binding="{Binding Proteins}"/>
                                <DataGridTextColumn Header="Detail" Width="*" MinWidth="200" Binding="{Binding Detail}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding DecoySummary}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="What Apply update does" Style="{StaticResource SectionTitle}" Margin="0,16,0,4"/>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyText}"
                                   Text="It changes the open project only: the file on disk stays as it was until you save, and Save as keeps both versions. Kept proteins keep their families, numbers, names and locks; kept families are never merged. Earlier Undo steps are cleared; to go back, close without saving."/>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                   Text="Afterwards: new proteins and changed sequences have no evidence until Fetch evidence, Group by evidence asks you to confirm the scope again, and Results stay from the previous database until Quantify runs again. Search PatternLab again with the new file to identify the new proteins."/>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                   Text="A rebuild with Build families could group a few proteins differently, because its fast pass depends on order; it stays available."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="rowsTab" Header="{Binding RowsHeader}">
                <DockPanel Margin="0,8,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                        <ComboBox x:Name="rowFilterBox" ItemsSource="{Binding RowFilters}" SelectedItem="{Binding RowFilter, Mode=TwoWay}" Width="230" DockPanel.Dock="Left"
                                  ToolTip="Narrows the table to one kind of change. The counts and Apply are not affected."/>
                        <CheckBox x:Name="showDecoysBox" Content="Show decoy rows" IsChecked="{Binding ShowDecoys}" VerticalAlignment="Center" Margin="16,0,0,0" DockPanel.Dock="Left"
                                  ToolTip="Lists decoy rows too; they follow the same rules as their targets."/>
                        <Button x:Name="saveCsvButton" Content="Save as CSV" Click="SaveCsv_Click" DockPanel.Dock="Right" Margin="8,0,0,0"
                                ToolTip="Saves every row, decoys included, as a CSV file with the columns of the saved change export."/>
                        <Button x:Name="copyRowsButton" Content="Copy" Click="CopyRows_Click" DockPanel.Dock="Right"
                                ToolTip="Copies the rows shown in the table as CSV text for a spreadsheet or a note."/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding RowsShown}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="selectedNote" DockPanel.Dock="Bottom" Text="{Binding SelectedItem.Note, ElementName=rowsGrid}" TextWrapping="Wrap"
                               Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
                    <DataGrid x:Name="rowsGrid" ItemsSource="{Binding VisibleRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Extended"
                              ToolTip="Every protein that is not unchanged: what happens, its old and new identifier, its family and how it was placed.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Change" Width="170" MinWidth="150" Binding="{Binding Change}"/>
                            <DataGridTextColumn Header="Old identifier" Width="190" MinWidth="140" Binding="{Binding OldIdentifier}"/>
                            <DataGridTextColumn Header="New identifier" Width="190" MinWidth="140" Binding="{Binding NewIdentifier}"/>
                            <DataGridTextColumn Header="Family" Width="70" MinWidth="70" Binding="{Binding Family}"/>
                            <DataGridTextColumn Header="Family name" Width="170" MinWidth="120" Binding="{Binding FamilyName}"/>
                            <DataGridTextColumn Header="Placed by" Width="170" MinWidth="120" Binding="{Binding PlacedBy}"/>
                            <DataGridTextColumn Header="Identity (%)" Width="104" MinWidth="104" Binding="{Binding Identity}"/>
                            <DataGridTextColumn Header="Aligned" Width="80" MinWidth="80" Binding="{Binding Aligned}"/>
                            <DataGridTextColumn Header="Note" Width="420" MinWidth="200" Binding="{Binding Note}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="casesTab" Header="{Binding CasesHeader}">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource BodyText}" Margin="0,0,0,8"
                               Text="The comparison could not tell these proteins apart, so nothing is carried over from them unless you pick the pair that is the same protein. A pick takes the outcome of the test that found the case."/>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="True">
                        <Button x:Name="compareAgainButton" Content="Compare again" Click="CompareAgain_Click" DockPanel.Dock="Right" IsEnabled="{Binding PicksPending}"
                                ToolTip="Runs the comparison and the placement again with these picks; nothing is applied yet."/>
                        <TextBlock Text="{Binding PicksStatus}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="No ambiguous cases: every protein was matched or is new." Style="{StaticResource CaptionText}"
                               Visibility="{Binding HasNoCases, Converter={StaticResource VisibleWhenTrue}}" x:Name="noCasesText"/>
                    <DataGrid x:Name="casesGrid" ItemsSource="{Binding Cases}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" SelectionMode="Single"
                              ToolTip="Each case lists the test that found it and why no single pair was certain.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Case" Width="60" MinWidth="60" IsReadOnly="True" Binding="{Binding Case}"/>
                            <DataGridTextColumn Header="Found by" Width="190" MinWidth="150" IsReadOnly="True" Binding="{Binding FoundBy}"/>
                            <DataGridTemplateColumn Header="Your pick" Width="380" MinWidth="280" IsReadOnly="True" CellTemplate="{StaticResource CaseChoice}"/>
                            <DataGridTextColumn Header="Why it is ambiguous" Width="*" MinWidth="260" IsReadOnly="True" Binding="{Binding Reason}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="4,4"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="namesTab" Header="{Binding NamesHeader}">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource BodyText}" Margin="0,0,0,8"
                               Text="A family's name comes from its members, so removing or renaming members can change it. Ticked: the old name is written as the annotation of every member and stays. Unticked: the name follows the members after the update."/>
                    <DataGrid x:Name="namesGrid" ItemsSource="{Binding Names}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" SelectionMode="Single"
                              ToolTip="A tick starts off where keeping the name would replace a different annotation of a surviving member.">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Keep the old name" Width="140" MinWidth="130" IsReadOnly="True" CellTemplate="{StaticResource KeepNameTick}"/>
                            <DataGridTextColumn Header="Family" Width="70" MinWidth="70" IsReadOnly="True" Binding="{Binding Family}"/>
                            <DataGridTextColumn Header="Old name" Width="200" MinWidth="140" IsReadOnly="True" Binding="{Binding OldName}"/>
                            <DataGridTextColumn Header="New name" Width="200" MinWidth="140" IsReadOnly="True" Binding="{Binding NewName}"/>
                            <DataGridTextColumn Header="Old name came from" Width="150" MinWidth="130" IsReadOnly="True" Binding="{Binding OldNameSource}"/>
                            <DataGridTextColumn Header="Keeping it replaces the annotation of" Width="*" MinWidth="220" IsReadOnly="True" Binding="{Binding Replaces}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="applyButton" Content="Apply update" Style="{DynamicResource PrimaryButton}" Click="Apply_Click" IsEnabled="{Binding CanApply}"
                        ToolTip="Makes these changes to the open project as one step; the file on disk changes only when you save."/>
                <Button x:Name="cancelButton" Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="8,0,0,0"
                        ToolTip="Closes the preview and leaves the project exactly as it was."/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
