<UserControl x:Class="FamilyQuant.BusyOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FamilyQuant">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid x:Name="Scrim" Background="{DynamicResource BusyScrimBrush}">
        <Border Background="{DynamicResource SurfaceBrush}" Padding="28" Margin="24" MaxWidth="520" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <DockPanel LastChildFill="True">
              <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="OperationCurrentItem" Text="{Binding Message}" Margin="0,12,0,16" TextWrapping="Wrap"/>
                <ProgressBar x:Name="OperationProgressBar" Height="6" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"
                             ToolTip="Shows completed work as a percentage when the current phase has a known total, otherwise indicates ongoing work without a percentage. Reading progress changes nothing."/>
                <TextBlock x:Name="OperationElapsed" Text="{Binding ElapsedText}" Margin="0,12,0,0" ToolTip="Time since this operation began, in hours, minutes and seconds. Reading the clock changes nothing."/>
                <TextBlock x:Name="OperationSinceLastStep" Text="{Binding SinceLastStepText}" Margin="0,4,0,0" ToolTip="Time since the latest recorded progress step, in hours, minutes and seconds. A quiet phase can still be working; reading the clock changes nothing."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                  <Button Content="Operation log" Click="OperationLog_Click" Margin="0,0,8,0" ToolTip="Opens the timestamped steps recorded so far for this operation. This read-only log changes no project data and does not stop the operation."/>
                  <Button x:Name="CancelOperationButton" Content="Cancel" Command="{Binding CancelCommand}"
                          ToolTip="{Binding CancelHint, FallbackValue='Unavailable because no operation is attached to this overlay. Start an operation to enable cancellation before it publishes its change.'}"/>
                </StackPanel>
              </StackPanel>
              <local:BusyLogo x:Name="AnimatedLogo" IsActive="{Binding IsBusy}" MaxHeight="220" Margin="0,0,0,24"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
