<UserControl x:Class="FamilyQuant.BusyOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid Background="{DynamicResource CanvasBrush}">
        <Border Background="{DynamicResource SurfaceBrush}" Padding="28" Width="480" MaxWidth="600"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Message}" Margin="0,12,0,16" TextWrapping="Wrap"/>
                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"
                             ToolTip="Shows progress for the current operation when its total is known."/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Right" Margin="0,20,0,0"
                        ToolTip="Requests cancellation after the current phase. Previous results stay available."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
