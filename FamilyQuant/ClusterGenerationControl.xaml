<UserControl x:Class="FamilyQuant.ClusterGenerationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:FamilyQuant;assembly=FamilyQuant.Core"
             xmlns:local="clr-namespace:FamilyQuant"
             xmlns:theme="clr-namespace:FamilyQuant.Themes"
             xmlns:numeric="clr-namespace:FamilyQuant"
             mc:Ignorable="d" FontSize="{DynamicResource BodySize}"
             d:DesignHeight="450" d:DesignWidth="1024">
    <UserControl.Resources><local:AccessionTextConverter x:Key="AccessionText"/></UserControl.Resources>

    <Grid Background="{DynamicResource CanvasBrush}" Margin="12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="Families" Style="{StaticResource PageTitle}" DockPanel.Dock="Left"/>
                <Label x:Name="LabelNumberOfGroups" HorizontalAlignment="Right" ToolTip="Visible families and families in the file. Display filters never change the saved grouping or percentages."/>
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                <Label Content="Search" Target="{Binding ElementName=TextBoxSearch}" VerticalAlignment="Center" Margin="0,0,8,0"
                       ToolTip="Filter the protein table without changing the stored families or shares."/>
                <TextBox x:Name="TextBoxSearch" KeyUp="TextBoxSearch_KeyUp" AutomationProperties.Name="Search proteins"
                         ToolTip="Filter by accession, description or domain, using commas between alternatives. Filtering never changes a percentage."/>
            </DockPanel>
<Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" MinWidth="220"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.2*" MinWidth="220"/></Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                    <Button DockPanel.Dock="Top" Content="All proteins" Click="AllFamilyProteins_Click" HorizontalAlignment="Left" Margin="0,0,0,8"
                            ToolTip="Show every visible protein instead of one selected family. Your display filters and curation stay unchanged."/>
                    <DataGrid x:Name="DataGridFamilies" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                              ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily, Mode=TwoWay}"
                              SelectionChanged="FamilySelection_Changed" CellEditEnding="FamilyName_EditEnding"
                              ToolTip="Select a family to show its proteins beside this table. Edit the name or lock; Undo reverses each committed change.">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Lock" Width="64" MinWidth="64" IsReadOnly="True" SortMemberPath="IsLocked">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <CheckBox IsChecked="{Binding IsLocked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Click="FamilyLock_Click" HorizontalAlignment="Center"
                                              ToolTip="Protect this family from automatic grouping, or remove that protection. Undo reverses this lock change."/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ID" Width="50" MinWidth="50" IsReadOnly="True" Binding="{Binding FamilyId}"/>
                            <DataGridTextColumn x:Name="ColumnFamilyName" Header="Family name" Width="*" MinWidth="160" Binding="{Binding Name}"/>
                            <DataGridTextColumn x:Name="ColumnFamilyProteins" Header="Proteins" Width="70" MinWidth="70" theme:TableAppearance.FullTextPath="CountHelp" IsReadOnly="True" Binding="{Binding Proteins}"/>
                            <DataGridTextColumn x:Name="ColumnFamilyFullXic" Header="Full XIC share" Width="110" MinWidth="110" IsReadOnly="True" Binding="{Binding FullXicShare, StringFormat=P3}"/>
                            <DataGridTextColumn x:Name="ColumnFamilyPatternLab" Header="PatternLab share" Width="110" MinWidth="110" IsReadOnly="True" Binding="{Binding PatternLabShare, StringFormat=P3}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              Focusable="True" ToolTip="Resize the family overview and protein table. Focus here and use the arrow keys for keyboard resizing."/>
                <DataGrid Grid.Column="2" x:Name="DataGridResultGrid" AutoGenerateColumns="False" LoadingRow="DataGridResultGrid_LoadingRow" ClipToBounds="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CellEditEnding="DataGridResultGrid_CellEditEnding"
                          SelectionChanged="DataGridResultGrid_SelectionChanged"
                          Sorting="DataGridResultGrid_Sorting"
                          AlternatingRowBackground="{DynamicResource SubtleBrush}" GridLinesVisibility="None" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColumnUSearchId" CanUserReorder="True" IsReadOnly="True" CanUserResize="True" CanUserSort="True"
                                            Visibility="Collapsed" Header="USearch ID" Width="90" MinWidth="90" Binding="{Binding Path=USearchID}" />
                        <DataGridTextColumn x:Name="ColumnUserId" CanUserReorder="True" CanUserResize="True" CanUserSort="True"
                                            Header="User ID" Width="80" MinWidth="80" Binding="{Binding Path=UserID, Mode=TwoWay}" />
                        <DataGridTextColumn x:Name="ColumnLocus" CanUserReorder="True" IsReadOnly="True" CanUserResize="True" CanUserSort="True"
                                            Header="Locus" Width="120" MinWidth="120" theme:TableAppearance.FullTextPath="SequenceIdentifier"
                                            Binding="{Binding Path=SequenceIdentifier, Converter={StaticResource AccessionText}}"/>
                        <DataGridTextColumn x:Name="ColumnDescription" CanUserReorder="True" IsReadOnly="True" CanUserResize="True" CanUserSort="True"
                                            Header="Description" Width="*" MinWidth="220" Binding="{Binding Path=Description}"/>
                        <DataGridTextColumn x:Name="ColumnFullXic" CanUserReorder="True" IsReadOnly="True" CanUserResize="True" CanUserSort="True"
                                            SortMemberPath="FullXicShare"
                                            Header="Full XIC share" Width="170" MinWidth="170" Binding="{Binding Path=FullXicShare, StringFormat=P3}"/>
                        <DataGridTextColumn x:Name="ColumnXicUser" CanUserReorder="True" IsReadOnly="True" CanUserResize="True" CanUserSort="True"
                                            Header="Share of signal" Width="170" MinWidth="170" Binding="{Binding Path=XICUser, StringFormat=P3}"/>
                        <DataGridTextColumn x:Name="ColumnUserAnnotation" CanUserReorder="True" CanUserResize="True" CanUserSort="True"
                                            Header="User Annotation" Width="150" MinWidth="150" Binding="{Binding Path=UserAnnotation, Mode=TwoWay}"/>
                        <DataGridTextColumn x:Name="ColumnDomains" CanUserReorder="True" IsReadOnly="True" CanUserResize="True" CanUserSort="True"
                                            Header="Domains" Width="170" MinWidth="170" Binding="{Binding Path=Domains}"/>
                        <DataGridTextColumn x:Name="ColumnMass" CanUserReorder="True" IsReadOnly="True" CanUserResize="True" CanUserSort="True"
                                            Header="Residue mass (Da)" Width="110" MinWidth="110" Binding="{Binding Path=MonoisotopicMass, StringFormat=N3}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
<Border x:Name="BorderCurationStatus" Grid.Row="3" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel LastChildFill="True">
                <Button x:Name="ButtonHelp" DockPanel.Dock="Right" Content="?  How to read these numbers"
                        Click="ButtonHelp_Click" Margin="10,0,0,0" Padding="10,4" FontWeight="Normal"
                        Background="{DynamicResource EdgeBrush}"
                        ToolTip="Opens a page that explains every number on this screen. Read it the first time, and whenever a number does not look as you expected."/>

                <TextBlock x:Name="TextBlockStatusLine" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" FontSize="12"
                           Text="showing: family clustering only · no quantitation loaded"
                           ToolTip="What the share column currently shows: its denominator, how shared peptides were treated, and how many families got a value. It changes only when you press Recalculate."/>
            </DockPanel>
        </Border>
        </Grid>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <GroupBox Header="Grouping" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="1" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                            <Button Grid.Column="1" x:Name="ButtonFetchDomains" Content="Fetch evidence" Click="ButtonFetchDomains_Click"
                                    ToolTip="Needs an open database and internet; about 1 to 2 minutes for 30,000 proteins."/>
                        </Grid>
                        <TextBlock Text="{Binding EvidenceStepStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource CaptionSize}" Margin="28,0,4,8"/>
                        <Button x:Name="ButtonRetryPanel" Content="Retry panel" Click="ButtonRetryPanel_Click"
                                Margin="28,0,0,8" HorizontalAlignment="Left" ToolTip="{Binding PanelFailureDetail}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding HasIncompletePanel}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="2" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                            <Button Grid.Column="1" x:Name="ButtonEvidenceGrouping" Content="Group by evidence"
                                    Click="ButtonEvidenceGrouping_Click" ToolTip="Fetch evidence first; review and Apply grouping usually take a few minutes."/>
                        </Grid>
                        <TextBlock Text="{Binding EvidenceGroupingStepStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource CaptionSize}" Margin="28,0,4,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="3" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                            <Button Grid.Column="1" x:Name="ButtonFetchFamilyWorld" Content="Fetch family world" Click="ButtonFetchFamilyWorld_Click"
                                    ToolTip="Apply grouping with a confirmed scope first; needs internet and usually takes a few minutes."/>
                        </Grid>
                        <TextBlock x:Name="TextBlockFamilyWorldState" Text="{Binding FamilyWorldStepStatus}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource CaptionSize}" Margin="28,0,4,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="4" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                            <Button Grid.Column="1" x:Name="ButtonComputeFullXic" Content="Compute full XIC"
                                    Command="{x:Static local:MainWindow.NavigateShellCommand}" CommandParameter="{x:Static local:ShellDestination.Quantify}"
                                    ToolTip="After Fetch family world, choose RAW files and an identification package in Quantify; computing takes minutes to hours."/>
                        </Grid>
                        <TextBlock Text="{Binding FullXicStepStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource CaptionSize}" Margin="28,0,4,8"/>
                        <TextBlock Text="Other grouping" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource CaptionSize}" Margin="4,12,4,4"/>
                        <Button x:Name="ButtonSuperCluster" Content="Group by keywords" Click="ButtonSuperCluster_Click"
                                ToolTip="Enter keywords, exclusions and the match rule in the grouping review. Review the protein ticks before applying; Undo reverses the grouping."/>
                        <Button x:Name="ButtonAlignSelected" Content="Align selected" Click="ButtonAlignSelected_Click" IsEnabled="False"
                                ToolTip="Align the selected proteins without changing their families. Disabled until at least two rows are selected in the protein table."/>
                        <CheckBox x:Name="CheckBoxIncludeFamilyPositions" Content="Include selected families in position fetch" Margin="4,4,4,0"
                                  ToolTip="Also fetch positions for every member of the families selected in the protein table. By default, only proteins reached by computed peptides are requested."/>
                        <Grid Margin="4,8,4,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Identity" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                            <Label Grid.Column="1" x:Name="LabelClusterThreshold" Margin="8,0,0,0"
                                   ToolTip="The sequence identity used when building these families. Build from database lets you choose a different threshold."/>
                            <TextBlock Grid.Row="1" Text="Word similarity" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                            <Label Grid.Row="1" Grid.Column="1" x:Name="LabelWordSimilarity" Margin="8,0,0,0"
                                   ToolTip="The last description similarity threshold, or keywords for a keyword grouping. None means only sequence identity was used."/>
                        </Grid>
                        <Border x:Name="BadgeLayer1" Visibility="Collapsed"><TextBlock x:Name="TextBlockLayer1State"/></Border>
                    </StackPanel>
                </GroupBox>
                <Expander x:Name="WordGroupingActions" Header="Recluster by words" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <Label Content="Description similarity" ToolTip="The minimum description similarity that permits a word grouping."/>
                        <numeric:DecimalUpDown x:Name="DecimalUpDownWordReCluster" Value="0.95" Increment="0.01" Minimum="0.10" Maximum="1"
                                            ToolTip="Merge families whose description similarity meets this threshold. The default 0.95 merges near-identical wording; lower values allow more joins."/>
                        <Label Content="Ignore words" ToolTip="Words removed from descriptions before comparing their similarity."/>
                        <TextBox x:Name="TextBoxWordsToBeExcluded"
                                 ToolTip="Whole words ignored when comparing descriptions, separated by commas or spaces. Keyword review also uses these ignored words."/>
                        <Button x:Name="ButtonWordCluster" Content="Recluster by words" Click="ButtonWordCluster_Click"
                                ToolTip="Merge unlocked families using the chosen description similarity. The search limits its scope; Undo reverses the grouping."/>
                    </StackPanel>
                </Expander>
                <Expander x:Name="SelectedProteinActions" Header="Edit selected proteins" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <Label Content="Family number" ToolTip="The family number to give every selected protein."/>
                        <TextBox x:Name="TextBoxBatchUserId"
                                 ToolTip="Give selected proteins this family number, or leave it empty to keep their numbers. Joining and surviving source families are locked."/>
                        <Label Content="Annotation" ToolTip="The annotation to write to every selected protein."/>
                        <TextBox x:Name="TextBoxBatchAnnotation"
                                 ToolTip="Annotate the selected proteins, or leave this empty to keep their annotations. The text is saved and exported with the file."/>
                        <Button x:Name="ButtonApplyToSelected" Content="Apply to selected rows" Click="ButtonApplyToSelected_Click"
                                ToolTip="Apply the family number and annotation to selected proteins. Select with Ctrl+click, Shift+click or Ctrl+A; Undo reverses the change."/>
                        <TextBlock x:Name="TextBlockBatchStatus" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                                   ToolTip="The result of the last selected-protein edit, or the reason nothing changed."/>
                    </StackPanel>
                </Expander>
                <StackPanel Margin="4,0,4,10">
                    <Label x:Name="LabelLockCount" ToolTip="Families protected from automatic grouping, including stored locks whose family has no proteins. Manage locks lets you remove that protection."/>
                    <WrapPanel>
                        <Button x:Name="ButtonManageLocks" Content="Manage locks" Click="ButtonManageLocks_Click"
                                ToolTip="Review or remove locks on curated family numbers. A removal is one reversible Undo step."/>
                        <Button x:Name="ButtonUndo" Content="Undo" Click="ButtonUndo_Click" IsEnabled="False"
                                ToolTip="Undoes the last curation change, such as a grouping, family number edit or lock removal, up to 50 steps in this session. Disabled until there is a change to undo."/>
                    </WrapPanel>
                </StackPanel>
                <local:CurationQuantitationPanel x:Name="QuantitationPanel"
                    LoadRequested="ButtonLoadQuantData_Click" RecalculateRequested="ButtonRecalculateQuantitation_Click"
                    ChoiceChanged="ComboBoxNormalization_SelectionChanged" BasisChanged="ComboBoxFullXicBasis_SelectionChanged"/>
                <Expander Header="Display and export" Margin="0,10,0,0">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="CheckBoxExcludeReverse" Content="Hide decoys" IsChecked="True"
                                  Checked="CheckBoxExcludeReverse_CheckedChanged" Unchecked="CheckBoxExcludeReverse_CheckedChanged"
                                  ToolTip="Hide decoys from the tables and visible-row CSV. This starts on and never deletes proteins or changes percentages."/>
                        <CheckBox x:Name="CheckBoxExcludeContaminants" Content="Hide contaminants"
                                  Checked="CheckBoxShowXICOnly_CheckedChanged" Unchecked="CheckBoxShowXICOnly_CheckedChanged"
                                  ToolTip="{x:Static core:IdentifierText.HideContaminantsToolTip}"/>
                        <CheckBox x:Name="CheckBoxShowXICOnly" Content="Show quantified families only"
                                  Checked="CheckBoxShowXICOnly_CheckedChanged" Unchecked="CheckBoxShowXICOnly_CheckedChanged"
                                  ToolTip="Hide families whose PatternLab share is zero. Display filtering never changes percentages or the saved proteins."/>
                        <CheckBox x:Name="CheckBoxShowSearchIds" Content="Show USearch ID"
                                  Checked="SearchIdVisibility_Changed" Unchecked="SearchIdVisibility_Changed"
                                  ToolTip="Show the last automatic family number beside the curated number. Hiding this column keeps the stored IDs."/>
                        <Button x:Name="ButtonSaveReport" Content="Export to CSV" Click="ButtonSaveReport_Click"
                                ToolTip="Export exactly the visible protein rows, with invariant decimal fractions. Disabled while every row is hidden by a filter."/>
                        <Button x:Name="ButtonExportComposition" Content="Export family composition" Click="ButtonExportComposition_Click" IsEnabled="False"
                                ToolTip="Export one Full XIC row per family, shared peptides and unattributed peptides. Disabled until full XIC is available."/>
                        <Border x:Name="BadgeExport" Visibility="Collapsed"><TextBlock x:Name="TextBlockExportState"/></Border>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
