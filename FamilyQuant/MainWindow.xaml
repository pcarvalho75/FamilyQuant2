<Window x:Class="FamilyQuant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FamilyQuant"
        mc:Ignorable="d"
        Title="FamilyQuant 2.0" Height="768" Width="1024" MinHeight="600" MinWidth="900">
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Menu x:Name="MainMenu" Grid.Row="0" Background="{DynamicResource SurfaceBrush}">
            <MenuItem x:Name="MenuFile" Header="File" ToolTip="Create, open, save and export your project.">
                <MenuItem x:Name="MenuItemRunUSearch" Header="New from database" Command="New" InputGestureText="Ctrl+N"
                          ToolTip="Builds families from a FASTA or target-decoy database. Save the open project before starting a different database."/>
                <MenuItem x:Name="MenuItemLoadFQC" Header="Open" Command="Open" InputGestureText="Ctrl+O"
                          ToolTip="Opens a FamilyQuant project or an older Family Cluster File. Save your current changes first."/>
                <MenuItem x:Name="MenuItemFamilyPanel" Header="Import family panel" Click="MenuItemFamilyPanel_Click" IsEnabled="False"
                          ToolTip="Import or edit a family panel for the open project."/>
                <Separator/>
                <MenuItem x:Name="MenuItemSaveProject" Header="Save" Command="Save" InputGestureText="Ctrl+S" IsEnabled="False"
                          ToolTip="Saves the open project's families and stored quantitation. Disabled until a project is loaded."/>
                <MenuItem x:Name="MenuItemSaveAs" Header="Save as" Command="SaveAs" InputGestureText="Ctrl+Shift+S" IsEnabled="False"
                          ToolTip="Saves the project under a new name. Disabled until a project is loaded."/>
                <MenuItem x:Name="MenuItemExport" Header="Export" IsEnabled="False"
                          ToolTip="Exports families or tables without replacing the open project. Disabled until a project is loaded.">
                    <MenuItem x:Name="MenuItemSaveFCF" Header="Families for FamilyQuant 1.5 (.fcf)" Click="MenuItemSaveFCF_Click" IsEnabled="False"
                              ToolTip="Exports families, User IDs and annotations for FamilyQuant 1.5, without quantitation. Disabled until a project is loaded."/>
                    <MenuItem x:Name="MenuItemExportFamilyTable" Header="Visible protein table (CSV)" Click="MenuItemExportFamilyTable_Click"
                              ToolTip="Exports the visible protein rows using the table's existing filters and columns. Disabled until a project is loaded."/>
                    <MenuItem x:Name="MenuItemExportPanelAudit" Header="Panel assignment audit (CSV)" Click="MenuItemExportPanelAudit_Click"
                              ToolTip="Exports one row per target protein with panel labels and recorded assignment evidence."/>
                    <MenuItem x:Name="MenuItemExportComposition" Header="Family composition (CSV)" Click="MenuItemExportComposition_Click"
                              ToolTip="Exports the current Full XIC family composition with its existing attribution settings. Disabled until Full XIC is available."/>
                </MenuItem>
                <MenuItem x:Name="MenuItemReportDetails" Header="Report details" Click="MenuItemReportDetails_Click" IsEnabled="False"
                          ToolTip="Edit the study description and written interpretation saved with the project. Disabled until a project is open."/>
                <MenuItem x:Name="MenuItemExportReport" Header="Export report" Click="MenuItemExportReport_Click"
                          ToolTip="Write a Word report from stored Results and selected sections or figures. Compute full XIC first when no Results are stored."/>
                <MenuItem x:Name="MenuItemRecent" Header="Recent projects" SubmenuOpened="MenuItemRecent_SubmenuOpened"
                          ToolTip="Reopens a recent project or Family Cluster File. Missing files remain listed with their paths."/>
                <Separator/>
                <MenuItem Header="Exit" Command="Close" InputGestureText="Alt+F4"
                          ToolTip="Closes this application window. Save the project first to keep your changes."/>
            </MenuItem>
            <MenuItem Header="Edit" ToolTip="Undo curation, copy selected text or find proteins.">
                <MenuItem x:Name="MenuItemUndo" Header="Undo" Command="Undo" InputGestureText="Ctrl+Z"
                          ToolTip="Undoes the last text edit or curation change. Disabled until there is a change to undo."/>
                <MenuItem x:Name="MenuItemCopy" Header="Copy" Command="Copy" InputGestureText="Ctrl+C"
                          ToolTip="Copies selected text or the selected table cells using the table's copy rules. Disabled while nothing is selected."/>
                <Separator/>
                <MenuItem x:Name="MenuItemFind" Header="Find proteins" Command="Find" InputGestureText="Ctrl+F"
                          ToolTip="Focuses the family search box in the open project. Disabled until a project is loaded."/>
            </MenuItem>
            <MenuItem Header="View" SubmenuOpened="MenuView_SubmenuOpened"
                      ToolTip="Navigate between project views and choose the appearance or visible protein rows.">
                <MenuItem x:Name="MenuItemHome" Header="Start page" Click="MenuItemHome_Click"
                          ToolTip="Returns to the start page while keeping your project open. Its actions use these same menu commands."/>
                <MenuItem x:Name="MenuItemFamilies" Header="Families" Click="MenuItemFamilies_Click"
                          ToolTip="Returns to the current family table, or opens a project when none is loaded. Existing curation stays in memory."/>
                <Separator/>
                <MenuItem Header="Appearance" ToolTip="Choose light or dark surfaces without changing the project or its numbers.">
                    <MenuItem x:Name="MenuThemeDark" Header="Dark" IsCheckable="True" IsChecked="True" Click="MenuThemeDark_Click"
                              ToolTip="Uses dark surfaces and light text. This is the default application appearance."/>
                    <MenuItem x:Name="MenuThemeLight" Header="Light" IsCheckable="True" Click="MenuThemeLight_Click"
                              ToolTip="Uses light surfaces and dark text. Every command and value stays the same."/>
                    <MenuItem x:Name="MenuThemeSystem" Header="Use Windows setting" IsCheckable="True" Click="MenuThemeSystem_Click"
                              ToolTip="Follows the light or dark app setting in Windows. The appearance updates when Windows changes."/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="MenuItemHideDecoys" Header="Hide decoys" IsCheckable="True" Click="MenuItemHideDecoys_Click"
                          ToolTip="Hides decoy rows in the family table and its CSV without changing percentages. Disabled until a project is loaded."/>
                <MenuItem x:Name="MenuItemHideContaminants" Header="Hide contaminants" IsCheckable="True" Click="MenuItemHideContaminants_Click"
                          ToolTip="Hides contaminant rows in the family table and its CSV without changing percentages. Disabled until a project is loaded."/>
            </MenuItem>
            <MenuItem Header="Analysis" SubmenuOpened="MenuAnalysis_SubmenuOpened" ToolTip="Compute quantitation, inspect results or review de novo evidence.">
                <MenuItem x:Name="MenuItemComputeXic" Header="Compute full XIC" Click="MenuItemComputeXic_Click" IsEnabled="False"
                          ToolTip="Measures identified and kept de novo precursors from RAW files with the full isotope envelope. Disabled until a project is loaded."/>
                <MenuItem x:Name="MenuItemAnalytics" Header="Results" Click="MenuItemAnalytics_Click"
                          ToolTip="Shows the project's stored quantitation and its exports. Compute full XIC first when no results are stored."/>
                <MenuItem x:Name="MenuItemDeNovo" Header="De novo evidence" Click="MenuItemDeNovo_Click"
                          ToolTip="Imports, filters and compares PEAKS or DeepNovo evidence with PatternLab. It changes no family or quantitation."/>
                <MenuItem x:Name="MenuItemSpectrumComparison" Header="Spectrum comparison" Click="MenuItemSpectrumComparison_Click" IsEnabled="False"
                          ToolTip="Shows the source comparison table and its existing CSV and score plot exports. Disabled until spectrum evidence is loaded."/>
                <MenuItem x:Name="MenuItemClusteringDiagnostic" Header="Clustering diagnostic" Click="MenuItemClusteringDiagnostic_Click" IsEnabled="False"
                          ToolTip="Writes a diagnostic report from the saved .fcf or .fqproj using its clustering identity. Save changes first; families stay as they are."/>
                <Separator/>
                <MenuItem x:Name="MenuItemReanotateSEPro" Header="Reannotate SEPro" Click="MenuItemReanotateSEPro_Click" IsEnabled="False"
                          ToolTip="Writes family numbers to a new regrouped SEPro package, leaving the original unchanged. Disabled until a project is loaded."/>
            </MenuItem>
            <MenuItem x:Name="MenuItemHelp" Header="Help" ToolTip="Read the current screen's explanations or the complete workflow.">
                <MenuItem x:Name="MenuItemHowToRead" Header="How to read these numbers" Command="Help" InputGestureText="F1"
                          ToolTip="Explains the current screen's numbers and choices, including denominators and shared peptides. F1 opens this same help."/>
                <MenuItem x:Name="MenuItemWhereAmI" Header="What do I do first?" Click="MenuItemWhereAmI_Click"
                          ToolTip="Lists the complete workflow and what each step needs. De novo review is optional."/>
                <MenuItem x:Name="MenuItemCheckForUpdates" Header="Check for updates" Click="MenuItemCheckForUpdates_Click"
                          ToolTip="Asks GitHub for the latest public release, only when you choose it. A newer version opens its release page on request; nothing is installed."/>
            </MenuItem>
        </Menu>
        <!-- The first thing a new user sees. It says what to do, in order, and it stays until a Family
             Cluster File is opened - the sequence used to be discoverable only by trying every menu. -->
        <Border x:Name="BorderGuide" Grid.Row="2" Background="{DynamicResource SubtleBrush}"
                Padding="12,8">
            <TextBlock x:Name="TextBlockGuide" Text="{Binding Text}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                       ToolTip="Shows the current view, project and operation in one line. Help contains the workflow and full status details."/>
        </Border>
        <!-- The task-oriented home screen is swapped in here by the constructor and is the default view.
             The other four views (clustering, curation, de novo, analytics) replace it in turn, and Home
             on the menu brings it back. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <local:ShellNavigationRail x:Name="NavigationRail"/>
            <Grid x:Name="GridApp" Grid.Column="1" Background="{DynamicResource CanvasBrush}"/>
        </Grid>
        <local:BusyOverlay x:Name="ShellBusyOverlay" Grid.RowSpan="3" Panel.ZIndex="100"/>
    </Grid>
</Window>
