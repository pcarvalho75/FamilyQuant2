<Window x:Class="FamilyQuant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FamilyQuant"
        mc:Ignorable="d"
        Title="FamilyQuant" Height="768" Width="1024" MinHeight="600" MinWidth="900">
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Menu x:Name="MainMenu" Grid.Row="0" Background="{DynamicResource SurfaceBrush}">
            <MenuItem x:Name="MenuFile" Header="File" ToolTip="Offers commands to replace, save or export the open project. Opening this menu changes nothing.">
                <MenuItem x:Name="MenuItemRunUSearch" Header="Build families" Command="New" InputGestureText="Ctrl+N"
                          ToolTip="Opens Build families to group a FASTA or target-decoy database by sequence identity. Save, Discard or Cancel protects changes before replacing the open project."/>
                <MenuItem x:Name="MenuItemUpdateDatabase" Header="Update database" Click="MenuItemUpdateDatabase_Click" IsEnabled="{Binding IsEnabled, ElementName=MenuItemFamilyPanel}" ToolTip="Previews changes from a newer FASTA made the same way before updating the open project. Open a project and finish the current operation first; applying an update starts a new curation Undo history."/>
                <MenuItem x:Name="MenuItemLoadFQC" Header="Open" Command="Open" InputGestureText="Ctrl+O"
                          ToolTip="Reads a .fqproj with stored results or an older .fcf with families only. Save, Discard or Cancel protects changes before replacing the open project."/>
                <MenuItem x:Name="MenuItemFamilyPanel" Header="Import family list" Click="MenuItemFamilyPanel_Click" IsEnabled="False"
                          ToolTip="Opens the family-list import wizard, where you can also edit the current panel. Open a project and finish the current operation first; a confirmed import is one undoable project change."/>
                <MenuItem x:Name="MenuItemFamilyListTemplate" Header="Save family list template" Click="MenuSaveFamilyListTemplate_Click"
                          ToolTip="Writes an Excel workbook with family-list columns and instructions to a location you choose. This file can be edited for import; Undo does not revert file writes."/>
                <Separator/>
                <MenuItem x:Name="MenuItemSaveProject" Header="Save" Command="Save" InputGestureText="Ctrl+S" IsEnabled="False"
                          ToolTip="Writes the open families, panel, report details and stored results to a .fqproj file. Open a project and finish any save first; Undo does not revert files on disk."/>
                <MenuItem x:Name="MenuItemSaveAs" Header="Save as" Command="SaveAs" InputGestureText="Ctrl+Shift+S" IsEnabled="False"
                          ToolTip="Writes the open project to a .fqproj file at a location you choose and makes it the current save path. Open a project and finish any save first; Undo does not revert files on disk."/>
                <MenuItem x:Name="MenuItemExport" Header="Export" IsEnabled="False"
                          ToolTip="Offers separate files for families, tables and interpretation input. Open a project to enable the menu; choosing an export leaves the project open.">
                    <MenuItem x:Name="MenuItemSaveFCF" Header="Families for FamilyQuant 1.5 (.fcf)" Click="MenuItemSaveFCF_Click" IsEnabled="False"
                              ToolTip="Writes families, User IDs and annotations to a separate .fcf for FamilyQuant 1.5 without stored quantitation. Open a project first; this export does not save the .fqproj or clear unsaved changes."/>
                    <MenuItem x:Name="MenuItemExportFamilyTable" Header="Visible protein table (CSV)" Click="MenuItemExportFamilyTable_Click"
                              ToolTip="Writes the protein table to CSV using its current display filters and columns. Open a project and show at least one row to enable it; Undo does not revert the exported file."/>
                    <MenuItem x:Name="MenuItemExportPanelAudit" Header="Panel assignment audit (CSV)" Click="MenuItemExportPanelAudit_Click"
                              ToolTip="Writes one CSV row per target protein with its panel labels and recorded assignment evidence. The project stays unchanged; Undo does not revert the exported file."/>
                    <MenuItem x:Name="MenuItemExportComposition" Header="Family composition (CSV)" Click="MenuItemExportComposition_Click"
                              ToolTip="Writes Full XIC family composition, shared signal and unattributed signal to a CSV file. Run Quantify to enable it; Undo does not revert the exported file."/>
                    <MenuItem x:Name="MenuItemExportInterpretationInput" Header="Interpretation input (Markdown)" Click="MenuItemExportInterpretationInput_Click"
                              ToolTip="Writes stored Results, panel and report details to a Markdown file for an assistant you choose. Requires Results; Undo does not revert the file."/>
                </MenuItem>
                <MenuItem x:Name="MenuItemReportDetails" Header="Report details" Click="MenuItemReportDetails_Click" IsEnabled="False"
                          ToolTip="Opens study details and written interpretation for editing in the project. Open a project and finish the current operation first; Undo restores saved detail edits."/>
                <MenuItem x:Name="MenuItemExportReport" Header="Export report" Click="MenuItemExportReport_Click"
                          ToolTip="Opens report choices for writing a Word report, supplement workbook and offline HTML report from stored Results. Export writes files; Undo does not revert them."/>
                <MenuItem x:Name="MenuItemAiDraft" Header="Draft interpretation with AI..." Click="MenuItemAiDraft_Click"
                          ToolTip="Previews project information before you approve sending it to the AI service for a draft. Accepting a reviewed draft changes the written interpretation; Undo restores the previous text."/>
                <MenuItem x:Name="MenuItemRecent" Header="Recent projects" SubmenuOpened="MenuItemRecent_SubmenuOpened"
                          ToolTip="Lists saved project paths that are still available so you can reopen one. Opening the menu changes nothing; removing an entry keeps its file on disk."/>
                <MenuItem x:Name="MenuItemCloseProject" Header="Close project" Click="MenuItemCloseProject_Click" IsEnabled="False"
                          ToolTip="Closes the open project and returns to Home after Save, Discard or Cancel. Open a project and finish the current operation to enable it; discarded edits cannot be undone."/>
                <Separator/>
                <MenuItem Header="Exit" Command="Close" InputGestureText="Alt+F4"
                          ToolTip="Closes FamilyQuant after offering Save, Discard or Cancel for unsaved project changes. Finish any save first; discarded edits cannot be undone."/>
            </MenuItem>
            <MenuItem Header="Edit" ToolTip="Offers Undo for curation, table copying and protein search. Opening this menu changes nothing.">
                <MenuItem x:Name="MenuItemUndo" Header="Undo" Command="Undo" InputGestureText="Ctrl+Z"
                          ToolTip="Restores the previous curation change in the open project, up to 50 steps in this session. Make a curation edit to enable it; files already written stay as saved."/>
                <MenuItem x:Name="MenuItemCopy" Header="Copy" Command="Copy" InputGestureText="Ctrl+C"
                          ToolTip="Copies selected table cells to the clipboard using that table's copy rules. Select table rows to enable it; the project and files stay unchanged."/>
                <Separator/>
                <MenuItem x:Name="MenuItemFind" Header="Find proteins" Command="Find" InputGestureText="Ctrl+F"
                          ToolTip="Returns to Curate families and selects the protein search box for typing. Open a project to enable it; finding proteins changes only the displayed rows."/>
            </MenuItem>
            <MenuItem x:Name="MenuView" Header="View" SubmenuOpened="MenuView_SubmenuOpened"
                      ToolTip="Offers the workflow screens, appearance preferences and protein display filters. Opening this menu changes nothing.">
                <MenuItem x:Name="MenuItemHome" Header="Home" Click="MenuItemHome_Click" InputGestureText="Alt+0"
                          ToolTip="Returns to Home and its five steps while keeping the open project and unsaved edits. Keyboard shortcut: Alt+0."/>
                <MenuItem x:Name="MenuItemFamilies" Header="Curate families" Click="MenuItemFamilies_Click" InputGestureText="Alt+2"
                          ToolTip="Shows the open families for curation, or offers Open project and Build families if none is open. Opening this screen makes no curation edit."/>
                <MenuItem x:Name="MenuItemComputeXic" Header="Quantify" Click="MenuItemComputeXic_Click" IsEnabled="False" InputGestureText="Alt+3"
                          ToolTip="Opens Quantify to choose identification packages and RAW files before computing Full XIC. Open a project and return to Home or Curate families to enable it; opening the screen computes nothing."/>
                <MenuItem x:Name="MenuItemAnalytics" Header="Results" Click="MenuItemAnalytics_Click" InputGestureText="Alt+4"
                          ToolTip="Shows figures and tables from stored quantitation or completed homology results. Open a project or complete a homology search and finish the current operation to enable it; opening Results does not regroup families."/>
                <MenuItem x:Name="MenuItemDeNovo" Header="De novo review" Click="MenuItemDeNovo_Click" InputGestureText="Alt+5"
                          ToolTip="Opens the optional review of de novo calls against identification evidence. Opening the screen changes no families or stored quantitation."/>
                <Separator/>
                <MenuItem Header="Appearance" ToolTip="Offers application appearance presets and the option to follow Windows. Choosing one saves a preference without changing the project or its results.">
                    <MenuItem x:Name="MenuThemeDark" Header="Dark" IsCheckable="True" IsChecked="True" Click="MenuThemeDark_Click"
                              ToolTip="Uses the default application appearance for reduced screen brightness. Saves this preference without changing the project or its results."/>
                    <MenuItem x:Name="MenuThemeLight" Header="Light" IsCheckable="True" Click="MenuThemeLight_Click"
                              ToolTip="Uses the application appearance intended for brighter surroundings. Saves this preference without changing the project or its results."/>
                    <MenuItem x:Name="MenuThemeSystem" Header="Use Windows setting" IsCheckable="True" Click="MenuThemeSystem_Click"
                              ToolTip="Follows the Windows application appearance and updates when that setting changes. Saves this preference without changing the project or its results."/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="MenuItemHideDecoys" Header="Hide decoys" IsCheckable="True" Click="MenuItemHideDecoys_Click"
                          ToolTip="Hides decoy proteins from the family tables and visible-row CSV. Open a project to enable it; stored proteins and percentages stay unchanged."/>
                <MenuItem x:Name="MenuItemHideContaminants" Header="Hide contaminants" IsCheckable="True" Click="MenuItemHideContaminants_Click"
                          ToolTip="Hides proteins carrying the database contaminant prefix from the family tables and visible-row CSV. Open a project to enable it; stored proteins and percentages stay unchanged."/>
            </MenuItem>
            <MenuItem x:Name="MenuTools" Header="Tools" SubmenuOpened="MenuAnalysis_SubmenuOpened" ToolTip="Offers spectrum comparison, a saved-file clustering diagnostic and SEPro reannotation. Opening this menu changes nothing.">
                <MenuItem x:Name="MenuItemSpectrumComparison" Header="Spectrum comparison" Click="MenuItemSpectrumComparison_Click" IsEnabled="False"
                          ToolTip="Opens the stored spectrum comparison table with CSV and score-plot exports. Load spectrum evidence or run Quantify to enable it; opening the table changes no families."/>
                <MenuItem x:Name="MenuItemClusteringDiagnostic" Header="Clustering diagnostic" Click="MenuItemClusteringDiagnostic_Click" IsEnabled="False"
                          ToolTip="Writes a diagnostic report from the saved .fcf or .fqproj using its clustering identity; families stay as they are. Save changes first and finish the current operation to enable it; Undo does not revert report files."/>
                <Separator/>
                <MenuItem x:Name="MenuItemReanotateSEPro" Header="Reannotate SEPro" Click="MenuItemReanotateSEPro_Click" IsEnabled="False"
                          ToolTip="Writes current User ID family numbers to a new regrouped SEPro package and keeps the original package. Open a project in Home or Curate families to enable it; Undo does not revert the new file."/>
            </MenuItem>
            <MenuItem x:Name="MenuItemHelp" Header="Help" ToolTip="Offers explanations of the workflow and current screen, update commands and AI key settings. Opening this menu changes nothing.">
                <MenuItem x:Name="MenuItemAiKey" Header="AI assistant key..." Click="MenuItemAiKey_Click"
                          ToolTip="Opens settings to add, test, import or remove your private AI service key for this Windows user. The key is kept outside the project; changes here are not part of project Undo."/>
                <MenuItem x:Name="MenuItemHowToRead" Header="How to read these numbers" Command="Help" InputGestureText="F1"
                          ToolTip="Explains the current screen's numbers, denominators and choices. F1 opens the same read-only Help without changing the project."/>
                <MenuItem x:Name="MenuItemDeNovoWorkflowHelp" Header="De novo in FamilyQuant" Click="MenuItemDeNovoWorkflowHelp_Click"
                          ToolTip="Explains how identification and de novo evidence lead to Quantify and Results. This read-only Help changes nothing in the project."/>
                <MenuItem x:Name="MenuItemWhereAmI" Header="What do I do first?" Click="MenuItemWhereAmI_Click"
                          ToolTip="Explains the five workflow steps, their inputs and what to do next. This read-only Help changes nothing in the project."/>
                <MenuItem x:Name="MenuItemCheckForUpdates" Header="Check for updates" Click="MenuItemCheckForUpdates_Click"
                          ToolTip="Asks GitHub whether a newer public release is available. The result offers release-page and installation choices without changing the project."/>
                <MenuItem x:Name="MenuItemInstallUpdate" Header="Install update" Click="MenuItemInstallUpdate_Click"
                          ToolTip="Checks for a newer release and downloads its installer after Save, Discard or Cancel protects open edits. FamilyQuant closes to install it; project Undo does not revert installation."/>
                <MenuItem x:Name="MenuItemAutomaticUpdateChecks" Header="Check for updates at startup" IsCheckable="True"
                          Click="MenuItemAutomaticUpdateChecks_Click" ToolTip="Checks for a newer public release at startup and shows an available-update notice. This starts enabled and saves an application preference; installation needs your separate choice."/>
                <Separator/>
                <MenuItem x:Name="MenuItemOpenErrorLogs" Header="Open error logs folder" Click="MenuItemOpenErrorLogs_Click"
                          ToolTip="Opens the folder of unexpected-error reports for inspection or sharing with the developers. Opening the folder changes no project data."/>
            </MenuItem>
        </Menu>
        <!-- The first thing a new user sees. It says what to do, in order, and it stays until a Family
             Cluster File is opened - the sequence used to be discoverable only by trying every menu. -->
        <Border x:Name="UpdateAvailableBanner" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource SubtleBrush}" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ButtonInstallAvailableUpdate" Content="Install update" Click="ButtonInstallAvailableUpdate_Click"
                            Style="{DynamicResource PrimaryButton}" Margin="12,0,8,0" ToolTip="Downloads this release's installer after Save, Discard or Cancel protects open edits. FamilyQuant closes to install it; project Undo does not revert installation."/>
                    <Button x:Name="ButtonOpenAvailableRelease" Content="Open release page" Click="ButtonOpenAvailableRelease_Click"
                            Margin="0,0,8,0" ToolTip="Opens this release's notes and downloads page in your browser. The project stays unchanged."/>
                    <Button Content="Dismiss" x:Name="ButtonDismissUpdate" Click="ButtonDismissUpdate_Click"
                            ToolTip="Hides this update notice until the next startup or manual update check. The project and startup-check preference stay unchanged."/>
                </StackPanel>
                <TextBlock x:Name="TextUpdateAvailable" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
        <Border x:Name="BorderGuide" Grid.Row="3" Background="{DynamicResource SubtleBrush}"
                Padding="12,8">
            <TextBlock x:Name="TextBlockGuide" Text="{Binding Text}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                       ToolTip="Shows the current view, project and operation in one line. Help contains the workflow and full status details."/>
        </Border>
        <!-- The task-oriented home screen is swapped in here by the constructor and is the default view.
             The other four views (clustering, curation, de novo, analytics) replace it in turn, and Home
             on the menu brings it back. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <local:ShellNavigationRail x:Name="NavigationRail"/>
            <Grid x:Name="GridApp" Grid.Column="1" Background="{DynamicResource CanvasBrush}"/>
        </Grid>
        <local:BusyOverlay x:Name="ShellBusyOverlay" Grid.RowSpan="4" Panel.ZIndex="100"/>
    </Grid>
</Window>
