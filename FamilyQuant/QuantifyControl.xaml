<UserControl x:Class="FamilyQuant.QuantifyControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:FamilyQuant" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
 Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="24" MaxWidth="1100" HorizontalAlignment="Stretch">
   <TextBlock Text="Quantify" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold"/>
   <TextBlock Text="Measure the full isotope envelope from matched RAW acquisitions." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,18"/>
   <Border Background="{DynamicResource SurfaceBrush}" Padding="16" CornerRadius="6">
    <Grid IsEnabled="{Binding CanEdit}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Label Content="RAW folder" ToolTip="Acquisition folder whose file names are matched to the identified runs."/>
     <TextBox x:Name="TextBoxRawDirectory" Grid.Column="1" Text="{Binding RawDirectory, UpdateSourceTrigger=PropertyChanged}"
      ToolTip="Folder containing the RAW acquisitions. Runs are matched by file name."/>
     <Button Grid.Column="2" Content="Browse..." Click="BrowseRaw" ToolTip="Choose the folder containing the RAW acquisitions."/>
     <Label Grid.Row="1" Content="Identifications (.sepr2)" ToolTip="Trusted SEPro package containing the identifications from these RAW acquisitions."/>
     <TextBox x:Name="TextBoxSeproPackage" Grid.Row="1" Grid.Column="1" Text="{Binding SeproPackage, UpdateSourceTrigger=PropertyChanged}"
      ToolTip="SEPro identification package from the same runs as the RAW acquisitions."/>
     <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="BrowseSepro" ToolTip="Choose the SEPro identification package for these RAW acquisitions."/>
     <Label Grid.Row="2" Content="De novo folder (optional)" ToolTip="Export root searched recursively for the selected de novo sources."/>
     <TextBox x:Name="TextBoxDeNovoDirectory" Grid.Row="2" Grid.Column="1" Text="{Binding DeNovoDirectory, UpdateSourceTrigger=PropertyChanged}"
      ToolTip="Export root searched recursively for the selected sources. Leave empty for identified peptides only."/>
     <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="BrowseDeNovo" ToolTip="Choose the de novo export root."/>
     <local:DeNovoFilterControl x:Name="FilterControl" Grid.Row="3" Grid.ColumnSpan="3" DataContext="{Binding Filters}" Margin="0,12,0,12"/>
     <WrapPanel Grid.Row="4" Grid.ColumnSpan="3">
      <Label Content="Isotope ceiling" ToolTip="Maximum credited isotopes per peptide, including the monoisotopic peak."/><xctk:IntegerUpDown x:Name="IntegerUpDownIsotopes" Margin="{DynamicResource ControlPadding}" Width="70" Minimum="1" Maximum="6" Value="{Binding IsotopeCeiling, Mode=TwoWay}"
       ToolTip="Maximum isotopes per peptide, 1 to 6. An absent isotope adds nothing. Default 6."/>
      <Label Content="Minimum points per peak" ToolTip="Required array points per isotope peak, including the two padding points." Margin="20,0,0,0"/><xctk:IntegerUpDown x:Name="IntegerUpDownMinPoints" Margin="{DynamicResource ControlPadding}" Width="70" Minimum="1" Maximum="20" Value="{Binding MinimumPoints, Mode=TwoWay}"
       ToolTip="Points per isotope peak, including two padding points. Default 3. A value of 1 restores the legacy height rule."/>
     </WrapPanel>
    </Grid>
   </Border>
   <TextBlock Text="{Binding Basis}" ToolTip="{Binding BasisDetails}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,8"/>
   <StackPanel Orientation="Horizontal">
    <Button x:Name="ButtonCompute" Content="Compute full XIC" Style="{DynamicResource PrimaryButton}" Command="{Binding ComputeCommand}"
     ToolTip="Compute identified and selected de novo peptide envelopes. Save the project afterwards to keep the completed result."/>
    <Button Content="Cancel" Command="{Binding CancelCommand}" ToolTip="Cancel at the next operation boundary. The previous project results remain available."/>
    <Button x:Name="ButtonViewSpectrumComparison" Content="Spectrum table" Click="ViewSpectrum" IsEnabled="{Binding Computed}"
     ToolTip="Inspect or export the spectrum comparison table from the completed computation."/>
   </StackPanel>
   <TextBlock x:Name="TextBlockStatus" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,12"/>
   <Border Background="{DynamicResource SurfaceBrush}" Padding="16" CornerRadius="6">
    <StackPanel>
     <TextBlock Text="Run summary" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding RunSummary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
     <Expander Header="Per-run shares and computation details" Margin="0,10,0,0" ToolTip="Every per-run result, source cutoff, diagnostic note and export warning from the engine.">
      <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Margin="0,8,0,0"
       ToolTip="Read-only computation details. Select text to copy it."/>
     </Expander>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
