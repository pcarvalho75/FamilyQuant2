<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FamilyQuant"
                    xmlns:theme="clr-namespace:FamilyQuant.Themes"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Inherit the built-in Fluent templates. These styles supply only app typography and roles. -->
    <Style TargetType="local:NumericUpDown">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:NumericUpDown">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="PART_Text" MinWidth="30" Padding="4,2" VerticalContentAlignment="Center"
                                 ToolTip="{TemplateBinding ToolTip}" IsEnabled="{TemplateBinding IsEnabled}"/>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <RepeatButton x:Name="PART_Up" Focusable="False" Padding="0" Margin="0" FontSize="8"
                                          FontFamily="Segoe Fluent Icons" Content="&#xE70E;"
                                          Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                                          ToolTip="Increase this value by one configured step."/>
                            <RepeatButton x:Name="PART_Down" Grid.Row="1" Focusable="False" Padding="0" Margin="0" FontSize="8"
                                          FontFamily="Segoe Fluent Icons" Content="&#xE70D;"
                                          Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                                          ToolTip="Decrease this value by one configured step."/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:DecimalUpDown" BasedOn="{StaticResource {x:Type local:NumericUpDown}}"/>
    <Style TargetType="local:IntegerUpDown" BasedOn="{StaticResource {x:Type local:NumericUpDown}}"/>
    <Style TargetType="Window">
        <Setter Property="Icon" Value="{DynamicResource AppWindowIcon}"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource CaptionSize}"/>
        <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource BodySize}"/>
        <Setter Property="Padding" Value="{DynamicResource ControlPadding}"/>
        <Setter Property="Margin" Value="{DynamicResource ControlMargin}"/>
        <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource BodySize}"/>
        <Setter Property="Padding" Value="{DynamicResource ControlPadding}"/>
        <Setter Property="Margin" Value="{DynamicResource ControlMargin}"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource BodySize}"/>
        <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="FontSize" Value="{DynamicResource CaptionSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
    </Style>
    <Style TargetType="MenuItem" BasedOn="{StaticResource DefaultMenuItemStyle}">
    </Style>
    <Style TargetType="GroupBox" BasedOn="{StaticResource DefaultGroupBoxStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="{DynamicResource SectionPadding}"/>
        <Setter Property="FontSize" Value="{DynamicResource CaptionSize}"/>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <ContentControl Content="{Binding}" FontSize="{DynamicResource SectionSize}"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type GroupBox}}}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource DefaultDataGridStyle}">
        <Setter Property="theme:TableAppearance.Enabled" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleBrush}"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
        <Setter Property="FontSize" Value="{DynamicResource CaptionSize}"/>
        <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Padding" Value="{DynamicResource TableHeaderPadding}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
        <Setter Property="Padding" Value="{DynamicResource TableCellPadding}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
        </Style.Triggers>
    </Style>
    <!-- Design rule 7 (docs/TOOLTIPS.md): every tooltip wraps at one width on theme tokens; timing is in ToolTipDefaults. -->
    <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}">
        <Setter Property="MaxWidth" Value="{x:Static theme:ToolTipDefaults.MaximumWidth}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource CaptionSize}"/>
        <Style.Resources>
            <DataTemplate DataType="{x:Type sys:String}">
                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
            </DataTemplate>
        </Style.Resources>
    </Style>
</ResourceDictionary>
