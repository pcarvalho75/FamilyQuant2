<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- All application colour values belong here. Light is the provisional default. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E9E9E9"/>
    <SolidColorBrush x:Key="EdgeBrush" Color="#D1D1D1"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="#777777"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#DCEBFA"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#9D3C00"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000"/>
    <SolidColorBrush x:Key="ClearBrush" Color="#00000000"/>
    <!-- Unrebuilt views retain their original surface family until their replacement is ready. -->
    <SolidColorBrush x:Key="PanelDarkBrush" Color="#333949"/>
    <SolidColorBrush x:Key="PanelMidBrush" Color="#444B58"/>
    <SolidColorBrush x:Key="PanelLightBrush" Color="#555C68"/>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B9C0CC"/>
    <!-- Pin the Fluent accent family so an OS accent cannot introduce yellow focus or selection. -->
    <Color x:Key="SystemAccentColor">#005FB8</Color>
    <Color x:Key="SystemAccentColorLight1">#005FB8</Color>
    <Color x:Key="SystemAccentColorLight2">#005FB8</Color>
    <Color x:Key="SystemAccentColorLight3">#005FB8</Color>
    <Color x:Key="SystemAccentColorDark1">#005FB8</Color>
    <Color x:Key="SystemAccentColorDark2">#005FB8</Color>
    <Color x:Key="SystemAccentColorDark3">#005FB8</Color>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons</FontFamily>
    <sys:Double x:Key="BodySize">13</sys:Double>
    <sys:Double x:Key="CaptionSize">12</sys:Double>
    <sys:Double x:Key="TitleSize">20</sys:Double>
    <sys:Double x:Key="SectionSize">14</sys:Double>
    <Thickness x:Key="ControlPadding">12,6</Thickness>
    <Thickness x:Key="PanelPadding">16</Thickness>
    <Thickness x:Key="PanelMargin">0,0,0,12</Thickness>
    <CornerRadius x:Key="ControlRadius">4</CornerRadius>
    <ResourceDictionary x:Key="DarkTokens">
        <SolidColorBrush x:Key="CanvasBrush" Color="#202020"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#282828"/>
        <SolidColorBrush x:Key="SubtleBrush" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="InputBrush" Color="#333333"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#383838"/>
        <SolidColorBrush x:Key="EdgeBrush" Color="#484848"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#BDBDBD"/>
        <SolidColorBrush x:Key="DisabledBrush" Color="#909090"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
        <SolidColorBrush x:Key="AccentInkBrush" Color="#003E5E"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#154760"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F3A26D"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4"/>
        <SolidColorBrush x:Key="OverlayBrush" Color="#99000000"/>
        <SolidColorBrush x:Key="ClearBrush" Color="#00000000"/>
        <SolidColorBrush x:Key="PanelDarkBrush" Color="#333949"/>
        <SolidColorBrush x:Key="PanelMidBrush" Color="#444B58"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#555C68"/>
        <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B9C0CC"/>
        <Color x:Key="SystemAccentColor">#60CDFF</Color>
        <Color x:Key="SystemAccentColorLight1">#60CDFF</Color>
        <Color x:Key="SystemAccentColorLight2">#60CDFF</Color>
        <Color x:Key="SystemAccentColorLight3">#60CDFF</Color>
        <Color x:Key="SystemAccentColorDark1">#60CDFF</Color>
        <Color x:Key="SystemAccentColorDark2">#60CDFF</Color>
        <Color x:Key="SystemAccentColorDark3">#60CDFF</Color>
    </ResourceDictionary>
</ResourceDictionary>
