<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DrawingGroup x:Key="BrandMarkDrawing">
        <GeometryDrawing Brush="{StaticResource ClearBrush}">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,256,256"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource LogoTileBrush}">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="6,6,244,244" RadiusX="36" RadiusY="36"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource LogoBarBrush}">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="70,62,28,132" RadiusX="14" RadiusY="14"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource LogoMarkBrush}">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="114,62,28,132" RadiusX="14" RadiusY="14"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource LogoBarBrush}">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="158,62,28,132" RadiusX="14" RadiusY="14"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>
    <DrawingImage x:Key="StartPageLogo" Drawing="{StaticResource BrandMarkDrawing}"/>
    <ImageSource x:Key="AppWindowIcon">../Assets/Brand/FamilyQuant.ico</ImageSource>
</ResourceDictionary>
