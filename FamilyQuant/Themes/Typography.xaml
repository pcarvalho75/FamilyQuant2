<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="FluentIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource BodySize}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource BodySize}"/>
        <Setter Property="LineHeight" Value="{DynamicResource BodyLineHeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="{DynamicResource TitleSize}"/>
        <Setter Property="LineHeight" Value="{DynamicResource TitleLineHeight}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="{DynamicResource SectionSize}"/>
        <Setter Property="LineHeight" Value="{DynamicResource SectionLineHeight}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="{DynamicResource CaptionSize}"/>
        <Setter Property="LineHeight" Value="{DynamicResource CaptionLineHeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
</ResourceDictionary>
