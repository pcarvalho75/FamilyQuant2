<Window x:Class="FamilyQuant.PanelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family panel" Width="1080" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Family panel" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Import a spreadsheet or edit the families to include in this project." Style="{StaticResource CaptionText}"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,14,0,10" LastChildFill="False">
            <Button x:Name="ButtonChooseWorkbook" Content="Choose spreadsheet" Click="ChooseWorkbook_Click" DockPanel.Dock="Left"
                    ToolTip="Choose a spreadsheet and map its headers and decisions before applying it."/>
            <TextBlock Text="Panel name" VerticalAlignment="Center" Margin="18,0,6,0" DockPanel.Dock="Left"/>
            <TextBox x:Name="PanelName" Width="230" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" DockPanel.Dock="Left"
                     ToolTip="A name for this family panel, saved with the project."/>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="100"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Families" Style="{StaticResource SectionTitle}"/>
                <DataGrid x:Name="FamilyGrid" Grid.Row="1" Margin="0,6,0,6" ItemsSource="{Binding Families}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" CellEditEnding="FamilyGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridComboBoxColumn x:Name="DecisionColumn" Header="Decision" SelectedValueBinding="{Binding Decision, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label" SelectedValuePath="Value" Width="145"/>
                        <DataGridTextColumn Header="Merge target key" Binding="{Binding MergeTarget, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        <DataGridTextColumn Header="Pfam codes" Binding="{Binding Pfam, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        <DataGridTextColumn Header="Subclass keys" Binding="{Binding Subclasses, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Content="Add family" Click="AddFamily_Click" ToolTip="Adds an empty family row."/>
                    <Button Content="Remove selected" Click="RemoveFamily_Click" Margin="8,0,0,0" ToolTip="Removes the selected family from this draft."/>
                    <Button Content="Save panel as spreadsheet" Click="SaveTemplate_Click" Margin="8,0,0,0" ToolTip="Writes a reusable spreadsheet from this panel draft."/>
                </StackPanel>
                <TextBlock Grid.Row="3" Text="Map spreadsheet decisions" Style="{StaticResource SectionTitle}" Margin="0,10,0,4"/>
                <DataGrid x:Name="MappingGrid" Grid.Row="4" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Source decision" Binding="{Binding Source}" IsReadOnly="True" Width="*"/>
                        <DataGridComboBoxColumn x:Name="MappingDecisionColumn" Header="Decision" SelectedValueBinding="{Binding Decision}" DisplayMemberPath="Label" SelectedValuePath="Value" Width="180"/>
                        <DataGridTextColumn Header="Merge target key" Binding="{Binding MergeTarget, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button x:Name="ButtonPreviewPanel" Grid.Row="5" Content="Preview panel" Click="PreviewPanel_Click" HorizontalAlignment="Left" Margin="0,6,0,0"
                        ToolTip="Build a draft from the selected columns and decision mappings."/>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Spreadsheet import" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="ImportStatus" Grid.Row="1" Text="Choose a spreadsheet to preview its columns and map each decision." TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,6,0,6"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Sheet" VerticalAlignment="Center"/><ComboBox x:Name="SheetChoice" Grid.Column="1" Height="28" Margin="0,0,0,2" ToolTip="Choose the sheet containing the family table."/>
                    <TextBlock Grid.Row="1" Text="Header row" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="HeaderRow" Text="1" Width="42" Height="28" Margin="0,0,5,2" ToolTip="The row number containing the column names."/><Button Content="Preview columns" Height="28" Click="PreviewColumns_Click" ToolTip="Read the chosen sheet and header row."/></StackPanel>
                    <TextBlock Grid.Row="2" Text="Family key" VerticalAlignment="Center"/><ComboBox x:Name="KeyColumn" Grid.Row="2" Grid.Column="1" Height="28" Margin="0,0,0,2"/>
                    <TextBlock Grid.Row="3" Text="Family name" VerticalAlignment="Center"/><ComboBox x:Name="NameColumn" Grid.Row="3" Grid.Column="1" Height="28" Margin="0,0,0,2"/>
                    <TextBlock Grid.Row="4" Text="Decision" VerticalAlignment="Center"/><ComboBox x:Name="SourceDecisionColumn" Grid.Row="4" Grid.Column="1" Height="28" Margin="0,0,0,2" SelectionChanged="SourceDecisionColumn_SelectionChanged"/>
                    <TextBlock Grid.Row="5" Text="Pfam (optional)" VerticalAlignment="Center"/><ComboBox x:Name="PfamColumn" Grid.Row="5" Grid.Column="1" Height="28" Margin="0,0,0,2"/>
                </Grid>
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Pfam check" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <Button x:Name="ButtonCheckPfam" Content="Check Pfam" Click="CheckPfam_Click" Margin="12,0,0,0" Height="28"
                                ToolTip="Check the panel's accessions and names against the provider without changing the panel."/>
                    </DockPanel>
                    <TextBlock x:Name="PfamStatus" Grid.Row="1" Text="Not checked." TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,4,0,4"/>
                    <DataGrid x:Name="PfamGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ToolTip="{Binding SelectedItem.Reason, RelativeSource={RelativeSource Self}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="*"/>
                            <DataGridTextColumn Header="Pfam" Binding="{Binding Accession}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Reason}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource CaptionText}"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Help" Click="Help_Click" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="ApplyButton" Content="Apply panel" Style="{DynamicResource PrimaryButton}" Click="Apply_Click"
                    ToolTip="Validate and save this panel in the open project. Undo restores the previous panel."/>
        </StackPanel>
    </Grid>
</Window>
