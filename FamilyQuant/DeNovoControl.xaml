<UserControl x:Class="FamilyQuant.DeNovoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:FamilyQuant;assembly=FamilyQuant.Core"
             xmlns:local="clr-namespace:FamilyQuant"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1024" Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="LayerBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LayerBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="LayerTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ResultValue" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="10,4,10,4"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
        <GroupBox x:Name="GroupBoxImportAndFilter" Margin="5" Padding="5">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text=" Step 1: Import and filter" Style="{StaticResource LayerTitle}"/>
                    <Border x:Name="BadgeDeNovoLayer1" Style="{StaticResource LayerBadge}">
                        <TextBlock x:Name="TextBlockDeNovoLayer1State" Style="{StaticResource LayerBadgeText}" Text="READY"/>
                    </Border>
                </StackPanel>
            </GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="De novo export folder:" VerticalAlignment="Center"
                           ToolTip="The folder holding the de novo export. Its sub-folders are searched too, for the files of the source chosen below."/>
                    <TextBox Grid.Column="1" x:Name="TextBoxPeaksDirectory" Text="{Binding ImportDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5" VerticalAlignment="Center" ToolTip="Full path of the export folder, initially empty; any existing folder is accepted, with no numeric unit or range. This prepares the next Load and filter request and writes no file."/>
                    <Button Grid.Column="2" x:Name="ButtonBrowsePeaksDirectory" Content="Browse..."
                            Click="ButtonBrowsePeaksDirectory_Click" Padding="12,5" ToolTip="Choose the export folder and count matching files in its subfolders. This changes the pending path only; Load and filter reads the calls."/>
                </Grid>
                <WrapPanel Grid.Row="1" Margin="5,7,5,0">
                    <Label Content="Source:" VerticalAlignment="Center"
                           ToolTip="Which de novo program made the export. Each keeps its own confidence score: PEAKS uses ALC, DeepNovo uses SCORE."/>
                    <ComboBox x:Name="ComboBoxDeNovoSource" Width="300" Margin="5" SelectedIndex="0"
                              SelectionChanged="ComboBoxDeNovoSource_SelectionChanged" ToolTip="Choose the caller or union for the next import; the initial choice is PEAKS de novo only. Changing source clears this view's previous inspection, but does not change stored project quantities.">
                        <ComboBoxItem Content="PEAKS de novo only (*.denovoOnly.csv)" Tag="peaks-denovo-only" ToolTip="Prepare an import of PEAKS de novo only exports using the native ALC cutoff. This selection changes pending settings, not stored quantities."/>
                        <ComboBoxItem Content="PEAKS de novo all (*.denovo.csv)" Tag="peaks-denovo-all" ToolTip="Prepare an import of PEAKS exports that also include identified spectra, using the native ALC cutoff. This selection changes pending settings, not stored quantities."/>
                        <ComboBoxItem Content="DeepNovo (*.deepnovo.csv)" Tag="deepnovo" ToolTip="Prepare an import of DeepNovo exports using its native SCORE cutoff. SCORE is not converted to PEAKS ALC, and stored quantities stay unchanged."/>
                        <ComboBoxItem Content="PEAKS de novo only + DeepNovo" Tag="union-only-deepnovo" ToolTip="Read both de novo only PEAKS exports and DeepNovo exports with separate native cutoffs on the next import. Selecting the union changes pending settings, not stored quantities."/>
                        <ComboBoxItem Content="PEAKS de novo all + DeepNovo" Tag="union-all-deepnovo" ToolTip="Read both all-call PEAKS exports and DeepNovo exports with separate native cutoffs on the next import. Selecting the union changes pending settings, not stored quantities."/>
                    </ComboBox>
                    <TextBlock x:Name="TextBlockNativeConfidence" Style="{StaticResource Note}" Margin="10,7,0,0"
                               Text="Native confidence: PEAKS ALC (%)"
                               ToolTip="The confidence score that is read and filtered. PEAKS ALC and DeepNovo SCORE are different scales and are not interchangeable."/>
                </WrapPanel>
                <WrapPanel Grid.Row="2" Margin="5,8,5,0">
                    <Label Content="Minimum length:" VerticalAlignment="Center"
                           ToolTip="Shortest de novo sequence kept, in residues; default 7. Short sequences match proteins by chance, so lower it only with a reason."/>
                    <TextBox x:Name="TextBoxMinLength" Text="{Binding Filters.MinimumLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="5" VerticalAlignment="Center" ToolTip="Minimum accepted peptide length in residues: default 7, whole numbers 1 to 100. This prepares the next import and Quantify request; stored quantities change only after Compute."/>
                    <Label x:Name="LabelMinimumSourceConfidence" Content="Minimum ALC (%):" Margin="12,0,0,0" VerticalAlignment="Center"
                           ToolTip="Lowest overall confidence kept, PEAKS ALC or DeepNovo SCORE; default 80%. These scales are not equivalent, and neither is a calibrated FDR."/>
                    <TextBox x:Name="TextBoxMinAlc" Text="{Binding ActiveConfidenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="5" VerticalAlignment="Center" ToolTip="Minimum native confidence in percent: default 80, range 0 to 100, including decimals. This prepares the next request on the selected caller's own scale and does not change stored quantities."/>
                    <Label x:Name="LabelDeepNovoCutoff" Content="DeepNovo SCORE (%):" Visibility="Collapsed" VerticalAlignment="Center"
                           ToolTip="A separate native SCORE cutoff for DeepNovo in a union. It is never converted into PEAKS ALC."/>
                    <TextBox x:Name="TextBoxDeepNovoCutoff" Text="{Binding Filters.DeepNovoMinimumScore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="5" Visibility="Collapsed" ToolTip="Minimum DeepNovo SCORE in percent for a union: default 80, range 0 to 100, including decimals. This prepares the next import and Quantify request without changing stored quantities."/>
                    <Label Content="Stretch length:" Margin="12,0,0,0" VerticalAlignment="Center"
                           ToolTip="Consecutive residues required to reach the stretch floor; default 5. This keeps a sequence with one clearly read region and drops a uniformly mediocre one."/>
                    <TextBox x:Name="TextBoxStretchLength" Text="{Binding Filters.StretchLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="5" VerticalAlignment="Center" ToolTip="Consecutive residues required at or above the local confidence floor: default 5 residues, whole numbers 1 to 100. This prepares the next request without changing stored quantities."/>
                    <Label Content="Stretch floor (%):" Margin="12,0,0,0" VerticalAlignment="Center"
                           ToolTip="Confidence each stretch residue must reach, default 90%. A lower residue breaks the run; keep the floor high."/>
                    <TextBox x:Name="TextBoxStretchFloor" Text="{Binding Filters.StretchFloor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="5" VerticalAlignment="Center" ToolTip="Local confidence floor for every residue in the stretch: default 90 percent, range 0 to 100, rounded to a whole number. This prepares the next request without changing stored quantities."/>
                    <Button x:Name="ButtonLoadAndFilter" Style="{DynamicResource PrimaryButton}" Content="Load and filter" Margin="16,0,0,0" Padding="14,6"
                            Click="ButtonLoadAndFilter_Click" FontSize="13" ToolTip="Read matching exports and replace this view's inspection with calls passing the length, native confidence and stretch filters. No source file or stored project quantity changes; wait for an active operation to finish to edit the view."/>
                </WrapPanel>
                <WrapPanel Grid.Row="3" Margin="5,10,5,0">
                    <Label x:Name="LabelFilesFound" Content="{Binding LabelFilesFound}" Style="{StaticResource ResultValue}"
                           ToolTip="Export files of the chosen source found in the folder and its sub-folders. Zero means the wrong folder or the wrong source."/>
                    <Label x:Name="LabelRowsRead" Content="{Binding LabelRowsRead}" Style="{StaticResource ResultValue}"
                           ToolTip="De novo rows read from the files, before filtering. Truncated lines are skipped."/>
                    <Label x:Name="LabelRowsKept" Content="{Binding LabelRowsKept}" Style="{StaticResource ResultValue}"
                           ToolTip="Rows that passed all three filters, and their share of the rows read. Every later step works from these rows."/>
                </WrapPanel>
                <TextBlock Grid.Row="4" x:Name="TextBlockPerRunBreakdown" Text="{Binding PerRunBreakdown}" Style="{StaticResource Note}"
                           ToolTip="Rows read and kept per run, named by file rather than order. Check a run that keeps far fewer rows than the others."/>
            </Grid>
        </GroupBox>
        <GroupBox x:Name="GroupBoxReconcile" Margin="5" Padding="5">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text=" Step 2: Reconcile and review" Style="{StaticResource LayerTitle}"/>
                    <Border x:Name="BadgeDeNovoLayer2" Style="{StaticResource LayerBadge}">
                        <TextBlock x:Name="TextBlockDeNovoLayer2State" Style="{StaticResource LayerBadgeText}" Text="BLOCKED"/>
                    </Border>
                </StackPanel>
            </GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="SEPro package:" VerticalAlignment="Center"
                           ToolTip="The PatternLab search result (.sepr2) to compare the de novo rows with. It must be the search of the same runs, or every row will look new."/>
                    <TextBox Grid.Column="1" x:Name="TextBoxSeproPackage" Text="{Binding SeproPackage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5" VerticalAlignment="Center" ToolTip="Full path of the trusted .sepr2 package from the same runs, initially empty; choose an existing file, with no numeric unit or range. Reconcile reads it without changing the package or stored quantities."/>
                    <Button Grid.Column="2" x:Name="ButtonBrowseSeproPackage" Content="Browse..." Padding="12,5"
                            Click="ButtonBrowseSeproPackage_Click" ToolTip="Choose the trusted SEPro package for the next reconciliation. This only fills the path; it does not read or change the file."/>
                    <Button Grid.Column="3" x:Name="ButtonReconcile" Style="{DynamicResource PrimaryButton}" Content="Reconcile" Margin="10,4,4,4" Padding="14,6"
                            Click="ButtonReconcile_Click" IsEnabled="False" FontSize="13" ToolTip="Compare imported calls with PatternLab by run name and scan, then by charge and precursor m/z within 20 ppm; stored quantities stay unchanged. Disabled until Load and filter keeps rows, or while an operation is running."/>
                </Grid>
                <WrapPanel Grid.Row="1" Margin="5,10,5,0">
                    <Label x:Name="LabelVerdictDeNovoOnly" Content="{Binding LabelVerdictDeNovoOnly}" Style="{StaticResource ResultValue}"
                           ToolTip="Kept de novo spectra with no PatternLab identification in the same run and scan. This is the new evidence the later steps work on."/>
                    <Label x:Name="LabelVerdictCoIsolated" Content="{Binding LabelVerdictCoIsolated}" Style="{StaticResource ResultValue}"
                           ToolTip="PatternLab identified this scan, but not at the same charge and precursor m/z (within 20 ppm). This may be co-isolation; it is not a sequence disagreement."/>
                    <Label x:Name="LabelVerdictRedundant" Content="{Binding LabelVerdictRedundant}" Style="{StaticResource ResultValue}"
                           ToolTip="Same scan, precursor and sequence as a PatternLab identification, so it adds nothing new. None at all usually means the search is not of the same runs."/>
                    <Label x:Name="LabelVerdictWeakPsm" Content="{Binding LabelVerdictWeakPsm}" Style="{StaticResource ResultValue}"
                           ToolTip="Same sequence as a comparable PatternLab precursor, but its XCorr is below 2.5. This is an inspection verdict and does not change stored quantities."/>
                    <Label x:Name="LabelVerdictConflict" Content="{Binding LabelVerdictConflict}" Style="{StaticResource ResultValue}"
                           ToolTip="Same scan and charge with precursor m/z within 20 ppm, but a different sequence after removing modifications and treating I and L as equivalent. This is an inspection verdict and does not change stored quantities."/>
                </WrapPanel>
                <WrapPanel Grid.Row="2" Margin="5,10,5,0">
                    <Label x:Name="LabelReviewQueueCount" Content="{Binding LabelReviewQueueCount}" Style="{StaticResource ResultValue}"
                           ToolTip="Rows kept for review: alternative sequences plus matches whose PatternLab XCorr is below the threshold."/>
                    <Label x:Name="LabelOverlapScan" Content="{Binding LabelOverlapScan}" Style="{StaticResource ResultValue}"
                           ToolTip="Spectra both programs reported in the same file and scan. This does not yet mean the same precursor, since one scan can hold several."/>
                    <Label x:Name="LabelOverlapPrecursor" Content="{Binding LabelOverlapPrecursor}" Style="{StaticResource ResultValue}"
                           ToolTip="Same file, scan and charge, with precursor m/z within 20 ppm. Sequences are compared only inside this group."/>
                    <Label x:Name="LabelOverlapExact" Content="{Binding LabelOverlapExact}" Style="{StaticResource ResultValue}"
                           ToolTip="Same file, scan and charge, and the same sequence as the best PatternLab match once modifications are removed. I and L count as different here."/>
                    <Label x:Name="LabelOverlapDivergent" Content="{Binding LabelOverlapDivergent}" Style="{StaticResource ResultValue}"
                           ToolTip="Same file, scan and charge, but a different sequence once modifications are removed. The stricter m/z-matched count is shown separately."/>
                    <Button x:Name="ButtonExportSummary" Content=" Export summary CSV" Margin="10,4,4,4" Padding="12,5"
                            Click="ButtonExportSummary_Click" IsEnabled="False" ToolTip="Write a CSV of the recorded verdict counts per run; the project stays unchanged and Undo does not remove the file. Disabled until Reconcile has produced a result."/>
                    <Button x:Name="ButtonExportReviewQueue" Content=" Export review queue CSV" Margin="4" Padding="12,5"
                            Click="ButtonExportReviewQueue_Click" IsEnabled="False" ToolTip="Write both sequences and matching fields from the review queue to a CSV; Undo does not remove this file. Disabled until Reconcile has produced a result, with no change to the project."/>
                    <Button x:Name="ButtonExportOverlapStudy" Content=" Export overlap study CSV" Margin="4" Padding="12,5"
                            Click="ButtonExportOverlapStudy_Click" IsEnabled="False" ToolTip="Write same-scan, comparable-precursor and sequence overlap counts with their denominators to a CSV; Undo does not remove this file. Disabled until Reconcile has produced a result, with no change to the project."/>
                </WrapPanel>
                <DataGrid Grid.Row="3" x:Name="DataGridReviewQueue" ItemsSource="{Binding ReviewQueueItems}" Margin="5,10,5,5" Height="200"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" ToolTip="Inspect comparable-precursor alternative sequences and same-sequence PatternLab matches with XCorr below 2.5. Selecting or sorting these rows changes no stored quantities or source file.">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColumnQueueSource" Header="Source" Width="190" Binding="{Binding Path=Source}"/>
                        <DataGridTextColumn x:Name="ColumnQueueRun" Header="Run" Width="180" Binding="{Binding Path=Run}"/>
                        <DataGridTextColumn x:Name="ColumnQueueScan" Header="Scan" Width="70" Binding="{Binding Path=Scan}"/>
                        <DataGridTextColumn x:Name="ColumnQueueMz" Header="m/z" Width="90" Binding="{Binding Path=DeNovoMz, StringFormat=N4}"/>
                        <DataGridTextColumn x:Name="ColumnQueueCharge" Header="z" Width="40" Binding="{Binding Path=Charge}"/>
                        <DataGridTextColumn x:Name="ColumnQueueDeNovoSequence" Header="De novo sequence" Width="200" Binding="{Binding Path=DeNovoSequence}"/>
                        <DataGridTextColumn x:Name="ColumnQueuePatternLabSequence" Header="PatternLab sequence" Width="200" Binding="{Binding Path=PatternLabSequence}"/>
                        <DataGridTextColumn x:Name="ColumnQueueXCorr" Header="XCorr" Width="70" Binding="{Binding Path=XCorr, StringFormat=N3}"/>
                        <DataGridTextColumn x:Name="ColumnQueueAlc" Header="ALC (%)" Width="70" Binding="{Binding Path=Alc, StringFormat=N1}"/>
                        <DataGridTextColumn x:Name="ColumnQueueMinConfidence" Header="Min residue conf." Width="145" Binding="{Binding Path=MinResidueConfidence}"/>
                        <DataGridTextColumn x:Name="ColumnQueuePpm" Header="ppm apart" Width="110" Binding="{Binding Path=PpmApart, StringFormat=N2}"/>
                        <DataGridTextColumn x:Name="ColumnQueueVerdict" Header="Verdict" Width="*" MinWidth="170" Binding="{Binding Path=VerdictLabel}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
        <Expander x:Name="ExpanderStandalone" Margin="5,6,5,0" IsExpanded="False" ToolTip="Show optional peptide-to-family inspection without full XIC extraction. Expanding changes only this view; use Quantify to compute project quantities.">
            <Expander.Header>
                <TextBlock Text="Standalone homology (advanced)" FontWeight="Bold" TextWrapping="Wrap"/>
            </Expander.Header>
            <StackPanel>
                <TextBlock Style="{StaticResource Note}" Text="Map peptides to a family file; export the snapshot from Results."
     ToolTip="Homology needs peptide sequences and a family file. It does not need extracted areas or an open project."/>
        <GroupBox x:Name="GroupBoxHomology" Margin="5" Padding="5">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text=" Attribute to families" Style="{StaticResource LayerTitle}"/>
                    <Border x:Name="BadgeDeNovoLayer4" Style="{StaticResource LayerBadge}">
                        <TextBlock x:Name="TextBlockDeNovoLayer4State" Style="{StaticResource LayerBadgeText}" Text="BLOCKED"/>
                    </Border>
                </StackPanel>
            </GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Project or family file:" VerticalAlignment="Center"
                           ToolTip="The project or Family Cluster File supplying the proteins and family numbers. Filled in when a project is already open."/>
                    <TextBox Grid.Column="1" x:Name="TextBoxHomologyFcf" Text="{Binding HomologyFcf, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5" VerticalAlignment="Center" ToolTip="Full path of an existing .fqproj or .fcf supplying sequences and current family IDs; initially empty or suggested from the open project, with no numeric range. Search reads the file without changing it."/>
                    <Button Grid.Column="2" x:Name="ButtonBrowseHomologyFcf" Content="Browse..." Padding="12,5"
                            Click="ButtonBrowseHomologyFcf_Click" ToolTip="Choose a project or family file supplying the proteins and family IDs for inspection. This changes only the pending path; Search reads the file."/>
                    <Button Grid.Column="3" x:Name="ButtonSearchHomology" Style="{DynamicResource PrimaryButton}" Content="Search" Margin="10,4,4,4" Padding="14,6"
                            Click="ButtonSearchHomology_Click" IsEnabled="False" FontSize="13" ToolTip="Map distinct kept peptides to the chosen file's current families and replace this view's homology result; the input file and stored quantities stay unchanged. Disabled until Load and filter keeps rows, or while an operation is running."/>
                </Grid>
                <WrapPanel Grid.Row="1" Margin="5,8,5,0">
                    <Label Content="Minimum identity (0 to 1):" VerticalAlignment="Center"
                           ToolTip="Fraction of a peptide that must match a protein exactly before it is scored. Default 0.80; lower values let in chance matches, so watch the decoy-only count."/>
                    <TextBox x:Name="TextBoxMinIdentity" Text="{Binding MinimumIdentity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="5" VerticalAlignment="Center" ToolTip="Minimum literal peptide identity for the homology prefilter: default 0.80, allowed fraction 0 to 1 using a decimal point. This prepares the next standalone Search without changing stored quantities."/>
                    <Label Content="Top hits per peptide:" Margin="12,0,0,0" VerticalAlignment="Center"
                             ToolTip="Maximum proteins assigned per peptide, best scores first; default 3. Raising it spreads shared peptides over more families."/>
                    <TextBox x:Name="TextBoxTopHits" Text="{Binding TopHits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="5" VerticalAlignment="Center" ToolTip="Maximum retained protein hits per peptide after scoring: default 3 hits, whole numbers 1 to 1000. This prepares the next standalone Search without changing stored quantities."/>
                    <CheckBox x:Name="CheckBoxConsiderILSame" IsChecked="{Binding ConsiderILSame, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="I and L are one residue"
                              Margin="14,0,0,0" VerticalAlignment="Center" ToolTip="Treat isoleucine and leucine as the same residue in the next standalone homology search; on by default because their masses are identical. This changes a pending search option, not stored quantities."/>
                    <CheckBox x:Name="CheckBoxKQEquivalent" IsChecked="{Binding KQEquivalent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="K and Q are one residue"
                              Margin="14,0,0,0" VerticalAlignment="Center" ToolTip="Treat lysine and glutamine as equivalent in the next standalone homology search; off by default. This widens sequence matching for that request without changing stored quantities."/>
                    <Label Content="Decoy prefix:" Margin="12,0,0,0" VerticalAlignment="Center"
                           ToolTip="Text that marks a decoy protein in the family file. If it is wrong, decoys count as targets and the mapped count looks better than it is."/>
                    <TextBox x:Name="TextBoxDecoyLabel" Text="{Binding DecoyLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="5" VerticalAlignment="Center" ToolTip="Case-sensitive identifier prefix marking decoy proteins for the next Search: default Reverse_, any nonempty text, with no numeric unit or range. Changing it prepares the request without editing the input file."/>
                </WrapPanel>
                <WrapPanel Grid.Row="2" Margin="5,10,5,0">
                    <Label x:Name="LabelHomologyPeptides" Content="{Binding LabelHomologyPeptides}" Style="{StaticResource ResultValue}"
                           ToolTip="Distinct peptide sequences searched. A sequence read in many spectra is searched once, so this is below the kept row count."/>
                    <Label x:Name="LabelHomologyMapped" Content="{Binding LabelHomologyMapped}" Style="{StaticResource ResultValue}"
                           ToolTip="Peptides assigned to at least one target protein, and their share of those searched. Read it next to the decoy-only count."/>
                    <Label x:Name="LabelHomologyDecoyOnly" Content="{Binding LabelHomologyDecoyOnly}" Style="{StaticResource ResultValue}"
                           ToolTip="Peptides that matched only decoy proteins: the false-match control. If it is close to the mapped count, the identity threshold is too low."/>
                    <Label x:Name="LabelHomologyUnmatched" Content="{Binding LabelHomologyUnmatched}" Style="{StaticResource ResultValue}"
                           ToolTip="Peptides that matched no protein at this identity. In de novo data this is common, and it is not an error."/>
                    <Label x:Name="LabelHomologyElapsed" Content="{Binding LabelHomologyElapsed}" Style="{StaticResource ResultValue}"
                           ToolTip="How long the search took, in seconds, so an unusually slow search can be noticed."/>
                </WrapPanel>
                <DataGrid Grid.Row="3" x:Name="DataGridHomologyFamilies" ItemsSource="{Binding HomologyItems}" Margin="5,8,5,5" Height="130"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" ToolTip="Inspect target peptide counts by current family, ranked by count; a peptide mapped to several families counts in each. Selecting or sorting rows changes only the view, so these counts must not be summed as distinct peptides.">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColumnFamilyId" Header="Family (User ID)" Width="120" Binding="{Binding Path=FamilyId}"/>
                        <DataGridTextColumn x:Name="ColumnFamilyPeptides" Header="Peptides" Width="90" Binding="{Binding Path=PeptideCount, StringFormat=N0}"/>
                        <DataGridTextColumn x:Name="ColumnFamilyDescription" Header="Representative description" Width="*" MinWidth="200" Binding="{Binding Path=Description}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
            </StackPanel>
        </Expander>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderThickness="0,1,0,0" Padding="10,6">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" x:Name="ButtonDeNovoHelp" Content=" Help" Margin="10,0,0,0"
                        Padding="12,3" VerticalAlignment="Top" Click="ButtonDeNovoHelp_Click" ToolTip="Open Help explaining native confidence, filters, reconciliation and standalone homology. The project and files stay unchanged."/>
                <TextBlock x:Name="TextBlockDeNovoStatus" TextWrapping="Wrap" FontSize="12"
                           VerticalAlignment="Center"
                           ToolTip="What is on screen and what to do next. Refused values, empty folders and unreadable files are reported here, not in pop-ups."/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
