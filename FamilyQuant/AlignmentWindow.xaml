<Window x:Class="FamilyQuant.AlignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FamilyQuant"
        Title="Align selected" Width="1240" Height="760" MinWidth="900" MinHeight="560"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <DataTemplate x:Key="AlignmentTick">
            <CheckBox IsChecked="{Binding Ticked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanTick}" HorizontalAlignment="Center"
                      ToolTip="Tick to include this sequence in the alignment. The first protein always stays in." ToolTipService.ShowOnDisabled="True"/>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="Read only: tick the sequences to compare. Nothing in the proposal, its ticks or your file changes."
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="360"/><ColumnDefinition Width="16"/><ColumnDefinition Width="3*" MinWidth="420"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Sequences" Style="{StaticResource SectionTitle}"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Families}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Notes}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding HasNotes, Converter={StaticResource VisibleWhenTrue}}"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <DataGrid x:Name="candidateGrid" ItemsSource="{Binding Candidates}" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" SelectionMode="Extended" HeadersVisibility="Column" Margin="0,8,0,0"
                          ToolTip="Highlighted proteins first, then each one's nearest reviewed protein, then reviewed members of the family from your file and from the reference panel.">
                    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Details}"/></Style></DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Use" Width="44" MinWidth="44" IsReadOnly="True" CellTemplate="{StaticResource AlignmentTick}" ClipboardContentBinding="{Binding Name}"/>
                        <DataGridTextColumn Header="Protein" Width="104" MinWidth="96" IsReadOnly="True" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Identity" Width="72" MinWidth="72" IsReadOnly="True" Binding="{Binding Identity}"/>
                        <DataGridTextColumn Header="Cys" Width="44" MinWidth="44" IsReadOnly="True" Binding="{Binding Cysteines}"/>
                        <DataGridTextColumn Header="Length" Width="60" MinWidth="60" IsReadOnly="True" Binding="{Binding Length}"/>
                        <DataGridTextColumn Header="Source" Width="100" MinWidth="100" IsReadOnly="True" Binding="{Binding Source}"/>
                        <DataGridTextColumn Header="Notes" Width="*" MinWidth="110" IsReadOnly="True" Binding="{Binding Notes}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Alignment" Style="{StaticResource SectionTitle}"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource CaptionText}" Margin="0,2,0,8"/>
                <Border BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="4">
                    <ScrollViewer x:Name="alignmentScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="12,10">
                        <local:AlignmentView x:Name="alignmentView" Alignment="{Binding Alignment}"/>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="{x:Static local:AlignmentViewModel.IdentityNote}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0"
                   ToolTip="{Binding Method}"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="copyFastaButton" Content="Copy as FASTA" Click="CopyFasta_Click" IsEnabled="{Binding CanCopy}"
                    ToolTip="Copies the aligned sequences, gaps included, as FASTA for another program."/>
            <Button x:Name="copyTextButton" Content="Copy aligned text" Click="CopyText_Click" IsEnabled="{Binding CanCopy}" Margin="8,0,0,0"
                    ToolTip="Copies the alignment as blocks of 60 columns with names and residue numbers, for a note or an email."/>
            <Button Content="Close" IsCancel="True" Click="Close_Click" Margin="8,0,0,0" ToolTip="Closes this window. Nothing was changed."/>
        </StackPanel>
    </Grid>
</Window>
