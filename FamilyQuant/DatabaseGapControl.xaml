<UserControl x:Class="FamilyQuant.DatabaseGapControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
  <Style x:Key="GapNumber" TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="Margin" Value="6,0,8,0"/></Style>
  <Style x:Key="GapRate" TargetType="TextBlock" BasedOn="{StaticResource GapNumber}"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="GapFamily" TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding FamilyLabel}"/></Style>
  <Style x:Key="GapHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
   <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}, StringFormat='The recorded {0} for this family row.'}"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="GapLengthHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GapHeader}">
   <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}, StringFormat='The stored {0} for this minimum tag length.'}"/>
  </Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel>
  <TextBlock Text="Database gap" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <StackPanel Visibility="{Binding HasStoredResult, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,12">
   <DockPanel Margin="0,0,0,8">
    <ComboBox x:Name="ComboBoxMinimumTagLength" DockPanel.Dock="Right" Width="80" ItemsSource="{Binding LengthChoices}"
     SelectedItem="{Binding MinimumTagLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
     ToolTip="Choose a stored minimum tag length. The table and exports follow this project choice."/>
    <TextBlock Text="Minimum tag length" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </DockPanel>
   <TextBlock Text="Stored estimates by minimum tag length" FontWeight="SemiBold" Margin="0,0,0,6"/>
   <TextBlock Text="Landed share uses the unattributed de novo envelope; decoy rate uses credited envelope. Known-answer right rates show right/landed counts."
    TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
   <DataGrid x:Name="DataGridLengths" ItemsSource="{Binding LengthRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
    MaxHeight="360" ColumnHeaderStyle="{StaticResource GapLengthHeader}"
    ToolTip="Every value is the stored Core estimate for this length. This screen does not search or calculate an estimate.">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Minimum tag length" Binding="{Binding MinimumTagLength}" ElementStyle="{StaticResource GapNumber}" Width="110"/>
     <DataGridTextColumn Header="Landed share" Binding="{Binding LandedShare}" ElementStyle="{StaticResource GapNumber}" Width="140"/>
     <DataGridTextColumn Header="Decoy rate" Binding="{Binding DecoyRate}" ElementStyle="{StaticResource GapRate}" Width="340"/>
     <DataGridTextColumn Header="Known answers right (right/landed)" Binding="{Binding KnownAnswerRight}" Width="*" MinWidth="240"/>
     <DataGridTextColumn Header="Result" Binding="{Binding Availability}" Width="120"/>
    </DataGrid.Columns>
   </DataGrid>
  </StackPanel>
  <TextBlock x:Name="TextBlockEmpty" Text="{Binding EmptyMessage}" TextWrapping="Wrap"/>
  <StackPanel x:Name="PanelResult" Visibility="{Binding HasData, Converter={StaticResource VisibleWhenTrue}}">
   <TextBlock x:Name="TextBlockRules" Text="{Binding Rules}" TextWrapping="Wrap" Margin="0,0,0,6"/>
   <TextBlock Text="{Binding Basis}" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource MutedBrush}"/>
   <ItemsControl x:Name="GlobalBuckets" ItemsSource="{Binding GlobalRows}" Margin="0,0,0,12">
    <ItemsControl.ItemTemplate><DataTemplate>
     <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="{Binding Envelope, StringFormat={}{0:G6}}" FontWeight="SemiBold" Margin="16,0,0,0"/>
      <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DockPanel>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <WrapPanel Margin="0,0,0,8">
    <TextBlock Text="Identified" Foreground="{DynamicResource ChartIdentifiedBrush}" Margin="0,0,18,0"/>
    <TextBlock Text="De novo in database" Foreground="{DynamicResource ChartDeNovoBrush}" Margin="0,0,18,0"/>
    <TextBlock Text="De novo only in family world" Foreground="{DynamicResource ChartPeptideLikeBrush}"/>
   </WrapPanel>
   <ScrollViewer x:Name="ChartScroll" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
    ToolTip="Every stored family has a three-part bar. Scroll to see the complete ranking.">
    <ContentControl x:Name="ChartHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"/>
   </ScrollViewer>
   <TextBlock Text="All numbers, including families with little validation evidence" FontWeight="SemiBold" Margin="0,12,0,6"/>
   <TextBlock Text="{Binding ValidationRule}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
   <DataGrid x:Name="DataGridFamilies" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260"
    ColumnHeaderStyle="{StaticResource GapHeader}"
    CanUserAddRows="False" ToolTip="Exact stored family amounts and their validation facts. The CSV includes these rows and every global bucket.">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Family" Binding="{Binding FamilyLabel}" ElementStyle="{StaticResource GapFamily}" Width="*" MinWidth="150"/>
     <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90"/>
     <DataGridTextColumn Header="Identified" Binding="{Binding Data.IdentifiedEnvelope, StringFormat={}{0:G6}}" ElementStyle="{StaticResource GapNumber}" Width="100"/>
     <DataGridTextColumn Header="De novo in database" Binding="{Binding Data.DatabaseDeNovoEnvelope, StringFormat={}{0:G6}}" ElementStyle="{StaticResource GapNumber}" Width="120"/>
     <DataGridTextColumn Header="Database gap" Binding="{Binding Data.WorldDeNovoEnvelope, StringFormat={}{0:G6}}" ElementStyle="{StaticResource GapNumber}" Width="90"/>
     <DataGridTextColumn Header="Decoy rate of world credits" Binding="{Binding DecoyRate}" ElementStyle="{StaticResource GapRate}" Width="340"/>
     <DataGridTextColumn Header="Known-answer right rate (true/credited)" Binding="{Binding RightRate}" Width="260"/>
    </DataGrid.Columns>
   </DataGrid>
   <Expander Header="Stored rules, scope and provenance" Margin="0,10,0,0"
    ToolTip="Read the exact stored first-pass rule, scope and release beside the result.">
    <StackPanel Margin="8"><TextBlock Text="{Binding FirstPassRules}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding SecondPassRules}" TextWrapping="Wrap" Margin="0,6,0,0"/>
     <TextBlock Text="{Binding Scope}" TextWrapping="Wrap" Margin="0,6,0,0"/>
     <TextBlock Text="{Binding Provenance}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
   </Expander>
   <TextBlock x:Name="TextBlockFastaState" Text="{Binding FastaState}" TextWrapping="Wrap" Margin="0,10,0,0"/>
  </StackPanel>
 </StackPanel>
 </ScrollViewer>
</UserControl>
