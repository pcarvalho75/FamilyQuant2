<UserControl x:Class="FamilyQuant.USearchLib"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:numeric="clr-namespace:FamilyQuant"
             xmlns:core="clr-namespace:FamilyQuant;assembly=FamilyQuant.Core"
             Background="{DynamicResource CanvasBrush}" FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource BodySize}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="Build families" FontSize="{DynamicResource TitleSize}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
            <TextBlock Text="Group a protein database by sequence identity." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,18"/>
            <Border Background="{DynamicResource SurfaceBrush}" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Database" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TextBoxDatabasePath" Text="{Binding DatabasePath}" IsReadOnly="True" VerticalAlignment="Center" Margin="0,0,10,0"
                                 ToolTip="The FASTA or target-decoy database used by every action on this screen. Choose another file to change it."/>
                        <Button x:Name="ButtonInput" Grid.Column="1" Content="Choose database" Click="ButtonInput_Click"
                                ToolTip="Chooses a FASTA or target-decoy database without starting a run. Build, scan and preparation use this same selected file."/>
                    </Grid>
                    <WrapPanel Margin="0,14,0,12">
                        <Label Content="Identity (%)" VerticalAlignment="Center" ToolTip="Percent identity two sequences need to join a family. Higher values produce smaller families."/>
                        <numeric:IntegerUpDown x:Name="IntegerUpDownIdentity" Value="{Binding Identity, Mode=TwoWay}" Minimum="1" Maximum="100" Width="76" Margin="8,0,18,0"
                                           ToolTip="Sequence identity for building families, from 1 to 100 percent. The usual starting value is 85."/>
                        <CheckBox x:Name="CheckBoxExhaustiveClustering" Content="Exhaustive second pass" IsChecked="{Binding Exhaustive, Mode=TwoWay}" VerticalAlignment="Center"
                                  ToolTip="Aligns every sequence pair to close gaps left by the fast pass. On by default; large databases require confirmation."/>
                    </WrapPanel>
                    <WrapPanel>
                        <Button x:Name="ButtonBuildFamilies" Content="Build families" Click="ButtonBuildFamilies_Click" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,0" IsEnabled="False"
                                ToolTip="Groups the chosen database at this identity and writes its Family Cluster File beside it. Disabled until a database is chosen."/>
                        <Button x:Name="ButtonCalculateFDR" Content="Check mixing (FDR)" Click="ButtonCalculateFDR_Click" IsEnabled="False"
                                ToolTip="{x:Static core:IdentifierText.CalculateFdrToolTip}"/>
                    </WrapPanel>
                    <TextBlock x:Name="TextBlockBuildResult" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Choose identity" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <WrapPanel Margin="0,10,0,12">
                        <Label Content="Allowed mixing" VerticalAlignment="Center" ToolTip="Largest accepted fraction of families mixing targets and decoys. Keep the usual value of zero."/>
                        <numeric:DecimalUpDown x:Name="DecimalUpDownMaxFDR" Value="{Binding MaximumMixing, Mode=TwoWay}" Minimum="0" Maximum="0.5" Increment="0.01" Width="76" Margin="8,0,0,0"
                                           ToolTip="Target-decoy mixing fraction accepted by the lowest-identity search. Default zero; a nonzero allowance can admit noisy joins."/>
                    </WrapPanel>
                    <WrapPanel>
                        <Button x:Name="ButtonScanIdentities" Content="Scan identity range" Click="ButtonScanIdentities_Click" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,0" IsEnabled="False"
                                ToolTip="Scans identities from 95 down to 10 percent and reports family counts and target-decoy mixing. Disabled until a database is chosen."/>
                        <Button x:Name="ButtonDivideAndConquer" Content="Find lowest identity" Click="ButtonDivideAndConquer_Click" IsEnabled="False"
                                ToolTip="Finds the lowest identity within the allowed mixing score using Divide and Conquer. Disabled until a database is chosen."/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Expander Header="Prepare database (optional)" BorderThickness="0" Margin="0,0,0,14" Foreground="{DynamicResource TextBrush}">
                <Border Background="{DynamicResource SurfaceBrush}" Padding="16">
                    <WrapPanel>
                        <Label Content="Redundancy identity (%)" VerticalAlignment="Center" ToolTip="At 100 percent, removes exact subsets and duplicates. Lower values remove near-identical sequences too."/>
                        <numeric:IntegerUpDown x:Name="IntegerUpDownRedundancyIdentity" Value="{Binding RedundancyIdentity, Mode=TwoWay}" Minimum="50" Maximum="100" Width="76" Margin="8,0,12,0"
                                           ToolTip="Identity above which sequences count as redundant. Default 100 preserves original order and removes exact subsets and duplicates."/>
                        <Button x:Name="ButtonRemoveRedundancy" Content="Remove redundancy" Click="ButtonRemoveRedundancy_Click" IsEnabled="False"
                                ToolTip="Writes a separate FASTA without redundant sequences, preserving order and headers. Disabled until a database is chosen; the original stays unchanged."/>
                    </WrapPanel>
                </Border>
            </Expander>
            <Button x:Name="ButtonBuildHelp" Content="How identity and mixing work" Click="ButtonBuildHelp_Click" HorizontalAlignment="Left"
                    ToolTip="Explains exhaustive clustering, score limitations, identity searches and order-preserving preparation. Opens the details for this screen."/>
            <Border x:Name="BorderUSearchStatus" Background="{DynamicResource SubtleBrush}" Padding="10,6" Margin="0,12,0,0">
                <TextBlock x:Name="TextBlockUSearchState" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"
                           Text="Choose a database, choose identity, then Build families."
                           ToolTip="Shows the current action and its result in one line. Full details remain available in this screen's Help."/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
