<UserControl x:Class="FamilyQuant.USearchLib"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:numeric="clr-namespace:FamilyQuant"
             xmlns:core="clr-namespace:FamilyQuant;assembly=FamilyQuant.Core"
             Background="{DynamicResource CanvasBrush}" FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource BodySize}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="Build families" FontSize="{DynamicResource TitleSize}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
            <TextBlock Text="Group by sequence identity, USearch." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,18"/>
            <Border Background="{DynamicResource SurfaceBrush}" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Database" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TextBoxDatabasePath" Text="{Binding DatabasePath}" IsReadOnly="True" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Read-only path of the selected FASTA or target-decoy database, initially empty. Choose database changes this pending input without editing the source file or the open project."/>
                        <Button x:Name="ButtonInput" Grid.Column="1" Content="Choose database" Click="ButtonInput_Click" ToolTip="Choose the FASTA or target-decoy database used by build, scan and preparation without starting a run. The project and files stay unchanged; wait for the current run to finish if disabled."/>
                    </Grid>
                    <WrapPanel Margin="0,14,0,12">
                        <Label Content="Identity (%)" VerticalAlignment="Center" ToolTip="Percent identity two sequences need to join a family. Higher values produce smaller families."/>
                        <numeric:IntegerUpDown x:Name="IntegerUpDownIdentity" Value="{Binding Identity, Mode=TwoWay}" Minimum="1" Maximum="100" Width="76" Margin="8,0,18,0" ToolTip="Identity for the next Build families request: default 85 percent, whole numbers 1 to 100; higher values usually give smaller families. Editing writes no file; wait for the current run to finish if disabled."/>
                        <CheckBox x:Name="CheckBoxExhaustiveClustering" Content="Exhaustive second pass" IsChecked="{Binding Exhaustive, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Enable the default second pass, which joins fast-pass families through all-pairs edges meeting identity and coverage over the longer sequence. This prepares the next build or scan without changing files; wait for a current run if disabled, and expect confirmation above 10,000 sequences."/>
                    </WrapPanel>
                    <WrapPanel>
                        <Button x:Name="ButtonBuildFamilies" Content="Build families" Click="ButtonBuildFamilies_Click" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,0" IsEnabled="False" ToolTip="Group the selected database at the chosen identity and write a .fcf beside it, asking before replacing one; Undo cannot recover a replaced file. Disabled until an existing database is chosen or while a run is active; open the written file to curate it."/>
                        <Button x:Name="ButtonCalculateFDR" Content="Check mixing (FDR)" Click="ButtonCalculateFDR_Click" IsEnabled="False" ToolTip="Report mixed target-decoy families divided by all families in the last built result, without changing files; this is a mixing score rather than statistical FDR. Disabled until Build families finishes or while a run is active; build a target-decoy database for an informative score."/>
                    </WrapPanel>
                    <TextBlock x:Name="TextBlockBuildResult" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Choose identity" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <WrapPanel Margin="0,10,0,12">
                        <Label Content="Allowed mixing" VerticalAlignment="Center" ToolTip="Largest accepted fraction of families mixing targets and decoys. Keep the usual value of zero."/>
                        <numeric:DecimalUpDown x:Name="DecimalUpDownMaxFDR" Value="{Binding MaximumMixing, Mode=TwoWay}" Minimum="0" Maximum="0.5" Increment="0.01" Width="76" Margin="8,0,0,0" ToolTip="Largest allowed target-decoy family mixing fraction for Find lowest identity: default 0, range 0 to 0.5, in steps of 0.01. Editing prepares the search without writing a file; wait for a current run if disabled."/>
                    </WrapPanel>
                    <WrapPanel>
                        <Button x:Name="ButtonScanIdentities" Content="Scan identity range" Click="ButtonScanIdentities_Click" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,0" IsEnabled="False" ToolTip="Compare family counts and target-decoy mixing from 95 down to 10 percent identity, without writing a family file or changing the chosen identity. Disabled until an existing database is chosen or while a run is active; choose the identity after reviewing the scan."/>
                        <Button x:Name="ButtonDivideAndConquer" Content="Find lowest identity" Click="ButtonDivideAndConquer_Click" IsEnabled="False" ToolTip="Find the lowest identity meeting the allowed mixing fraction by Divide and Conquer, reporting a floor rather than a recommended threshold or a saved family file. Disabled until an existing database is chosen or while a run is active; a meaningful search requires decoy sequences."/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Expander Header="Prepare database (optional)" BorderThickness="0" Margin="0,0,0,14" Foreground="{DynamicResource TextBrush}" ToolTip="Expand the optional redundancy-removal controls. Expanding changes only this view; Remove redundancy writes a separate FASTA when requested.">
                <Border Background="{DynamicResource SurfaceBrush}" Padding="16">
                    <WrapPanel>
                        <Label Content="Redundancy identity (%)" VerticalAlignment="Center" ToolTip="Below 100 percent, identity is the best ungapped matching-residue count as a percentage of the shorter sequence, treating I and L as equal. At 100 percent, removes exact subsets and duplicates."/>
                        <numeric:IntegerUpDown x:Name="IntegerUpDownRedundancyIdentity" Value="{Binding RedundancyIdentity, Mode=TwoWay}" Minimum="50" Maximum="100" Width="76" Margin="8,0,12,0" ToolTip="Redundancy cutoff: default 100 percent, whole numbers 50 to 100; 100 removes exact subsets and duplicates, while lower values also remove near-identical sequences with I = L. Editing prepares the next removal without writing files; wait for a current run if disabled."/>
                        <Button x:Name="ButtonRemoveRedundancy" Content="Remove redundancy" Click="ButtonRemoveRedundancy_Click" IsEnabled="False" ToolTip="Write a separate _NO_REDUNDANCY.fasta beside the selected database, retaining original order and headers; the input stays unchanged and Undo does not remove the output. Disabled until an existing database is chosen or while a run is active."/>
                    </WrapPanel>
                </Border>
            </Expander>
            <Button x:Name="ButtonBuildHelp" Content="How identity and mixing work" Click="ButtonBuildHelp_Click" HorizontalAlignment="Left" ToolTip="Open Help explaining sequence identity, exhaustive clustering, target-decoy mixing and database preparation. The project and files stay unchanged."/>
            <Border x:Name="BorderUSearchStatus" Background="{DynamicResource SubtleBrush}" Padding="10,6" Margin="0,12,0,0">
                <TextBlock x:Name="TextBlockUSearchState" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"
                           Text="Choose a database, choose identity, then Build families."
                           ToolTip="Shows the current action and its result in one line. Full details remain available in this screen's Help."/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
