<UserControl x:Class="FamilyQuant.AnalyticsControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:FamilyQuant"
 Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></UserControl.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <ComboBox x:Name="ComboBoxExportKind" Width="210" SelectedIndex="0" SelectionChanged="ExportChoiceChanged"
     ToolTip="Choose which stored result or figures to export.">
     <ComboBoxItem Content="Run summary (CSV)" ToolTip="Per-run TIC, peptide counts, envelopes and recovery shares in invariant decimal format." Tag="Summary"/>
     <ComboBoxItem Content="Peptide table (CSV)" ToolTip="Per-peptide run, sequence, charge, mass, isotope areas, envelope and family assignments." Tag="Peptides"/>
     <ComboBoxItem Content="Screen figures (PNG)" ToolTip="Every screen graph at 1920 by 1080 pixels in the Light palette." Tag="Figures"/>
     <ComboBoxItem Content="Presentation evidence pack" ToolTip="Complete figures, exact CSV and JSON numbers and cutoff README. Required studies must be present." Tag="EvidencePack"/>
     <ComboBoxItem Content="Homology assignments (CSV)" ToolTip="Export the latest standalone homology snapshot, with one row per searched peptide recording family IDs, protein IDs and ambiguity. No full XIC or open project is required." Tag="Homology"/>
     <ComboBoxItem Content="Database gap (CSV)" ToolTip="The stored three-part family table, every global bucket and the rules in force." Tag="DatabaseGap"/>
     <ComboBoxItem Content="Suggested additions (FASTA)" ToolTip="Exact stored world proteins hit by credited tags, for you to add and search again in PatternLab." Tag="SuggestedAdditions"/>
    </ComboBox>
    <Button x:Name="ButtonExport" Content="Export" Style="{DynamicResource PrimaryButton}" Click="ExportClicked"
     ToolTipService.ShowOnDisabled="True"
     ToolTip="Save the selected result in CSV or PNG format with invariant decimals. Figures use 1920 by 1080 pixels in the Light palette."/>
   </StackPanel>
   <TextBlock Text="Results" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </DockPanel>
  <ItemsControl Grid.Row="1" ItemsSource="{Binding Cards}" Margin="0,18,0,10">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border Background="{DynamicResource SurfaceBrush}" Padding="16" CornerRadius="6" Margin="0,0,10,0">
     <StackPanel><TextBlock Text="{Binding Title}" Foreground="{DynamicResource MutedBrush}"/>
      <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="{DynamicResource CaptionSize}"/>
     </StackPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <WrapPanel Grid.Row="2" Margin="0,0,0,10">
   <TextBlock Text="Family chart" VerticalAlignment="Center" Margin="0,0,10,0"/>
   <ComboBox x:Name="ComboBoxFamilyTopN" Width="160" SelectionChanged="ChartChoiceChanged"
    ToolTip="Show the largest families and combine every remaining family in one bar.">
    <ComboBoxItem Content="Top 10 families" ToolTip="Ten families plus one bar for the rest. Suits presentation slides." Tag="10"/>
    <ComboBoxItem Content="Top 15 families" ToolTip="Fifteen families plus one bar for the rest. This is the default." Tag="15" IsSelected="True"/>
    <ComboBoxItem Content="Top 20 families" ToolTip="Twenty families plus one bar for the rest. Suits a paper figure." Tag="20"/>
    <ComboBoxItem Content="Top 30 families" ToolTip="Thirty families plus one bar for the rest. Labels need more screen space." Tag="30"/>
    <ComboBoxItem Content="All families" ToolTip="Every family retains its own bar. Scrolling may be needed for a large grouping." Tag="0"/>
   </ComboBox>
   <CheckBox x:Name="CheckBoxFamilyPercent" Content="Percent of measured signal" Margin="16,0,0,0" VerticalAlignment="Center"
    Checked="ChartChoiceChanged" Unchecked="ChartChoiceChanged"
    ToolTip="Divide by the measured signal. Count-in-every-family bars can overlap and their percentages must not be summed."/>
  </WrapPanel>
  <ScrollViewer x:Name="ScrollAnalytics" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock x:Name="TextBlockStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <Border x:Name="BorderEmpty" Background="{DynamicResource SurfaceBrush}" Padding="24" CornerRadius="6">
     <TextBlock x:Name="TextBlockEmpty" Text="{Binding EmptyMessage}" TextWrapping="Wrap"/>
    </Border>
    <Expander Header="Numbers, provenance and method details" Visibility="{Binding HasData, Converter={StaticResource VisibleWhenTrue}}"
     ToolTip="Every fact previously in the Analytics summary remains here, including denominators, source cutoffs and counting grains.">
     <TextBlock x:Name="TextBlockDetails" TextWrapping="Wrap" Margin="12"/>
    </Expander>
    <ContentControl x:Name="DatabaseGapHost" Margin="0,20,0,0"/>
    <StackPanel x:Name="PanelCharts" Margin="0,12,0,0"/>
    <Border Background="{DynamicResource SurfaceBrush}" Padding="16" CornerRadius="6" Margin="0,12,0,0"
     Visibility="{Binding HasHomology, Converter={StaticResource VisibleWhenTrue}}">
     <StackPanel>
      <TextBlock Text="{Binding HomologySummary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <DataGrid ItemsSource="{Binding Homology.Families}" AutoGenerateColumns="False" IsReadOnly="True" Height="220"
       ToolTip="Families reached by the latest standalone homology search. Its CSV contains every per-peptide assignment.">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Family" Binding="{Binding FamilyId}" Width="90"/>
        <DataGridTextColumn Header="Peptides" Binding="{Binding PeptideCount}" Width="100"/>
        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
