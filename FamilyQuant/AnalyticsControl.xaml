<UserControl x:Class="FamilyQuant.AnalyticsControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:FamilyQuant" xmlns:theme="clr-namespace:FamilyQuant.Themes"
 Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></UserControl.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="ButtonExport" Content="Export" Style="{DynamicResource PrimaryButton}" Click="ExportClicked"
     ToolTip="Opens the shared Export window for reports, CSV tables and other project files. The project stays open; Undo does not remove exported files."/>
   </StackPanel>
   <TextBlock Text="Results" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </DockPanel>
  <ItemsControl Grid.Row="1" ItemsSource="{Binding Cards}" Margin="0,18,0,10">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border Background="{DynamicResource SurfaceBrush}" Padding="16" CornerRadius="6" Margin="0,0,10,0">
     <StackPanel><TextBlock Text="{Binding Title}" Foreground="{DynamicResource MutedBrush}"/>
      <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="{DynamicResource CaptionSize}"/>
     </StackPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <ScrollViewer x:Name="ScrollAnalytics" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock x:Name="TextBlockStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <Border x:Name="BorderEmpty" Background="{DynamicResource SurfaceBrush}" Padding="24" CornerRadius="6">
     <TextBlock x:Name="TextBlockEmpty" Text="{Binding EmptyMessage}" TextWrapping="Wrap"/>
    </Border>
  <WrapPanel x:Name="FamilyChartOptions" Margin="0,0,0,10">
   <TextBlock Text="Family chart" VerticalAlignment="Center" Margin="0,0,10,0"/>
   <ComboBox x:Name="ComboBoxFamilyTopN" Width="160" SelectionChanged="ChartChoiceChanged" ToolTip="Choose the largest families as separate bars: 10, 15, 20, 30 or all families, with 15 as the default; the remainder shares one bar. This changes the chart and subsequent figure exports without editing project quantities; unavailable until quantitation exists.">
    <ComboBoxItem Content="Top 10 families" Tag="10" ToolTip="Show the ten largest families separately and combine all remaining families in one bar, suited to presentation slides. This changes chart layout and subsequent figure exports without editing quantities."/>
    <ComboBoxItem Content="Top 15 families" Tag="15" IsSelected="True" ToolTip="Show the fifteen largest families separately and combine all remaining families in one bar; this is the default. This changes chart layout and subsequent figure exports without editing quantities."/>
    <ComboBoxItem Content="Top 20 families" Tag="20" ToolTip="Show the twenty largest families separately and combine all remaining families in one bar, suited to a paper figure. This changes chart layout and subsequent figure exports without editing quantities."/>
    <ComboBoxItem Content="Top 30 families" Tag="30" ToolTip="Show the thirty largest families separately and combine all remaining families in one bar; labels need more screen space. This changes chart layout and subsequent figure exports without editing quantities."/>
    <ComboBoxItem Content="All families" Tag="0" ToolTip="Give every family its own chart bar, allowing scrolling when needed. This changes chart layout and subsequent figure exports without editing quantities."/>
   </ComboBox>
  </WrapPanel>
    <StackPanel x:Name="PanelFamilyChart"/>
    <Expander Header="Numbers, provenance and method details" Visibility="{Binding HasData, Converter={StaticResource VisibleWhenTrue}}" ToolTip="Expand stored summary facts, denominators, source cutoffs and counting grains behind Results. Only this view changes.">
     <TextBlock x:Name="TextBlockDetails" TextWrapping="Wrap" Margin="12"/>
    </Expander>
    <ContentControl x:Name="DatabaseGapHost" Margin="0,20,0,0"/>
    <Expander Header="Sensitivity" Margin="0,16,0,0" ToolTip="Expand family shares under the shared-peptide policies and actually computed cutoff variants. Expanding changes only this view; Calculate inside stores a sensitivity study in the project.">
     <ContentControl x:Name="SensitivityHost" Margin="12"/>
    </Expander>
    <StackPanel x:Name="PanelCharts" Margin="0,12,0,0"/>
    <Border Background="{DynamicResource SurfaceBrush}" Padding="16" CornerRadius="6" Margin="0,12,0,0"
     Visibility="{Binding HasHomology, Converter={StaticResource VisibleWhenTrue}}">
     <StackPanel>
      <TextBlock Text="{Binding HomologySummary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <DataGrid ItemsSource="{Binding Homology.Families}" AutoGenerateColumns="False" IsReadOnly="True" Height="220" ToolTip="Inspect target peptide counts by family from the latest standalone homology snapshot. Selecting or sorting rows changes only this view, and the CSV retains the per-peptide assignments.">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Family" Binding="{Binding FamilyId}" Width="90" theme:TableAppearance.HeaderToolTip="Current User ID of the family reached in the standalone homology snapshot. This is the input file's curated grouping rather than a new inferred family ID."/>
        <DataGridTextColumn Header="Peptides" Binding="{Binding PeptideCount}" Width="100" theme:TableAppearance.HeaderToolTip="Number of distinct searched de novo peptides reaching a target in this family. A peptide reaching several families counts in each, so these counts must not be summed as distinct peptides."/>
        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" theme:TableAppearance.HeaderToolTip="Representative description from the first target protein retained for this family in the homology snapshot."/>
       </DataGrid.Columns>
      </DataGrid>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
