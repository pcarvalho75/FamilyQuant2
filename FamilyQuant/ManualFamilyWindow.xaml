<Window x:Class="FamilyQuant.ManualFamilyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add to family" Width="820" Height="540" MinWidth="680" MinHeight="440" ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisible"/></Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding Heading}" Style="{DynamicResource SectionTitle}" Margin="0,0,0,16"/>
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Family" VerticalAlignment="Center"/>
            <ComboBox x:Name="familyChoice" Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberPath="DisplayName"
                      ToolTip="Choose a proposed family, or New family to name one yourself." Margin="0,0,0,10"/>
            <TextBlock Grid.Row="1" Text="New name" VerticalAlignment="Center" Visibility="{Binding IsNewFamily, Converter={StaticResource BoolVisible}}"/>
            <TextBox x:Name="newFamilyName" Grid.Row="1" Grid.Column="1" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsNewFamily, Converter={StaticResource BoolVisible}}" Margin="0,0,0,10"/>
            <TextBlock Grid.Row="2" Text="Note (optional)" VerticalAlignment="Center"/>
            <TextBox x:Name="manualNote" Grid.Row="2" Grid.Column="1" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="512"
                     ToolTip="Your one-line explanation is kept with these hand-added assignments in the grouping recipe."/>
        </Grid>
        <DataGrid x:Name="manualProteins" Grid.Row="2" ItemsSource="{Binding Proteins}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Accession" Width="140" Binding="{Binding Accession}"/>
                <DataGridTextColumn Header="Current family ID" Width="150" Binding="{Binding PreviousFamilyId}"/>
                <DataGridTextColumn Header="Description" Width="*" MinWidth="180" Binding="{Binding Description}"/>
                <DataGridCheckBoxColumn Header="Locked" Width="80" Binding="{Binding Source.IsLocked}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Text="{Binding Validation}" ToolTip="{Binding Validation}" Foreground="{DynamicResource MutedBrush}"
                   TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="addManualButton" Content="{Binding PrimaryLabel}" IsEnabled="{Binding CanConfirm}" Style="{DynamicResource PrimaryButton}" IsDefault="True" Click="Add_Click"/>
            <Button Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
