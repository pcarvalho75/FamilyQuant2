<Window x:Class="FamilyQuant.ManualFamilyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:FamilyQuant.Themes"
        Title="Add to family" Width="820" Height="540" MinWidth="680" MinHeight="440" ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisible"/></Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding Heading}" Style="{DynamicResource SectionTitle}" Margin="0,0,0,16"/>
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Family" VerticalAlignment="Center"/>
            <ComboBox x:Name="familyChoice" Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberPath="DisplayName" Margin="0,0,0,10" ToolTip="Choose a proposed family or New family; initially the selected proposal family, or the first listed option. This stages a hand assignment for review without changing the project until Apply grouping, after which Undo restores the preceding grouping."/>
            <TextBlock Grid.Row="1" Text="New name" VerticalAlignment="Center" Visibility="{Binding IsNewFamily, Converter={StaticResource BoolVisible}}"/>
            <TextBox x:Name="newFamilyName" Grid.Row="1" Grid.Column="1" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsNewFamily, Converter={StaticResource BoolVisible}}" Margin="0,0,0,10" ToolTip="Name for a new family: default empty, any nonblank name not already proposed, with no numeric unit or range. Confirming stages the choice for Apply grouping, after which Undo restores the preceding grouping."/>
            <TextBlock Grid.Row="2" Text="Note (optional)" VerticalAlignment="Center"/>
            <TextBox x:Name="manualNote" Grid.Row="2" Grid.Column="1" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="512" ToolTip="Optional explanation for the hand assignment: default empty, one line of at most 512 characters. Apply grouping and Save keep it in the grouping recipe; Undo restores the preceding applied grouping."/>
        </Grid>
        <DataGrid x:Name="manualProteins" Grid.Row="2" ItemsSource="{Binding Proteins}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" ToolTip="Inspect the highlighted proteins to be added, their current families and lock state. Selection and sorting change only this view; locked proteins must be unlocked in Curate families before confirmation.">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Accession" Width="140" Binding="{Binding Accession}" theme:TableAppearance.HeaderToolTip="UniProt accession parsed from the original identifier, or that identifier when no accession is found."/>
                <DataGridTextColumn Header="Current family ID" Width="150" Binding="{Binding PreviousFamilyId}" theme:TableAppearance.HeaderToolTip="Unchanged document family number before this hand assignment is applied. Staging a choice does not change that family."/>
                <DataGridTextColumn Header="Description" Width="*" MinWidth="180" Binding="{Binding Description}" theme:TableAppearance.HeaderToolTip="Original supplied description of a highlighted protein. The name does not determine its hand-chosen family."/>
                <DataGridCheckBoxColumn Header="Locked" Width="80" Binding="{Binding Source.IsLocked}" theme:TableAppearance.HeaderToolTip="Whether the protein's current document family is locked. This indicator is read only; unlock it in Curate families before confirming a hand assignment."><DataGridCheckBoxColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="ToolTip" Value="Read-only indicator that the current family is locked; this box cannot be edited here. Unlock the family in Curate families before confirming a hand assignment; the project changes only on Apply grouping."/></Style></DataGridCheckBoxColumn.CellStyle></DataGridCheckBoxColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Text="{Binding Validation}" ToolTip="{Binding Validation}" Foreground="{DynamicResource MutedBrush}"
                   TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="addManualButton" Content="{Binding PrimaryLabel}" IsEnabled="{Binding CanConfirm}" Style="{DynamicResource PrimaryButton}" IsDefault="True" Click="Add_Click" ToolTip="Stage the hand assignments for review; Apply grouping commits them to the project, after which Undo restores the preceding grouping. Disabled until highlighted proteins are unlocked, a proposed family or unique new name is chosen, and any note is one line of at most 512 characters."/>
            <Button Content="Cancel" IsCancel="True" ToolTip="Close without staging these hand assignments. The review, project and files stay unchanged."/>
        </StackPanel>
    </Grid>
</Window>
