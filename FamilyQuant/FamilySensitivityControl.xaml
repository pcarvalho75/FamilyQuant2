<UserControl x:Class="FamilyQuant.FamilySensitivityControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
 <StackPanel>
  <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
  <WrapPanel Margin="0,0,0,10">
   <Button x:Name="CalculateCurrent" Content="Calculate current result" Click="CalculateClicked" IsEnabled="{Binding CanCalculate}" Style="{DynamicResource PrimaryButton}"
    ToolTip="Use the current stored quantitation for all three shared-peptide policies. No RAW extraction runs."/>
   <Button x:Name="LoadComparison" Content="Compare saved project" Click="ComparisonClicked" IsEnabled="{Binding CanCalculate}"
    ToolTip="Choose an actually computed project with another de novo cutoff and matching inputs, grouping and extraction settings."/>
   <Button x:Name="ExportTable" Content="Export table" Click="ExportClicked" IsEnabled="{Binding HasData}"
    ToolTip="Export exact stored shares, signals, denominators and source fingerprints as CSV."/>
  </WrapPanel>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <DataGrid x:Name="SensitivityGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" Height="280">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Family ID" Binding="{Binding FamilyUserId}" Width="85"/>
    <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="*"/>
    <DataGridTextColumn Header="Shared peptides" Binding="{Binding Policy}" Width="230"/>
    <DataGridTextColumn x:Name="FirstColumn" Binding="{Binding First}" Width="180">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn x:Name="SecondColumn" Binding="{Binding Second}" Width="180">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
   </DataGrid.Columns>
  </DataGrid>
 </StackPanel>
</UserControl>
