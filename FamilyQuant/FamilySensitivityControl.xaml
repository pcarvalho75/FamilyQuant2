<UserControl x:Class="FamilyQuant.FamilySensitivityControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:theme="clr-namespace:FamilyQuant.Themes"
 xmlns:local="clr-namespace:FamilyQuant"
 Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
 <UserControl.Template>
 <ControlTemplate TargetType="{x:Type local:FamilySensitivityControl}">
 <StackPanel>
  <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
  <WrapPanel Margin="0,0,0,10">
   <Button x:Name="CalculateCurrent" Content="Calculate current result" Click="CalculateClicked" IsEnabled="{Binding CanCalculate}" Style="{DynamicResource PrimaryButton}" ToolTip="Store family shares under all three shared-peptide policies using current quantitation, with no RAW extraction; Save keeps the study and grouping Undo does not revert it. Disabled until quantitation and family grouping are available."/>
   <Button x:Name="LoadComparison" Content="Compare saved project" Click="ComparisonClicked" IsEnabled="{Binding CanCalculate}" ToolTip="Read a computed project with a different de novo cutoff and matching inputs, grouping and extraction settings, then store a comparison in this project; grouping Undo does not revert it. Disabled until current quantitation and family grouping are available; the comparison file stays unchanged."/>
   <Button x:Name="ExportTable" Content="Export table" Click="ExportClicked" IsEnabled="{Binding HasData}" ToolTip="Write the stored shares, signals, denominators and source fingerprints to CSV; Undo does not remove this file. Disabled until a current sensitivity table is available; calculate it first."/>
  </WrapPanel>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <DataGrid x:Name="SensitivityGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" Height="280" ToolTip="Inspect stored family shares for each shared-peptide policy and computed variant. Selecting or sorting rows changes only the view; full-count shares overlap and must not be summed.">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Family ID" Binding="{Binding FamilyUserId}" Width="85" theme:TableAppearance.HeaderToolTip="Current User ID retained with the sensitivity result. The grouping fingerprint must match before stored shares can be shown."/>
    <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="*" theme:TableAppearance.HeaderToolTip="Description retained for this current family in the stored sensitivity variants."/>
    <DataGridTextColumn Header="Shared peptides" Binding="{Binding Policy}" Width="230" theme:TableAppearance.HeaderToolTip="Attribution policy used for this row: family-unique only, equal splitting, or full counting in every matching family. Full counts overlap and must not be summed."/>
    <DataGridTextColumn x:Name="FirstColumn" Binding="{Binding First}" Width="180" theme:TableAppearance.HeaderToolTip="Current variant's family signal divided by measured peptide signal, shown as a percentage for the row's shared-peptide policy. A missing or zero denominator is unavailable rather than zero.">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn x:Name="SecondColumn" Binding="{Binding Second}" Width="180" theme:TableAppearance.HeaderToolTip="Comparison variant's family signal divided by measured peptide signal, shown as a percentage for the row's shared-peptide policy. An uncomputed comparison is unavailable rather than zero.">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
   </DataGrid.Columns>
  </DataGrid>
 </StackPanel>
 </ControlTemplate>
 </UserControl.Template>
</UserControl>
