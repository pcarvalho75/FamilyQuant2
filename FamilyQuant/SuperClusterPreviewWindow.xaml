                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button x:Name="addUnassignedFamilyButton" Content="Add to family" Tag="Unassigned" Click="AddManualFamily_Click" IsEnabled="{Binding CanEditManual}" ToolTip="Open hand placement for highlighted unassigned proteins; the project changes only on Apply grouping, with Undo available. Disabled without an editable current evidence proposal; Update proposal after scope edits and wait for active operations to finish."/>
                                    <Button Content="Remove from family" Tag="Unassigned" Click="RemoveManualFamily_Click" IsEnabled="{Binding CanEditManual}" ToolTip="Clear hand-added choices for highlighted rows and restore their automatic proposals; the project changes only on Apply grouping, with Undo available. Disabled without an editable current evidence proposal; Update proposal after scope edits and wait for active operations to finish."/>
                                </WrapPanel>
                                <TextBlock x:Name="unassignedLegend" DockPanel.Dock="Top" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                           Text="No family proposed; these proteins keep their current families and remain available for quantitation."
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,6"
                                           ToolTip="Unassigned means no new family was proposed; the recorded reason and warning details explain this result."/>
                                <DataGrid x:Name="unassignedGrid" ItemsSource="{Binding Evidence.Unassigned}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ToolTip="Inspect proteins with no proposed family and their supplied reasons and warning checks. Selecting or copying rows changes no assignment; use Add to family for an explicit hand choice.">
                                    <DataGrid.Columns><DataGridTextColumn Header="Accession" Width="180" MinWidth="180" Binding="{Binding Accession}" theme:TableAppearance.HeaderToolTip="UniProt accession parsed from the original identifier, or the identifier itself when no accession is found."/><DataGridTextColumn Header="Reason" Width="*" MinWidth="200" Binding="{Binding Reason}" theme:TableAppearance.HeaderToolTip="Supplied explanation of why this protein has no proposed family. It keeps its current document family unless explicitly placed by hand and applied."/><DataGridTextColumn Header="Flags" Width="180" MinWidth="180" Binding="{Binding Flags}" theme:TableAppearance.FullTextPath="FlagsHelp" theme:TableAppearance.HeaderToolTip="Warning labels expanded from supplied evidence flags; hover over the cell for exact checks and original details. An unassigned protein has no new family implied by its warning state."/><DataGridTextColumn Header="FASTA identifier" Width="200" MinWidth="200" Binding="{Binding Identifier}" theme:TableAppearance.HeaderToolTip="Full original FASTA identifier of this unassigned protein, including its prefixes."/></DataGrid.Columns>
                                </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Markers" ToolTip="Inspect learned marker domains with their supplied family votes, labelled scope denominator and all-domain carrier count. Opening this tab changes only the view and does not learn or edit marker rules.">
                                <DockPanel>
                                <TextBlock x:Name="markerLegend" DockPanel.Dock="Top" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"
                                           Text="Support = family votes / labelled scope votes; counts describe evidence, not abundance." TextTrimming="CharacterEllipsis"
                                           ToolTip="Support is the supplied family vote fraction among labelled scope proteins carrying the domain. All domain carriers are a separate count."/>
                                <DataGrid x:Name="markerGrid" ItemsSource="{Binding Evidence.Markers}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ToolTip="Inspect marker domains and their supplied support counts; support uses labelled scope carriers rather than every domain carrier. Selection and sorting change only this view.">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Accession" Width="110" MinWidth="110" Binding="{Binding Accession}" theme:TableAppearance.HeaderToolTip="Accession of the learned marker domain, not a protein accession."/>
                                        <DataGridTextColumn Header="Name" Width="*" MinWidth="180" Binding="{Binding Name}" theme:TableAppearance.HeaderToolTip="Stored name of the learned marker domain supplied by the classifier."/>
                                        <DataGridTextColumn Header="Family" Width="150" MinWidth="150" Binding="{Binding Family}" theme:TableAppearance.HeaderToolTip="Source family supported by this marker among labelled scope proteins."/>
                                        <DataGridTextColumn Header="Support" Width="110" MinWidth="110" Binding="{Binding SupportText}" theme:TableAppearance.FullTextPath="SupportHelp" theme:TableAppearance.HeaderToolTip="Supplied family vote fraction among labelled scope proteins carrying this domain. Without a supplied labelled-carrier denominator, support remains unavailable."/>
                                        <DataGridTextColumn Header="Family votes" Width="120" MinWidth="120" Binding="{Binding FamilyCarriers}" theme:TableAppearance.HeaderToolTip="Scope proteins carrying this domain and labelled as this source family; the support numerator."/>
                                        <DataGridTextColumn Header="Labelled votes" Width="140" MinWidth="140" Binding="{Binding LabelledCarriers}" theme:TableAppearance.HeaderToolTip="Proteins with this domain, scope words and one source-family label; the support denominator."/>
                                        <DataGridTextColumn Header="Domain carriers" Width="145" MinWidth="145" Binding="{Binding AllCarriers}" theme:TableAppearance.HeaderToolTip="All target proteins carrying this domain, including those without scope words or a source-family label. This is separate from the support denominator."/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Motif counts" ToolTip="Read the last checked motif's matches and complete-protein denominators, including unticked proposed members and excluding known fragments. Opening this tab changes only the view; editing a pattern requires a new check before Apply grouping.">
                                <DockPanel>
                                <TextBlock x:Name="motifLegend" DockPanel.Dock="Top" Text="{Binding MotifSummary}" FontSize="11" Margin="0,0,0,6"
                                           Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                           ToolTip="Counts use all proposed family members, including unticked proteins; entries marked as fragments are excluded. Use amino-acid letters or a regular expression; Help lists the count and not forms."/>
                                <TextBox Text="{Binding MotifReport, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" ToolTip="Read the last checked motif's family matches and complete-protein denominators, including unticked members and excluding known fragments. Selecting and copying text changes no proposal or file."/>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Grid>
                    <DockPanel Grid.Row="3" Margin="0,10,0,0" Visibility="{Binding ShowAllOptions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}}">
                        <Button DockPanel.Dock="Right" Content="Check motif" Click="Motif_Click" IsEnabled="{Binding CanCheckMotif}" ToolTip="Counts the entered motif across complete proposed family members, including unticked members, and keeps the checked pattern for Apply grouping. Disabled without a proposal or a pattern or during an operation; update the proposal, enter a pattern and wait to enable it; Check motif then reports a pattern it cannot use."/>
                        <TextBlock x:Name="MotifLabel" DockPanel.Dock="Left" Text="Motif (optional)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding MotifPattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="Amino-acid regular expression, optionally prefixed with not, or a count expression such as count C &gt;= 8; default empty skips the check, with no numeric range for the pattern. Check motif validates it before Apply grouping retains the choice, after which Undo restores the preceding grouping."/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
        <WrapPanel x:Name="PanelLinksWaitPanel" DockPanel.Dock="Top" Margin="0,0,0,6"
                   Visibility="{Binding IsWaitingForPanelLinks, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock Text="{Binding PanelLinksWaitText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="OpenPanelLinkChoicesButton" Content="Review choices" Click="OpenPanelLinkChoices_Click"
                    ToolTip="Open Panel links filtered to Needs a choice. Choose a family or Leave outside panel, then Use link choices to update the proposal; opening this view leaves the project unchanged."/>
        </WrapPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="UnlockEvidenceFamiliesButton" Content="Unlock evidence families" Click="UnlockEvidenceFamilies_Click"
                    Visibility="{Binding ShowUnlockEvidenceFamilies, Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{Binding CanUnlockEvidenceFamilies}"
                    ToolTip="{Binding DataContext.UnlockEvidenceFamiliesHint, RelativeSource={RelativeSource AncestorType={x:Type local:SuperClusterPreviewWindow}}, FallbackValue='Removes only the locks on families represented by the current evidence proposal as one project change Undo reverses, keeping memberships and quantities unchanged. Disabled until the proposal is current and all its proposed proteins are locked; update the proposal, finish its panel-link choices and wait for the operation before unlocking.'}"/>
            <Button Content="Help" Click="Help_Click" ToolTip="Open Help explaining scope, evidence sources, coverage, flags, keyword matching, domains and review choices. The project and files stay unchanged."/>
            <Button x:Name="createButton" Content="Apply grouping" Style="{DynamicResource PrimaryButton}" IsEnabled="{Binding CanConfirm}" IsDefault="True" Click="Create_Click" ToolTip="Commit reviewed ticks, family names and splits to the project as one grouping change; Undo restores the preceding grouping and Save writes it to disk. Disabled until at least one eligible protein is ticked, all selected families and splits are named, and scope, links and any motif check are current."/>
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" ToolTip="Close this review without applying its choices to the open project. No grouping Undo step is added and no project file is written."/>
        </StackPanel>
        <TextBlock x:Name="applyHint" Text="{Binding ApplyHint}" ToolTip="{Binding ApplyHint}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
