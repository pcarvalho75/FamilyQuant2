<Window x:Class="FamilyQuant.SuperClusterPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FamilyQuant.Themes" xmlns:local="clr-namespace:FamilyQuant"
        Title="Review grouping" Width="1180" Height="740" MinWidth="760" MinHeight="480"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <DataTemplate x:Key="KeywordTick">
            <CheckBox IsChecked="{Binding Join, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                      Click="KeywordTick_Click" ToolTip="Untick to keep this protein in its family. The rest of the family still joins."/>
        </DataTemplate>
        <DataTemplate x:Key="EvidenceTick">
            <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center"
                      ToolTip="{Binding SelectionHelp}" ToolTipService.ShowOnDisabled="True"/>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="headline" Text="{Binding Summary}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,12"/>
        <TabControl Grid.Row="1" SelectedIndex="{Binding ModeIndex}" IsEnabled="{Binding CanEdit}" SelectionChanged="ReviewModeChanged">
            <TabItem Header="Keywords" ToolTip="Review the proteins found by description keywords before creating one family.">
                <Grid Margin="8" DataContext="{Binding Keyword}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Keywords" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <TextBox Grid.Column="1" Text="{Binding KeywordsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,6"
                                 ToolTip="Keywords separated by commas or spaces; the list below follows as you type. Words in quotes form a phrase."/>
                        <ComboBox Grid.Column="2" SelectedIndex="{Binding MatchIndex}" Margin="0,0,0,6"
                                  ToolTip="Whether a protein must carry every keyword, or any one of them.">
                            <ComboBoxItem Content="match all words" ToolTip="A family is offered when one protein contains every keyword. This is the default match rule."/>
                            <ComboBoxItem Content="match any word" ToolTip="A family is offered when one protein contains any keyword. Quoted phrases must occur together in order."/>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Text="Exclude words" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                 ToolTip="Whole words that keep a protein out, separated by commas or spaces; the rest of its family still joins. A hyphenated word or a quoted phrase also works."/>
                    </Grid>
                    <StackPanel Grid.Row="1">
                        <TextBlock x:Name="notes" Text="{Binding Notes}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Notes}"/>
                        <CheckBox x:Name="hiddenBox" Content="{Binding HiddenLabel}" IsChecked="{Binding IncludeHidden}"
                                  Visibility="{Binding HasHidden, Converter={StaticResource VisibleWhenTrue}}" Margin="0,6,0,6"
                                  ToolTip="Gathers the matching families the Search box does not show, leaving your Search as it is."/>
                    </StackPanel>
                    <WrapPanel Grid.Row="2" Margin="0,6,0,8">
                        <Button Content="Untick the red ones" Click="UntickRed_Click" ToolTip="Unticks every protein with no keyword, leaving only the ones that carry your words."/>
                        <Button Content="Tick all" Click="TickAll_Click" ToolTip="Ticks every protein on the list again, undoing your unticks here."/>
                        <Button Content="Untick selected" Click="UntickSelected_Click" ToolTip="Unticks selected rows. Click a heading to sort, then Shift+click to select many."/>
                        <Button Content="Tick selected" Click="TickSelected_Click" ToolTip="Ticks selected rows without changing any other row."/>
                        <StackPanel x:Name="domainsPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding HasDomains, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Text="Keep domains" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBox x:Name="domainsBox" Width="180" Text="{Binding DomainText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Domains to keep, separated by commas or spaces. Copy domain names as the Domains column writes them."/>
                            <ComboBox x:Name="domainsList" Width="190" ItemsSource="{Binding DomainChoices}" SelectedItem="{Binding ChosenDomain}" Margin="6,0"
                                      ToolTip="The domains on this list, most proteins first. Choosing one adds its name to the box and resets this list."/>
                            <Button Content="Apply" Click="Domains_Click" ToolTip="Unticks proteins with none of these domains. A protein with no domains stays ticked if it carries a keyword."/>
                        </StackPanel>
                        <TextBlock x:Name="noDomains" Text="No domains in this file yet: press Fetch evidence in the main window."
                                   Visibility="{Binding NoDomains, Converter={StaticResource VisibleWhenTrue}}"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <DataGrid x:Name="grid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Extended" HeadersVisibility="Column" ItemsSource="{Binding Proteins}"
                              ToolTip="One row per protein, the ones with no keyword first. Click a heading to sort; right-click for the UniProt code, description or page; Ctrl+C copies the clicked column.">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers><DataTrigger Binding="{Binding HasKeyword}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Setter Property="FontStyle" Value="Italic"/>
                                    <Setter Property="ToolTip" Value="This protein carries no keyword: another protein in its family does. Untick it to keep it in its current family without affecting the others."/>
                                </DataTrigger></Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Joins" Width="72" MinWidth="72" IsReadOnly="True" CellTemplate="{StaticResource KeywordTick}" ClipboardContentBinding="{Binding Locus}" SortMemberPath="Join"/>
                            <DataGridTextColumn Header="Locus" Width="190" MinWidth="190" IsReadOnly="True" Binding="{Binding Locus}"/>
                            <DataGridTextColumn Header="Description" Width="*" MinWidth="200" IsReadOnly="True" Binding="{Binding Description}"/>
                            <DataGridTextColumn Header="Domains" Width="200" MinWidth="200" IsReadOnly="True" Binding="{Binding Domains}"/>
                            <DataGridTextColumn Header="Keyword" Width="100" MinWidth="100" IsReadOnly="True" Binding="{Binding Keyword}"/>
                            <DataGridTextColumn Header="Family" Width="76" MinWidth="76" IsReadOnly="True" Binding="{Binding Family}"/>
                            <DataGridTextColumn Header="In family" Width="90" MinWidth="90" IsReadOnly="True" Binding="{Binding FamilyKeywords}" SortMemberPath="FamilyCarriers" theme:TableAppearance.Numeric="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Evidence" IsEnabled="{Binding EvidenceAvailable}" ToolTip="Review classified families, protein-level reasons and flags. Disabled until an evidence proposal is available.">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                    <DockPanel Visibility="{Binding TaskDiscoveryAvailable, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Read database and scope" Click="DiscoverTask_Click" IsEnabled="{Binding CanDiscoverTask}"
                                ToolTip="Reads UniProt taxonomy and keyword counts among reviewed accessions in this file. Review or edit the suggested scope before Update proposal."/>
                        <TextBlock Text="Database and scope" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Expander Header="Database taxa and keyword counts" IsExpanded="{Binding TaskScopeExpanded}" Margin="0,0,0,8"
                              Visibility="{Binding HasTaskScope, Converter={StaticResource VisibleWhenTrue}}"
                              ToolTip="Shows the database taxa, clade and keyword counts among reviewed accessions in this file. Keyword counts can overlap and are not family shares.">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding TaskScope.Clade, StringFormat='Database clade: {0}'}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TaskScope.Clade}"/>
                            <Grid Margin="0,6,0,6" MaxHeight="140">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                <Button x:Name="CopyTaskTaxaButton" DockPanel.Dock="Right" Content="Copy" Margin="8,0,0,0"
                                        Command="ApplicationCommands.Copy" CommandTarget="{Binding ElementName=taskTaxaGrid}"
                                        ToolTip="Copies selected taxon rows, or every row when none are selected, with column headers."/>
                                <TextBlock x:Name="taskTaxaTotals" Text="{Binding TaskScope.TaxaTotals}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="Each non-contaminant target record counts once per distinct OX taxon using its FASTA prefix. Joined taxa can make row sums exceed the target count."/>
                                </DockPanel>
                                <DataGrid x:Name="taskTaxaGrid" ItemsSource="{Binding TaskScope.Taxa}" IsReadOnly="True" AutoGenerateColumns="False"
                                          MinColumnWidth="48" SelectionMode="Extended" SelectionUnit="FullRow"
                                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" MinHeight="76"
                                          ToolTip="FASTA target entries by OX taxon, sorted by count, with sp and tr taken from the header prefix. Contaminants and decoys are excluded.">
                                    <DataGrid.CommandBindings>
                                        <CommandBinding Command="ApplicationCommands.Copy" Executed="CopyTaskTaxa_Executed" CanExecute="CopyTaskTaxa_CanExecute"/>
                                    </DataGrid.CommandBindings>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Taxon" Width="*" Binding="{Binding Name}"/>
                                        <DataGridTextColumn Header="Taxonomy ID" Width="96" Binding="{Binding TaxonomyId}" theme:TableAppearance.Numeric="True"/>
                                        <DataGridTextColumn Header="Entries" Width="70" Binding="{Binding Entries, StringFormat=N0}" theme:TableAppearance.Numeric="True"/>
                                        <DataGridTextColumn Header="FASTA sp" Width="76" Binding="{Binding MarkedSp, StringFormat=N0}" theme:TableAppearance.Numeric="True"/>
                                        <DataGridTextColumn Header="FASTA tr" Width="76" Binding="{Binding MarkedTr, StringFormat=N0}" theme:TableAppearance.Numeric="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                </DockPanel>
                                <DockPanel Grid.Column="2">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Button x:Name="AddKeywordToScopeButton" DockPanel.Dock="Right" Content="Add to scope" Margin="8,0,0,0"
                                        Command="{x:Static local:SuperClusterPreviewWindow.AddTaskKeywordsToScope}" CommandTarget="{Binding ElementName=taskKeywordsGrid}"
                                        ToolTip="Adds the selected keywords as quoted scope phrases. Choose Update proposal to build their proposal."/>
                                <ComboBox x:Name="KeywordCategoryFilter" SelectedIndex="{Binding KeywordCategoryFilterIndex}" IsEnabled="{Binding CanEdit}"
                                          ToolTip="Choose all keyword categories or only Molecular function terms for this table.">
                                    <ComboBoxItem Content="All categories"/>
                                    <ComboBoxItem Content="Molecular function only"/>
                                </ComboBox>
                                </DockPanel>
                                <DataGrid x:Name="taskKeywordsGrid" ItemsSource="{Binding VisibleTaskKeywords}" IsReadOnly="True" AutoGenerateColumns="False"
                                          MinColumnWidth="48" SelectionMode="Extended" SelectionUnit="FullRow" MouseDoubleClick="TaskKeyword_DoubleClick"
                                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" MinHeight="76"
                                          ToolTip="UniProt keyword counts use distinct reviewed accessions and can overlap. Missing categories are shown as unavailable and can be filled by Fetch evidence.">
                                    <DataGrid.CommandBindings>
                                        <CommandBinding Command="{x:Static local:SuperClusterPreviewWindow.AddTaskKeywordsToScope}" CanExecute="AddScopeKeywords_CanExecute" Executed="AddScopeKeywords_Executed"/>
                                    </DataGrid.CommandBindings>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Keyword" Width="*" Binding="{Binding Keyword}"/>
                                        <DataGridTextColumn Header="Category" Width="146" Binding="{Binding CategoryDisplay}"/>
                                        <DataGridTextColumn Header="Reviewed accessions" Width="176" Binding="{Binding ReviewedProteins, StringFormat=N0}" theme:TableAppearance.Numeric="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                </DockPanel>
                            </Grid>
                            <TextBlock Text="{x:Static local:EvidenceTaskScopeInput.ScopeSuggestionExplanation}" Foreground="{DynamicResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,6" ToolTip="{x:Static local:EvidenceTaskScopeInput.ScopeSuggestionExplanation}"/>
                            <WrapPanel>
                                <TextBlock Text="{Binding TaskScope.ReviewedProteins, StringFormat='Reviewed accessions counted: {0:N0}'}" Margin="0,0,18,0"/>
                                <TextBlock Text="{Binding TaskScope.Release, StringFormat='UniProt release: {0}'}"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="{Binding TaskScope.TargetProteins, StringFormat='Targets counted: {0:N0}'}" Margin="0,0,18,0"/>
                                <TextBlock Text="{Binding TaskScope.IgnoredContaminants, StringFormat='Contaminants ignored: {0:N0}'}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding TaskScope.Note}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TaskScope.Note}" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Expander>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Update proposal" Click="UpdateProposal_Click" IsEnabled="{Binding CanUpdateProposal}"
                                ToolTip="Confirms your scope words and rebuilds the proposal from stored evidence. Your open document stays unchanged until Apply."/>
                        <TextBlock DockPanel.Dock="Left" Text="Scope" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding ScopeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Words to match in the evidence keywords and tissue fields. These are user choices, never a built-in family list."/>
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" Margin="0,8,0,0" ToolTip="{Binding Status}"/>
                    <TextBlock x:Name="TextBlockQueryCoverageRule" Text="{x:Static local:EvidenceProposalPresentation.QueryCoverageRule}"
                               Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="400" MinWidth="240"/><ColumnDefinition Width="10"/><ColumnDefinition MinWidth="280"/></Grid.ColumnDefinitions>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                      Focusable="True" ToolTip="Drag to resize the family and protein tables, or focus here and use the arrow keys."/>
                        <DockPanel>
                            <Button DockPanel.Dock="Top" Content="All proteins" Click="AllEvidenceProteins_Click" HorizontalAlignment="Left" Margin="0,0,0,6"
                                    ToolTip="Shows all proposal proteins on the right, keeping every reviewed tick and family name."/>
                        <DataGrid x:Name="familyGrid" ItemsSource="{Binding Evidence.Families}" SelectedItem="{Binding Evidence.SelectedFamily}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column"
                                  ToolTip="Tick families and edit their proposed names. Selecting a family shows its proteins on the right.">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Use" Width="60" MinWidth="60"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <CheckBox IsThreeState="True" IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center"
                                              ToolTip="Select or clear the eligible proteins in this family. Locked proteins stay unticked; a mixed tick means only some proteins are selected." ToolTipService.ShowOnDisabled="True"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Family name" Width="*" MinWidth="125" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="Proteins" Width="90" MinWidth="90" IsReadOnly="True" Binding="{Binding Proteins}"/>
                                <DataGridTextColumn Header="Reviewed" Width="100" MinWidth="100" IsReadOnly="True" Binding="{Binding ReviewedProteins}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                        <TabControl x:Name="evidenceTabs" Grid.Column="2">
                            <TabItem Header="Proteins">
                                <DockPanel DataContext="{Binding Evidence}">
                                    <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                             ToolTip="Filters the displayed proteins by identifier, description, reason or flags. It does not change your ticks."/>
                                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Button Content="Untick flagged" Click="UntickFlagged_Click" ToolTip="Clears selected proteins with a supplied evidence flag. All unflagged selections stay as they were."/>
                                        <Button Content="Tick selected" Click="EvidenceTickSelected_Click" ToolTip="Selects only the highlighted protein rows for their supplied proposed families."/>
                                        <Button Content="Untick selected" Click="EvidenceUntickSelected_Click" ToolTip="Clears only the highlighted protein rows. Their current document families stay unchanged until Apply."/>
                                    </WrapPanel>
                                    <DataGrid x:Name="evidenceGrid" ItemsSource="{Binding VisibleProteins}" AutoGenerateColumns="False" CanUserAddRows="False"
                                              CanUserDeleteRows="False" SelectionMode="Extended" ToolTip="Protein-level proposal with the supplied reason, tier and flags. Ticks and names remain review choices until Apply.">
                                        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Setter Property="FontStyle" Value="Italic"/>
                                                <Setter Property="ToolTip" Value="{Binding Flags}"/>
                                            </DataTrigger>
                                        </Style.Triggers></Style></DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Use" Width="60" MinWidth="60" IsReadOnly="True" CellTemplate="{StaticResource EvidenceTick}" ClipboardContentBinding="{Binding Identifier}"/>
                                            <DataGridTextColumn Header="Accession" Width="140" MinWidth="140" IsReadOnly="True" Binding="{Binding Accession}"/>
                                            <DataGridTextColumn Header="Tier" Width="140" MinWidth="140" IsReadOnly="True" Binding="{Binding Tier}"/>
                                            <DataGridTextColumn Header="Reason" Width="*" MinWidth="200" IsReadOnly="True" Binding="{Binding Reason}"/>
                                            <DataGridTextColumn Header="Flags" Width="180" MinWidth="180" IsReadOnly="True" Binding="{Binding Flags}"/>
                                            <DataGridTextColumn Header="Proposed family" Width="200" MinWidth="200" IsReadOnly="True" Binding="{Binding Family}"/>
                                            <DataGridTextColumn Header="Neighbour" Width="180" MinWidth="180" IsReadOnly="True" Binding="{Binding Neighbour}"/>
                                            <DataGridTextColumn Header="Domains" Width="180" MinWidth="180" IsReadOnly="True" Binding="{Binding Domains}"/>
                                            <DataGridTextColumn Header="Scope annotation" Width="160" MinWidth="160" IsReadOnly="True" Binding="{Binding HasScopeAnnotation}"/>
                                            <DataGridTextColumn Header="Description" Width="300" MinWidth="300" IsReadOnly="True" Binding="{Binding Description}"/>
                                            <DataGridTextColumn Header="Previous family" Width="145" MinWidth="145" IsReadOnly="True" Binding="{Binding PreviousFamilyId}"/>
                                            <DataGridTextColumn Header="Locus" Width="200" MinWidth="200" IsReadOnly="True" Binding="{Binding Identifier}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Panel links" Visibility="{Binding Evidence.HasPanelRules, Converter={StaticResource VisibleWhenTrue}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Use link choices" Click="UpdatePanelLinks_Click" IsEnabled="{Binding CanUpdatePanelLinks}"
                                                ToolTip="Store choices in the grouping recipe."/>
                                        <TextBlock Text="Confirm ambiguous links, then update the proposal." VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <DataGrid x:Name="panelLinksGrid" ItemsSource="{Binding Evidence.PanelLinks}" AutoGenerateColumns="False"
                                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Source family" Binding="{Binding SourceFamily}" IsReadOnly="True" Width="180"/>
                                            <DataGridTextColumn Header="Domain combination" Binding="{Binding Architecture}" IsReadOnly="True" Width="180"/>
                                            <DataGridTextColumn Header="Candidate keys" Binding="{Binding Candidates}" IsReadOnly="True" Width="180"/>
                                            <DataGridTextColumn Header="Reviewed accessions" Binding="{Binding SupportingAccessions}" IsReadOnly="True" Width="200"/>
                                            <DataGridTemplateColumn Header="User choice" Width="200">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="DisplayName"
                                                                  SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  ToolTip="Choose a family or leave outside."/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Note (optional)" Binding="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="240">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="{x:Type DataGridCell}">
                                                        <Setter Property="ToolTip" Value="Optional single-line note explaining this link choice, up to 512 characters."/>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Status" Binding="{Binding State}" IsReadOnly="True" Width="180"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Architecture"><local:ArchitectureReviewControl x:Name="architectureReview" DataContext="{Binding Evidence.SelectedArchitecture}"/></TabItem>
                            <TabItem Header="Left out">
                                <DataGrid x:Name="leftOutGrid" ItemsSource="{Binding Evidence.LeftOut}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          ToolTip="Proteins carrying a learned marker that were not assigned to its family, with the supplied reason. Check this list for potentially missed proteins.">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Marker family" Width="160" MinWidth="160" Binding="{Binding Family}"/>
                                        <DataGridTextColumn Header="Accession" Width="140" MinWidth="140" Binding="{Binding Accession}"/>
                                        <DataGridTextColumn Header="Reason" Width="*" MinWidth="220" Binding="{Binding Reason}"/>
                                        <DataGridTextColumn Header="Marker" Width="140" MinWidth="140" Binding="{Binding MarkerName}"/>
                                        <DataGridTextColumn Header="Marker accession" Width="150" MinWidth="150" Binding="{Binding MarkerAccession}"/>
                                        <DataGridTextColumn Header="Assigned instead" Width="160" MinWidth="160" Binding="{Binding AssignedFamily}"/>
                                        <DataGridTextColumn Header="Length" Width="90" MinWidth="90" Binding="{Binding Length}"/>
                                        <DataGridTextColumn Header="Reviewed" Width="110" MinWidth="110" Binding="{Binding Reviewed}"/>
                                        <DataGridTextColumn Header="Fragment" Width="110" MinWidth="110" Binding="{Binding Fragment}"/>
                                        <DataGridTextColumn Header="Description" Width="300" MinWidth="300" Binding="{Binding Description}"/>
                                        <DataGridTextColumn Header="Locus" Width="200" MinWidth="200" Binding="{Binding Identifier}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Unassigned">
                                <DataGrid x:Name="unassignedGrid" ItemsSource="{Binding Evidence.Unassigned}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          ToolTip="Proteins without a proposed family, with the supplied reasons and flags. Reviewing a row here never invents a family.">
                                    <DataGrid.Columns><DataGridTextColumn Header="Accession" Width="180" MinWidth="180" Binding="{Binding Accession}"/><DataGridTextColumn Header="Reason" Width="*" MinWidth="200" Binding="{Binding Reason}"/><DataGridTextColumn Header="Flags" Width="180" MinWidth="180" Binding="{Binding Flags}"/><DataGridTextColumn Header="Locus" Width="200" MinWidth="200" Binding="{Binding Identifier}"/></DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Markers">
                                <DataGrid ItemsSource="{Binding Evidence.Markers}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ToolTip="Marker domains supplied by the classifier, with carrier counts. The view does not learn or change marker rules.">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Accession" Width="110" MinWidth="110" Binding="{Binding Accession}"/>
                                        <DataGridTextColumn Header="Name" Width="*" MinWidth="180" Binding="{Binding Name}"/>
                                        <DataGridTextColumn Header="Family" Width="150" MinWidth="150" Binding="{Binding Family}"/>
                                        <DataGridTextColumn Header="Family carriers" Width="150" MinWidth="150" Binding="{Binding FamilyCarriers}"/>
                                        <DataGridTextColumn Header="All carriers" Width="130" MinWidth="130" Binding="{Binding AllCarriers}"/>
                                        <DataGridTextColumn Header="Labelled carriers" Width="165" MinWidth="165" Binding="{Binding LabelledCarriers}"/>
                                        <DataGridTextColumn Header="Vote fraction" Width="145" MinWidth="145" Binding="{Binding VoteFraction}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Motif counts">
                                <TextBox Text="{Binding MotifReport, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         ToolTip="Counts from the last checked motif, including each complete-protein denominator. Editing the pattern requires a new check before Apply."/>
                            </TabItem>
                        </TabControl>
                    </Grid>
                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Check motif" Click="Motif_Click" IsEnabled="{Binding CanCheckMotif}"
                                ToolTip="Counts your motif among complete proteins in the proposed families. Build a proposal and type a pattern first."/>
                        <TextBlock DockPanel.Dock="Left" Text="Motif" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding MotifPattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the motif pattern you want to check. Check it before Apply; the pattern is retained with the review selection."/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Help" Click="Help_Click" ToolTip="Explains scope, evidence tiers, flags, keyword matching, domains and the review choices. It does not change the open document."/>
            <Button x:Name="createButton" Content="Apply grouping" Style="{DynamicResource PrimaryButton}" IsEnabled="{Binding CanConfirm}" IsDefault="True" Click="Create_Click"
                    ToolTip="Applies the reviewed ticks and names. Select proteins and name each selected family and split before applying."/>
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" ToolTip="Closes the review and changes nothing in the open document. No undo step is added."/>
        </StackPanel>
    </Grid>
</Window>
