<UserControl x:Class="FamilyQuant.ArchitectureReviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <CheckBox Grid.ColumnSpan="3" Content="Split this family by domain combination" IsChecked="{Binding Split}" IsEnabled="{Binding CanSplit}"
                  Margin="0,0,0,8" ToolTip="Uses the groups supplied by the evidence analysis. Clearing it keeps one proposed family; no domain order is inferred."/>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
            <DataGrid x:Name="groupGrid" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column"
                      ToolTip="Select an architecture to see its members below. Split names are editable; memberships and inference flags come from the evidence analysis.">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Split name" Width="160" MinWidth="130" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Domain combination" Width="200" MinWidth="200" IsReadOnly="True" Binding="{Binding Domains}"/>
                    <DataGridTextColumn Header="Proteins" Width="90" MinWidth="90" IsReadOnly="True" Binding="{Binding Proteins}"/>
                    <DataGridTextColumn Header="Inferred" Width="95" MinWidth="95" IsReadOnly="True" Binding="{Binding InferredProteins}"/>
                    <DataGridTextColumn Header="Reviewed" Width="100" MinWidth="100" IsReadOnly="True" Binding="{Binding ReviewedProteins}"/>
                    <DataGridTextColumn Header="Dominant domain" Width="180" MinWidth="180" IsReadOnly="True" Binding="{Binding DominantDomain}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" Text="Selected group members" Style="{DynamicResource CaptionText}" Margin="0,8,0,4"/>
            <DataGrid x:Name="memberGrid" Grid.Row="2" ItemsSource="{Binding VisibleMembers}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" ToolTip="Members of the selected architecture, including proteins placed by length and cysteines without domain calls.">
                <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Placement}"/></Style></DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Accession" Width="110" MinWidth="110" Binding="{Binding Accession}"/>
                    <DataGridTextColumn Header="Placement" Width="*" MinWidth="200" Binding="{Binding Placement}"/>
                    <DataGridTextColumn Header="Description" Width="250" MinWidth="250" Binding="{Binding Description}"/>
                    <DataGridTextColumn Header="Reviewed" Width="100" MinWidth="100" Binding="{Binding Reviewed}"/>
                    <DataGridTextColumn Header="Length" Width="90" MinWidth="90" Binding="{Binding Length}"/>
                    <DataGridTextColumn Header="Cysteines" Width="110" MinWidth="110" Binding="{Binding Cysteines}"/>
                    <DataGridTextColumn Header="Calls" Width="150" MinWidth="150" Binding="{Binding DomainCalls}"/>
                    <DataGridTextColumn Header="Inferred" Width="95" MinWidth="95" Binding="{Binding Inferred}"/>
                    <DataGridTextColumn Header="Locus" Width="200" MinWidth="200" Binding="{Binding Identifier}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding UndeterminedLabel}" Style="{DynamicResource CaptionText}" Margin="0,0,0,4"/>
            <DataGrid x:Name="undeterminedGrid" Grid.Row="1" ItemsSource="{Binding Undetermined}" SelectedItem="{Binding SelectedUndetermined}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      ToolTip="Members no learned architecture range could place. The exact reason stays visible while you review the split.">
                <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Placement}"/></Style></DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Accession" Width="110" MinWidth="110" Binding="{Binding Accession}"/>
                    <DataGridTextColumn Header="Reason" Width="*" MinWidth="180" Binding="{Binding Placement}"/>
                    <DataGridTextColumn Header="Description" Width="240" MinWidth="240" Binding="{Binding Description}"/>
                    <DataGridTextColumn Header="Reviewed" Width="100" MinWidth="100" Binding="{Binding Reviewed}"/>
                    <DataGridTextColumn Header="Length" Width="90" MinWidth="90" Binding="{Binding Length}"/>
                    <DataGridTextColumn Header="Cysteines" Width="110" MinWidth="110" Binding="{Binding Cysteines}"/>
                    <DataGridTextColumn Header="Calls" Width="150" MinWidth="150" Binding="{Binding DomainCalls}"/>
                    <DataGridTextColumn Header="Locus" Width="200" MinWidth="200" Binding="{Binding Identifier}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="2" Text="{Binding SelectedUndetermined.Description}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       ToolTip="{Binding SelectedUndetermined.Description}" Margin="0,4,0,0"/>
        </Grid>
    </Grid>
</UserControl>
