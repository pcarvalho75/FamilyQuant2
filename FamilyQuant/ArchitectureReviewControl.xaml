<UserControl x:Class="FamilyQuant.ArchitectureReviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:theme="clr-namespace:FamilyQuant.Themes">
    <Grid>
        <TextBlock x:Name="architectureEmpty" Text="No domain groups to show for this selection." Foreground="{DynamicResource MutedBrush}"
                   ToolTip="Select a proposed family to review its domain groups. Panel-family proposals do not supply architecture groups.">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
        </TextBlock>
    <Grid x:Name="architectureContent">
        <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="3">
        <TextBlock x:Name="architectureLegend" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"
                   Text="Domain groups in this family; tick Split to give selected members their own family on Apply grouping."
                   TextTrimming="CharacterEllipsis"
                   ToolTip="Domain groups in this family; tick Split to give selected members their own family on Apply grouping. Unticked groups stay together in the proposed family; proteins unticked in the Proteins tab keep their current family."/>
        <CheckBox Content="Split all groups" IsChecked="{Binding SplitAll}" IsEnabled="{Binding CanSplit}"
                  Margin="0,0,0,8" ToolTip="Select or clear all supplied domain groups for separate families on Apply grouping; Undo then restores the previous grouping. Disabled when the proposal does not allow architecture splitting; review a splittable family to enable it."/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="2*" MinHeight="110"/><RowDefinition Height="8"/><RowDefinition Height="3*" MinHeight="138"/></Grid.RowDefinitions>
            <DataGrid x:Name="groupGrid" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" ToolTip="Select a supplied domain combination to inspect its members and edit its proposed output name. These are review choices until Apply grouping, after which Undo restores the previous grouping.">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Split" Width="62" MinWidth="62" IsReadOnly="True" ClipboardContentBinding="{Binding Split}" theme:TableAppearance.HeaderToolTip="Whether this domain group's selected proteins will form a separate family on Apply grouping. This is a review choice; Undo restores the preceding applied grouping."><DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <CheckBox IsChecked="{Binding Split, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSplit}" HorizontalAlignment="Center" ToolTip="Give this group's ticked proteins their own named family on Apply grouping; Undo then restores the previous grouping. Disabled when the proposal does not allow architecture splitting; review a splittable family to enable it."/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="New family name" Width="160" MinWidth="130" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" theme:TableAppearance.HeaderToolTip="Editable name for the separate family, initially suggested by the analysis; any nonblank name is accepted, with no numeric range. It takes effect on Apply grouping and can then be reverted with Undo."><DataGridTextColumn.EditingElementStyle><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="ToolTip" Value="Name for this split family, initially suggested by the analysis; enter any nonblank text, with no numeric range. Apply grouping commits the choice and Undo then restores the previous grouping."/></Style></DataGridTextColumn.EditingElementStyle></DataGridTextColumn>
                    <DataGridTextColumn Header="Domain combination" Width="200" MinWidth="200" IsReadOnly="True" Binding="{Binding Domains}" theme:TableAppearance.HeaderToolTip="Called domains supplied for this architecture group; their order is unknown. A missing call does not establish that a domain is absent."/>
                    <DataGridTextColumn Header="Proteins" Width="90" MinWidth="90" IsReadOnly="True" Binding="{Binding Proteins}" theme:TableAppearance.HeaderToolTip="Number of protein indices supplied for this architecture group, including members placed by size. This count is not recomputed from the current ticks."/>
                    <DataGridTextColumn Header="Placed by size" Width="115" MinWidth="115" IsReadOnly="True" Binding="{Binding InferredProteins}" theme:TableAppearance.HeaderToolTip="Count of members with no Pfam call placed in this domain group by sequence length and cysteine count. Placement is supplied by the evidence analysis."/>
                    <DataGridTextColumn Header="Reviewed" Width="100" MinWidth="100" IsReadOnly="True" Binding="{Binding ReviewedProteins}" theme:TableAppearance.HeaderToolTip="Count of reviewed proteins supplied for this domain group by the evidence analysis. Review status comes from the stored evidence."/>
                    <DataGridTextColumn Header="Most supported domain" Width="180" MinWidth="180" IsReadOnly="True" Binding="{Binding DominantDomain}" theme:TableAppearance.HeaderToolTip="Domain in this combination supported by the most reviewed proteins in the proposed family. Total protein support breaks ties."/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="{DynamicResource EdgeBrush}"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Focusable="True" ToolTip="Drag, or focus and use the arrow keys, to resize the domain groups and member lists. Only the view changes."/>
            <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="Selected group members" Style="{DynamicResource CaptionText}" Margin="0,4,0,4"/>
            <DataGrid x:Name="memberGrid" ItemsSource="{Binding VisibleMembers}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" ToolTip="Inspect members of the selected domain combination, including placements by length and cysteines without a Pfam call. Selection and sorting change only this view.">
                <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Placement}"/></Style></DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Accession" Width="110" MinWidth="110" Binding="{Binding Accession}" theme:TableAppearance.HeaderToolTip="UniProt accession parsed from the original identifier, or the identifier itself when no accession is found."/>
                    <DataGridTextColumn Header="Placement" Width="*" MinWidth="200" Binding="{Binding Placement}" theme:TableAppearance.HeaderToolTip="Supplied explanation of domain-combination membership or placement by length and cysteines. No new family assignment is made by this table."/>
                    <DataGridTextColumn Header="Description" Width="250" MinWidth="250" Binding="{Binding Description}" theme:TableAppearance.HeaderToolTip="Original description supplied for this protein. This table does not infer its family from its name."/>
                    <DataGridTextColumn Header="Reviewed" Width="100" MinWidth="100" Binding="{Binding Reviewed}" theme:TableAppearance.HeaderToolTip="Reviewed status supplied for the protein; an unavailable value means the fact was not supplied."/>
                    <DataGridTextColumn Header="Length" Width="90" MinWidth="90" Binding="{Binding Length}" theme:TableAppearance.HeaderToolTip="Supplied protein sequence length in amino-acid residues. This measurement is retained from the evidence analysis."/>
                    <DataGridTextColumn Header="Cysteines" Width="110" MinWidth="110" Binding="{Binding Cysteines}" theme:TableAppearance.HeaderToolTip="Supplied count of cysteine residues in the protein sequence, used alongside length for size-based placement."/>
                    <DataGridTextColumn Header="Domain evidence" Width="150" MinWidth="150" Binding="{Binding DomainCalls}" theme:TableAppearance.HeaderToolTip="Whether Pfam calls were supplied for this protein. No Pfam calls is a missing call, not proof that a domain is absent."/>
                    <DataGridTextColumn Header="Placed by size" Width="115" MinWidth="115" Binding="{Binding Inferred}" theme:TableAppearance.HeaderToolTip="Whether a member with no Pfam call was placed by length and cysteines rather than by a called domain combination."/>
                    <DataGridTextColumn Header="FASTA identifier" Width="200" MinWidth="200" Binding="{Binding Identifier}" theme:TableAppearance.HeaderToolTip="Full original FASTA identifier supplied for this protein, including its prefixes. No identifier is edited here."/>
                </DataGrid.Columns>
            </DataGrid>
            </DockPanel>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding UndeterminedLabel}" Style="{DynamicResource CaptionText}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"
                       ToolTip="These proteins still belong to the proposed family; no learned domain group could place them."/>
            <DataGrid x:Name="undeterminedGrid" Grid.Row="1" ItemsSource="{Binding Undetermined}" SelectedItem="{Binding SelectedUndetermined}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" ToolTip="Inspect members that no learned domain-group range placed and read their supplied reasons. Selection changes only this view; these proteins remain in the proposed family.">
                <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Placement}"/></Style></DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Accession" Width="110" MinWidth="110" Binding="{Binding Accession}" theme:TableAppearance.HeaderToolTip="UniProt accession parsed from the original identifier, or the identifier itself when no accession is found."/>
                    <DataGridTextColumn Header="Reason" Width="*" MinWidth="180" Binding="{Binding Placement}" theme:TableAppearance.HeaderToolTip="Exact supplied reason why no learned domain-group range placed this protein. It remains in the proposed family."/>
                    <DataGridTextColumn Header="Description" Width="240" MinWidth="240" Binding="{Binding Description}" theme:TableAppearance.HeaderToolTip="Original description supplied for this protein. This table does not infer its family from its name."/>
                    <DataGridTextColumn Header="Reviewed" Width="100" MinWidth="100" Binding="{Binding Reviewed}" theme:TableAppearance.HeaderToolTip="Reviewed status supplied for the protein; an unavailable value means the fact was not supplied."/>
                    <DataGridTextColumn Header="Length" Width="90" MinWidth="90" Binding="{Binding Length}" theme:TableAppearance.HeaderToolTip="Supplied protein sequence length in amino-acid residues. This measurement is retained from the evidence analysis."/>
                    <DataGridTextColumn Header="Cysteines" Width="110" MinWidth="110" Binding="{Binding Cysteines}" theme:TableAppearance.HeaderToolTip="Supplied count of cysteine residues in the protein sequence, used alongside length for size-based placement."/>
                    <DataGridTextColumn Header="Domain evidence" Width="150" MinWidth="150" Binding="{Binding DomainCalls}" theme:TableAppearance.HeaderToolTip="Whether Pfam calls were supplied for this protein. No Pfam calls is a missing call, not proof that a domain is absent."/>
                    <DataGridTextColumn Header="FASTA identifier" Width="200" MinWidth="200" Binding="{Binding Identifier}" theme:TableAppearance.HeaderToolTip="Full original FASTA identifier supplied for this protein, including its prefixes. No identifier is edited here."/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="2" Text="{Binding SelectedUndetermined.Description}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       ToolTip="{Binding SelectedUndetermined.Description}" Margin="0,4,0,0"/>
        </Grid>
    </Grid>
    </Grid>
</UserControl>
