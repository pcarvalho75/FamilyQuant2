<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>FamilyQuant2</AssemblyName>
    <RootNamespace>FamilyQuant</RootNamespace>
    <ApplicationIcon>Assets\Brand\FamilyQuant.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Title>FamilyQuant 2.1.20</Title>
    <Product>FamilyQuant2</Product>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- SeproPckg2.ResultPackage.Load deserialises .sepr2 with BinaryFormatter, which .NET
         disables by default; without this the de novo reconciliation cannot read the PSM list. -->
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <Version>2.1.20.0</Version>
    <AssemblyVersion>2.1.20.0</AssemblyVersion>
    <FileVersion>2.1.20.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FamilyQuant.Core\FamilyQuant.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Brand\FamilyQuant.ico" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="DLLs\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.4.0" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <!-- RawFileReader 5.0.0.38 pins a vulnerable OpenMcdf 2.2.1.3. The direct reference raises the
         resolved implementation to the current patched release; the real-RAW regression validates
         binary compatibility before this revision is accepted. -->
    <PackageReference Include="OpenMcdf" Version="3.2.0" />
    <PackageReference Include="System.Runtime.Serialization.Formatters" Version="10.0.3" />
    <!-- RAW reading for the de novo XIC extraction. The vendored PatternTools.dll references these
         four; without them the first RAW read throws FileNotFoundException. Same versions PL51 pins.
         The owner has confirmed these ship with the program (PLV already redistributes them). -->
    <PackageReference Include="ThermoFisher.CommonCore.BackgroundSubtraction" Version="5.0.0.38" />
    <PackageReference Include="ThermoFisher.CommonCore.Data" Version="5.0.0.38" />
    <PackageReference Include="ThermoFisher.CommonCore.MassPrecisionEstimator" Version="5.0.0.38" />
    <PackageReference Include="ThermoFisher.CommonCore.RawFileReader" Version="5.0.0.38" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MAligner">
      <HintPath>DLLs\MAligner.dll</HintPath>
    </Reference>
    <Reference Include="PatternTools">
      <HintPath>DLLs\PatternTools.dll</HintPath>
    </Reference>
    <Reference Include="SeproPckg2">
      <HintPath>DLLs\SeproPckg2.dll</HintPath>
    </Reference>
    <!-- XQuant2.dll was removed on 2026-08-16: the vendored copy was 19 months stale, still carried
         the ascending tie-break defect fixed in Aug/2026, and no line of this program used it. XIC
         extraction goes through PatternTools directly. -->
    <Reference Include="alglibnet2">
      <HintPath>DLLs\alglibnet2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="CSMSL">
      <HintPath>DLLs\CSMSL.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Help\ImportFamilyList\*.png" />
    <Resource Include="Assets\Brand\FamilyQuant.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <!-- AI Help reads the FamilyQuant source on GitHub with a read-only token built into the program. The token file
       stays outside the repository; the source generated under obj carries it XORed and Base64-encoded only so that
       secret scanners do not see its literal text, which is not protection. Without the file the build still
       succeeds and carries no token, and AI Help answers without reading the source. The task never logs the token. -->
  <PropertyGroup>
    <FamilyQuantHelpTokenFile Condition="'$(FamilyQuantHelpTokenFile)' == ''">$(LOCALAPPDATA)\FamilyQuant-build\github-help-token.txt</FamilyQuantHelpTokenFile>
  </PropertyGroup>

  <UsingTask TaskName="WriteHelpTokenSource" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <TokenFile ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        const string key = "FamilyQuant AI Help";
        string token = File.Exists(TokenFile) ? File.ReadAllText(TokenFile).Trim() : "";
        byte[] bytes = Encoding.UTF8.GetBytes(token);
        for (int i = 0; i < bytes.Length; i++) bytes[i] ^= (byte)key[i % key.Length];
        string source = "// Generated by GenerateHelpTokenSource in FamilyQuant.App.csproj; never commit or print it.\n"
            + "namespace FamilyQuant.Ai;\n\ninternal static partial class HelpGitHubToken\n{\n"
            + "    private const string Key = \"" + key + "\";\n"
            + "    private const string Scrambled = \"" + Convert.ToBase64String(bytes) + "\";\n}\n";
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != source)
        {
            Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
            File.WriteAllText(OutputFile, source);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateHelpTokenSource" BeforeTargets="CoreCompile">
    <WriteHelpTokenSource TokenFile="$(FamilyQuantHelpTokenFile)" OutputFile="$(IntermediateOutputPath)HelpGitHubToken.g.cs" />
    <ItemGroup>
      <Compile Remove="$(IntermediateOutputPath)HelpGitHubToken.g.cs" />
      <Compile Include="$(IntermediateOutputPath)HelpGitHubToken.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)HelpGitHubToken.g.cs" />
    </ItemGroup>
  </Target>

</Project>
