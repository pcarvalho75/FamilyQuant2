<Window x:Class="FamilyQuant.Setup.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FamilyQuant Setup" Width="680" Height="600" MinWidth="620" MinHeight="570"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="46" CornerRadius="10" GlassFrameThickness="0" ResizeBorderThickness="0"/></shell:WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="InstallerWindow.Resources.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Border x:Name="WindowSurface" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="82"/></Grid.RowDefinitions>
            <Grid Margin="20,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="TitleBrand" Width="22" Height="22" Source="pack://application:,,,/FamilyQuant2-Setup;component/Assets/Brand/FamilyQuant-setup-128.png"/>
                    <TextBlock Text="FamilyQuant" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Setup" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="ThemeButton" Content="Light" ToolTip="Switch colour theme" AutomationProperties.Name="Switch colour theme" Style="{StaticResource QuietButton}" Padding="10,3" MinHeight="30" Margin="0,6,8,6" Click="ThemeClick"/>
                    <Button Content="&#xE921;" FontFamily="Segoe Fluent Icons" ToolTip="Minimize" AutomationProperties.Name="Minimize" Style="{StaticResource QuietButton}" Width="36" Padding="0" Click="MinimizeClick"/>
                    <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" ToolTip="Close Setup" AutomationProperties.Name="Close Setup" Style="{StaticResource QuietButton}" Width="36" Padding="0" Click="CloseClick"/>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40,26,40,24" Focusable="False">
                <StackPanel>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StepLabel" Text="GET STARTED" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionLabel" Grid.Column="1" Style="{StaticResource Caption}"/>
                    </Grid>
                    <TextBlock x:Name="PageTitle" Text="Welcome to FamilyQuant" FontSize="28" FontWeight="SemiBold" LineHeight="35" Margin="0,0,0,12"/>
                    <TextBlock x:Name="PageDescription" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,26"/>
                    <StackPanel x:Name="WelcomePanel">
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image x:Name="WelcomeBrand" Width="52" Height="52" Source="pack://application:,,,/FamilyQuant2-Setup;component/Assets/Brand/FamilyQuant-setup-128.png" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="Your workspace, ready to go." FontWeight="SemiBold" FontSize="17"/>
                                    <TextBlock x:Name="WelcomeSummary" Text="Installs for your Windows account." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Button x:Name="ExistingActionButton" Content="_Repair" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                                Visibility="Collapsed" Margin="0,16,0,0" Click="ExistingActionClick"/>
                    </StackPanel>
                    <StackPanel x:Name="FolderPanel" Visibility="Collapsed">
                        <Label Content="_Install folder" Target="{Binding ElementName=FolderBox}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,9"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderBox" AutomationProperties.Name="Install folder"/>
                            <Button x:Name="ChangeFolderButton" Grid.Column="1" Content="_Change..." Margin="10,0,0,0" Click="ChangeFolderClick"/>
                        </Grid>
                        <TextBlock x:Name="FolderNote" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="OptionsPanel" Visibility="Collapsed">
                        <CheckBox x:Name="DesktopOption" Content="Create a _desktop shortcut"/>
                        <CheckBox x:Name="LaunchOption" Content="_Launch FamilyQuant when I finish" IsChecked="True"/>
                        <Border Background="{DynamicResource SurfaceBrush}" Padding="18" CornerRadius="8" Margin="0,4,0,0">
                            <StackPanel><TextBlock Text="INSTALL TO" Style="{StaticResource Caption}"/><TextBlock x:Name="OptionsFolder" FontSize="13" Margin="0,5,0,0"/></StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProgressStage" Text="Preparing" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="ProgressPercent" Grid.Column="1" Foreground="{DynamicResource MutedBrush}" Margin="16,0,0,0"/>
                        </Grid>
                        <ProgressBar x:Name="InstallProgress" Height="6" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource InputBrush}" BorderThickness="0" AutomationProperties.Name="Installation progress"/>
                        <TextBlock x:Name="ProgressDetail" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="22">
                            <StackPanel><TextBlock x:Name="DoneSummary" FontWeight="SemiBold" FontSize="17"/><TextBlock x:Name="DoneFolder" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="UninstallPanel" Visibility="Collapsed">
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="22">
                            <StackPanel>
                                <TextBlock Text="The app, its shortcuts and its installed-apps entry will be removed."/>
                                <TextBlock Text="Your projects, reports and settings stay." FontWeight="SemiBold" Margin="0,16,0,0"/>
                                <TextBlock x:Name="UninstallFolder" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                        <Border BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <TextBlock x:Name="ErrorMessage" AutomationProperties.LiveSetting="Assertive"/>
                        </Border>
                        <Expander x:Name="ErrorDetails" Header="Details" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBox x:Name="ErrorDetailsText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" FontSize="12"/>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,0" Padding="30,18">
                <Grid>
                    <Button x:Name="BackButton" Content="_Back" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="BackClick" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="_Cancel" Style="{StaticResource QuietButton}" Margin="0,0,10,0" Click="CancelClick"/>
                        <Button x:Name="PrimaryButton" Content="_Continue" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="PrimaryClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
