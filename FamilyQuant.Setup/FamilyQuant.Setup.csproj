<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>FamilyQuant.Setup.Program</StartupObject>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FamilyQuant2-Setup</AssemblyName>
    <RootNamespace>FamilyQuant.Setup</RootNamespace>
    <ApplicationIcon>../FamilyQuant/Assets/Brand/FamilyQuant-Setup.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../FamilyQuant/Deployment/UpdateCompletionMarker.cs" Link="UpdateCompletionMarker.cs" />
    <EmbeddedResource Include="$(SetupPayloadZip)" LogicalName="FamilyQuant.Setup.Payload.zip" Condition="'$(SetupPayloadZip)' != ''" />
    <EmbeddedResource Include="$(SetupPayloadManifest)" LogicalName="FamilyQuant.Setup.Payload.json" Condition="'$(SetupPayloadManifest)' != ''" />
    <Resource Include="../FamilyQuant/Assets/Brand/FamilyQuant-Setup.ico" Link="FamilyQuant-Setup.ico" />
    <Resource Include="../FamilyQuant/Assets/Brand/FamilyQuant-setup-128.png" Link="Assets/Brand/FamilyQuant-setup-128.png" />
  </ItemGroup>
</Project>
